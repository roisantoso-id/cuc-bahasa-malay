# docker compose 用的配置。复制成 .env(只放在服务器上,不要提交,也不要发到聊天里),chmod 600 .env

# 后台和小程序接口的域名(DNS 指向这台服务器)
DOMAIN=admin.bahasa.cn

# 数据库密码:用 openssl rand -hex 24 生成(只用字母数字,避免连接串出问题)
POSTGRES_PASSWORD=

# 小程序(微信公众平台 → 开发管理 → 开发设置):把 wx.login 的 code 换成 openid
# 不填就是演示模式:登录不校验,后台账号 admin / admin123,不能上线
APPID=
APPSECRET=

# 管理员账号;密码哈希在自己电脑上运行 node admin/scripts/hash-password.mjs 生成
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=

# 单词音频所在的 COS 目录(公有读),末尾带 /
AUDIO_BASE=https://jombelajar-audio-1314893093.cos.ap-guangzhou.myqcloud.com/vocab5000/%E9%A9%AC%E6%9D%A5%E8%AF%AD5000%E9%AB%98%E9%A2%91%E8%AF%8D_%E9%9F%B3%E9%A2%91/
