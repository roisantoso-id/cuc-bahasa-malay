# docker compose 用的配置。复制成 .env(只放在服务器上,不要提交,也不要发到聊天里),chmod 600 .env

# 后台和小程序接口的域名(DNS 指向这台服务器),多个用逗号隔开;小程序用 api,后台用 admin
DOMAIN=admin.bahasa.cn, api.bahasa.cn
# 官网域名(静态文件由 deploy/deploy-website.sh 上传到 /opt/jombelajar/website)
SITE_DOMAIN=www.bahasa.cn

# 腾讯云 MySQL(内网地址);密码只用字母数字,避免连接串出问题
DATABASE_URL=mysql://用户:密码@<MySQL内网地址>:3306/jombelajar

# 小程序(微信公众平台 → 开发管理 → 开发设置):把 wx.login 的 code 换成 openid
# 不填就是演示模式:登录不校验,后台账号 admin / admin123,不能上线
APPID=
APPSECRET=

# 管理员账号;密码哈希在自己电脑上运行 node admin/scripts/hash-password.mjs 生成
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=

# 单词音频所在的 COS 目录(新加坡桶,公有读,路径只用英文),末尾带 /
AUDIO_BASE=https://<存储桶>.cos.ap-singapore.myqcloud.com/vocab5000/audio/

# 后台「单词 → 发音 → AI 生成」用的 Azure 语音合成（马来西亚马来语 HD 声音）；不填这个功能会提示「还没配」，别的不受影响
AZURE_TTS_KEY=
AZURE_TTS_REGION=eastus
