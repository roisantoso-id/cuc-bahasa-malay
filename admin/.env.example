# 复制到服务器 /etc/jombelajar-admin.env,权限 600(chmod 600 /etc/jombelajar-admin.env)
# 这个文件只放在服务器上,不要提交到仓库,也不要发到聊天里

# 小程序(微信公众平台 → 开发管理 → 开发设置)
APPID=
APPSECRET=
# 云开发环境 ID(开发者工具 → 云开发 → 设置)
CLOUD_ENV=

# 管理员账号;密码哈希用 node admin/scripts/hash-password.mjs 生成
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=

# 单词发音(Azure 语音服务,可不填;不填就不能在后台生成发音)
AZURE_TTS_KEY=
AZURE_TTS_REGION=eastus

# 监听地址(nginx 反代到这里)
ADMIN_HOST=127.0.0.1
ADMIN_PORT=4200
