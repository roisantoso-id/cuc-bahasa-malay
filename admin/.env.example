# 复制到服务器 /etc/jombelajar-admin.env,权限 600(chmod 600 /etc/jombelajar-admin.env)
# 这个文件只放在服务器上,不要提交到仓库,也不要发到聊天里

# 小程序(微信公众平台 → 开发管理 → 开发设置):用来把 wx.login 的 code 换成 openid
APPID=
APPSECRET=

# 管理员账号;密码哈希用 node admin/scripts/hash-password.mjs 生成
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=

# 单词音频所在的 COS 目录(公有读),末尾带 /
AUDIO_BASE=https://<桶名>.cos.<地域>.myqcloud.com/vocab5000/

# 数据库和老师照片放这里(不要放在代码目录里,部署时 rsync 会覆盖代码目录)
DATA_DIR=/var/lib/jombelajar

# 监听地址(nginx 反代到这里)
ADMIN_HOST=127.0.0.1
ADMIN_PORT=4200
