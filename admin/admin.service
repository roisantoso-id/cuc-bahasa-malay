# systemd 服务:/etc/systemd/system/jombelajar-admin.service
[Unit]
Description=JomBelajar 背单词服务(小程序接口 + 后台)
After=network.target

[Service]
ExecStart=/usr/bin/env node /opt/jombelajar-admin/admin/server.mjs
WorkingDirectory=/opt/jombelajar-admin
Environment=ADMIN_ENV=/etc/jombelajar-admin.env
Environment=NODE_NO_WARNINGS=1
Restart=on-failure
User=root
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
