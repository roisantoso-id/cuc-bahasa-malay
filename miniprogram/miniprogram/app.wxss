/* 小程序设计系统 · 词光夜航（深色、安静、每屏只做一件事）。
   夜 #0a1f22 页面底；面板 #14353a；象牙 #f3ead6（词卡、主按钮）；星光 #e9b961（强调、进度）；对 #8fc0a0；错 #e8836a。
   扁平面 + 细线边框，不用重阴影、毛玻璃、发光。类名沿用旧版，页面不用改结构就能换皮。 */
page {
  --night: #0a1f22;
  --panel: #14353a;
  --panel2: #0f2a2e;
  --ivory: #f3ead6;
  --star: #e9b961;
  --ok: #8fc0a0;
  --bad: #e8836a;
  --hair: rgba(243,234,214,.12);
  --hair2: rgba(243,234,214,.22);
  --ink: #f3ead6;
  --ink2: rgba(243,234,214,.62);
  --dark-ink: #0a1f22;
  /* 兼容旧类名用到的变量 */
  --paper: var(--night); --paper2: var(--panel2); --card: var(--panel); --card2: var(--panel);
  --edge: var(--hair); --line: var(--hair);
  --green: var(--ok); --green-hi: var(--ok); --green-d: var(--ok); --green-l: rgba(143,192,160,.16);
  --teal: var(--panel); --teal-hi: var(--panel); --teal-d: var(--panel2);
  --amber: var(--star); --amber-hi: var(--star); --amber-d: var(--star); --amber-l: rgba(233,185,97,.16);
  --coral: var(--bad); --coral-d: var(--bad); --coral-l: rgba(232,131,106,.16);
  --blue: #8db8c4; --blue-d: #8db8c4; --blue-l: rgba(141,184,196,.16);
  --yellow: var(--star);
  --bg: var(--night);
  background: var(--night);
  color: var(--ink);
  font-size: 30rpx;
  line-height: 1.55;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
}

.wrap { padding: 24rpx 32rpx 80rpx; }
/* 自定义底栏盖在页面上，tab 页底部留出它的高度 */
.tab-pad { height: calc(150rpx + env(safe-area-inset-bottom)); }
.muted { color: var(--ink2); }
.small { font-size: 26rpx; }
.h1 { font-size: 46rpx; font-weight: 800; line-height: 1.3; font-family: "Songti SC", "STSong", -apple-system, "PingFang SC", serif; }
.h2 { font-size: 32rpx; font-weight: 800; margin: 44rpx 0 20rpx; font-family: "Songti SC", "STSong", -apple-system, "PingFang SC", serif; }
.ms { font-weight: 700; font-family: Georgia, "Times New Roman", serif; }
.serif { font-family: Georgia, "Times New Roman", serif; }
.row { display: flex; align-items: center; gap: 16rpx; }
.between { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.center { text-align: center; }
.c-green { color: var(--ok); } .c-blue { color: var(--blue); } .c-coral { color: var(--bad); } .c-yellow, .c-amber { color: var(--star); }

/* ---------- 按钮：全圆角，扁平 ---------- */
.btn { position: relative; display: flex; align-items: center; justify-content: center; height: 100rpx; border-radius: 999rpx; font-size: 32rpx; font-weight: 800; margin: 0; padding: 0 36rpx; line-height: 100rpx; box-sizing: border-box; transition: opacity .1s, transform .1s; }
.btn::after { border: 0; }
.btn-main { color: var(--dark-ink); background: var(--ivory); }
.btn-amber { color: var(--dark-ink); background: var(--star); }
.btn-teal { color: var(--ivory); background: var(--panel); border: 2rpx solid var(--hair2); }
.btn-ghost { color: var(--ivory); background: transparent; border: 2rpx solid var(--hair2); }
.btn-blue { color: var(--dark-ink); background: var(--blue); }
.btn-danger { color: var(--bad); background: transparent; border: 2rpx solid var(--bad); }
.btn.hover { opacity: .7; transform: scale(.985); }
.btn[disabled] { opacity: .45; }
.btn-sm { height: 72rpx; line-height: 72rpx; font-size: 26rpx; padding: 0 28rpx; }
.btns { display: flex; flex-direction: column; gap: 24rpx; margin-top: 36rpx; }
.link { color: var(--star); font-weight: 700; }

/* ---------- 卡片：面板 + 细线 ---------- */
.card { position: relative; background: var(--panel); border: 2rpx solid var(--hair); border-radius: 28rpx; padding: 30rpx; }
.card + .card { margin-top: 28rpx; }
.card-tap.hover { opacity: .7; }
.card-dark { background: var(--panel2); }
.card-dark .muted { color: var(--ink2); }

.list .item { display: flex; align-items: center; gap: 20rpx; padding: 28rpx 0; border-bottom: 2rpx solid var(--hair); min-height: 88rpx; box-sizing: border-box; }
.list .item:last-child { border-bottom: 0; }
.item-main { flex: 1; min-width: 0; }
.arrow { color: var(--ink2); }

/* 标签、胶囊 */
.tag { display: inline-block; font-size: 24rpx; font-weight: 700; padding: 4rpx 16rpx; border-radius: 999rpx; background: var(--green-l); color: var(--ok); }
.tag.blue { background: var(--blue-l); color: var(--blue); }
.tag.coral { background: var(--coral-l); color: var(--bad); }
.tag.amber { background: var(--amber-l); color: var(--star); }
.tag.gray { background: rgba(243,234,214,.08); color: var(--ink2); }
.chips { display: flex; flex-wrap: wrap; gap: 16rpx; }
.chip { display: inline-block; padding: 12rpx 28rpx; border-radius: 999rpx; background: transparent; font-size: 26rpx; font-weight: 700; color: var(--ink2); border: 2rpx solid var(--hair2); }
.chip.on { background: var(--ivory); color: var(--dark-ink); border-color: var(--ivory); }

/* 进度条：细、星光色 */
.bar { height: 12rpx; border-radius: 999rpx; background: rgba(243,234,214,.12); overflow: hidden; }
.bar-in { height: 100%; border-radius: 999rpx; background: var(--star); transition: width .4s; }

/* 选项（答题）：深色整行，对 = 绿线，错 = 橙线 */
.opt { position: relative; display: flex; align-items: center; justify-content: space-between; gap: 16rpx; background: var(--panel); border: 2rpx solid var(--hair); border-radius: 24rpx; padding: 28rpx 30rpx; min-height: 100rpx; box-sizing: border-box; font-weight: 600; margin-bottom: 20rpx; color: var(--ivory); }
.opt.hover { opacity: .7; }
.opt.on { border-color: var(--star); color: var(--star); }
.opt.right { color: var(--ok); border-color: var(--ok); background: rgba(143,192,160,.12); }
.opt.right::after { content: ''; flex: none; width: 24rpx; height: 12rpx; border-left: 4rpx solid var(--ok); border-bottom: 4rpx solid var(--ok); transform: rotate(-45deg) translateY(-4rpx); }
.opt.wrong { color: var(--bad); border-color: var(--bad); background: rgba(232,131,106,.1); }
.opt.wrong::after { content: '你选的'; flex: none; font-size: 24rpx; color: var(--bad); }

.input { background: var(--panel2); color: var(--ivory); border: 2rpx solid var(--hair2); border-radius: 24rpx; padding: 0 26rpx; height: 96rpx; font-size: 32rpx; }
.input-focus { border-color: var(--star); }
.field { margin-bottom: 30rpx; }
.label { font-size: 28rpx; font-weight: 700; margin-bottom: 12rpx; }
.err { color: var(--bad); font-size: 26rpx; margin-top: 8rpx; }
.ph { color: rgba(243,234,214,.4); }

.sense { padding: 20rpx 0; border-top: 2rpx solid var(--hair); }
.sense:first-child { border-top: 0; }
.example { margin-top: 12rpx; padding-left: 20rpx; border-left: 4rpx solid var(--star); }

/* ---------- 旧版旅程类名：保留，换成扁平深色 ---------- */
.songket { height: 4rpx; background: var(--star); opacity: .6; }
.ticket { position: relative; background: var(--panel); border: 2rpx solid var(--hair); border-radius: 28rpx; overflow: hidden; }
.ticket-cut { position: relative; border-top: 2rpx dashed var(--hair2); margin: 0 28rpx; }
.stamp { width: 132rpx; height: 132rpx; border-radius: 50%; border: 4rpx solid var(--star); color: var(--star); display: flex; flex-direction: column; align-items: center; justify-content: center; position: relative; box-sizing: border-box; text-align: center; line-height: 1.15; }
.stamp .s1 { font-size: 26rpx; font-weight: 800; }
.stamp .s2 { font-size: 20rpx; font-weight: 700; }
.stamp.off { border-color: var(--hair2); color: var(--ink2); border-style: dashed; }
.no { font-family: Georgia, "Times New Roman", serif; letter-spacing: 1rpx; }

.tile { background: var(--panel); border: 2rpx solid var(--hair); border-radius: 24rpx; padding: 20rpx 8rpx; text-align: center; }
.tile .n { font-size: 44rpx; font-weight: 700; line-height: 1.2; font-family: Georgia, "Times New Roman", serif; }
.tile.hover { opacity: .7; }
.medal { width: 60rpx; height: 60rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 28rpx; color: var(--dark-ink); flex-shrink: 0; font-family: Georgia, serif; }
.medal.m1 { background: var(--star); } .medal.m2 { background: var(--ivory); } .medal.m3 { background: var(--ok); }
.medal.mn { background: transparent; color: var(--ink2); }
