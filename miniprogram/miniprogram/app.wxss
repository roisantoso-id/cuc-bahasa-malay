/* 学术出版物风格:深蓝 + 米白 + 金色,细线分隔,无投影。规范见 docs/品牌规范.md */
page {
  --green: #14213d;
  --green-d: #0d1730;
  --green-l: #eceff5;
  --yellow: #a8823a;
  --blue: #3c5a8a;
  --coral: #a23b2a;
  --bg: #f6f4ef;
  --card: #ffffff;
  --ink: #1b1c1e;
  --ink2: #8b8e93;
  --line: #d9d4c8;
  --ok: #2e6b4a;
  background: var(--bg);
  color: var(--ink);
  font-size: 30rpx;
  line-height: 1.55;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
}

.wrap { padding: 24rpx 32rpx 64rpx; }
.muted { color: var(--ink2); }
.small { font-size: 24rpx; }
.h1 { font-size: 44rpx; font-weight: 700; font-family: "Songti SC", "STSong", serif; line-height: 1.3; }
.h2 { font-size: 34rpx; font-weight: 700; font-family: "Songti SC", "STSong", serif; margin: 40rpx 0 18rpx; }
.ms { font-weight: 800; }
.row { display: flex; align-items: center; gap: 16rpx; }
.between { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.center { text-align: center; }

/* 按钮:底部投影,按下下沉 */
.btn { display: flex; align-items: center; justify-content: center; height: 96rpx; border-radius: 8rpx; font-size: 32rpx; font-weight: 700; margin: 0; padding: 0 32rpx; line-height: 96rpx; }
.btn::after { border: 0; }
.btn-main { background: var(--green); color: #fff; }
.btn-main.hover { opacity: .85; }
.btn-ghost { background: #fff; color: var(--ink); border: 2rpx solid var(--line); }
.btn-ghost.hover { opacity: .85; }
.btn-blue { background: var(--blue); color: #fff; }
.btn-danger { background: var(--coral); color: #fff; }
.btn[disabled] { opacity: .5; }
.btn-sm { height: 68rpx; line-height: 68rpx; font-size: 26rpx; border-radius: 8rpx; padding: 0 24rpx; }
.btns { display: flex; flex-direction: column; gap: 24rpx; margin-top: 32rpx; }
.link { color: var(--green-d); font-weight: 700; }

/* 卡片:边框 + 底部投影,不用阴影 */
.card { background: var(--card); border: 2rpx solid var(--line); border-radius: 8rpx; padding: 28rpx; }
.card + .card { margin-top: 24rpx; }
.card-tap.hover { opacity: .85; }

/* 列表行 */
.list .item { display: flex; align-items: center; gap: 20rpx; padding: 28rpx 0; border-bottom: 2rpx solid var(--line); }
.list .item:last-child { border-bottom: 0; }
.item-main { flex: 1; min-width: 0; }
.arrow { color: var(--ink2); }

/* 标签、胶囊 */
.tag { display: inline-block; font-size: 22rpx; font-weight: 800; padding: 4rpx 14rpx; border-radius: 8rpx; background: var(--green-l); color: var(--green-d); }
.tag.blue { background: #eceff5; color: #2c4670; }
.tag.coral { background: #f6e9e6; color: #8a2f21; }
.tag.gray { background: #ece8df; color: var(--ink2); }
.chips { display: flex; gap: 16rpx; white-space: nowrap; }
.chip { display: inline-block; padding: 12rpx 28rpx; border-radius: 6rpx; background: #fff; border: 2rpx solid var(--line); font-size: 26rpx; font-weight: 800; }
.chip.on { background: var(--green); border-color: var(--green); color: #fff; }

/* 进度条 */
.bar { height: 28rpx; border-radius: 6rpx; background: var(--line); overflow: hidden; }
.bar-in { height: 100%; background: var(--green); border-radius: 6rpx; transition: width .3s; }

/* 选项(答题、打分) */
.opt { background: #fff; border: 2rpx solid var(--line); border-radius: 8rpx; padding: 24rpx 28rpx; font-weight: 800; margin-bottom: 20rpx; }
.opt.on { border-color: var(--blue); background: #eceff5; }
.opt.right { border-color: var(--ok); background: #eaf2ec; color: var(--ok); }
.opt.wrong { border-color: var(--coral); background: #f6e9e6; color: #8a2f21; }

.input { background: #fff; border: 2rpx solid var(--line); border-radius: 8rpx; padding: 0 24rpx; height: 92rpx; font-size: 32rpx; }
.input-focus { border-color: var(--green); }
.field { margin-bottom: 28rpx; }
.label { font-size: 26rpx; font-weight: 800; margin-bottom: 12rpx; }
.err { color: var(--coral); font-size: 24rpx; margin-top: 8rpx; }

/* 释义块 */
.sense { padding: 20rpx 0; border-top: 2rpx solid var(--line); }
.sense:first-child { border-top: 0; }
.example { margin-top: 12rpx; padding-left: 20rpx; border-left: 6rpx solid var(--yellow); }
