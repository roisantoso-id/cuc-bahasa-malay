/* ==========================================================================
   词光夜航 · 小程序设计系统（v3，2026-11-18）
   深色、安静、每屏只做一件事。全站只有这一套尺寸，页面里不再写零散的颜色和数字。

   一、颜色（角色，不是装饰）
     --night  #0a1f22  页面底
     --panel  #14353a  面板。只在「真的要把几样东西圈成一组」时用（词云、底部反馈条），不做卡片墙
     --ivory  #f3ead6  正文字、词卡、主按钮
     --star   #e9b961  星光。每屏只给一处：这一屏最想让人看到的那个数 / 那一行
     --ok     #8fc0a0  对 / 认识        --bad  #e8836a  错 / 不认识
     --ink2   象牙 64%  次要文字       --ink3  象牙 40%  占位、禁用（不放正文）
     --hair   象牙 12%  细线           --hair2 象牙 24%  描边按钮、输入框
     象牙底上的字：--dark-ink 正文、--dark-ink2 次要、--leaf 马来语词 / 对、--star-d 强调、--bad-d 错

   二、字号（5 级 + 首页圆环 1 个特例）
     --t-display 88rpx  大数字、词卡上的词（Georgia）
     --t-title   44rpx  页面标题、姓名（宋体）；中号数字也用这一级（Georgia）
     --t-section 32rpx  小节标题（宋体）、按钮字
     --t-body    30rpx  正文、列表主行
     --t-caption 24rpx  说明、单位、标签
     字体：马来语词 .ms = Georgia 斜体；例句 .serif = Georgia 正体；中文标题宋体（没有就退回系统字）；正文苹方

   三、间距：8 / 16 / 24 / 32 / 48 rpx（--s1 … --s5）。页面左右留 32；小节之间 48；行内 16 或 24
   四、圆角：--r-sm 16rpx（选项、输入、小块）、--r-lg 32rpx（词卡、面板、弹层）、--r-pill（按钮、标签）
   五、线：一律 2rpx（= 1 物理像素）象牙 12%。分组靠线和留白，不靠盒子

   六、按钮（都是胶囊；默认宽度跟着字走，绝不自己撑满）
     .btn.btn-main   主按钮：象牙底深色字，96rpx 高。每屏只有一个
     .btn.btn-ghost  次按钮：描边
     .btn.btn-sm     小按钮：72rpx 高（点击区上下各多 8rpx，够 88）
     .btn-block      撑满一行。只给这一屏唯一的主操作用
     .btn-text       文字按钮：放在主按钮下面当「另一个选择」
     .btn-amber / .btn-teal / .btn-blue 是旧名字，样子分别等于主 / 次 / 次

   七、标准件
     .sec + .sec-t + .sec-x      小节标题行（左标题，右说明）；.h2 是只有标题的写法
     .list > .item               列表行：最矮 104rpx，下边一条细线；.item-main 是中间那块
     .rk（.rk-p .rk-av .rk-main .rk-n .rk-sub .rk-s .rk-x）  排行行：名次 + 头像 + 名字 + 分数；.rk.me 是星光色整行
     .stats > .stat（.stat-n .stat-l）   一排 2–4 个数，上下各一条线
     .tabs > .tab                文字切换（下划线），等分，一行放得下，不换行
     .res（.res-bird .res-n .res-u）   成绩头：犀鸟 + 大数字
     .opt                        答题选项
     .sheet                      象牙色弹层
     <hb-empty>                  空 / 加载 / 出错

   八、规矩
     页面自己的类名一律带前缀（hm- at- bt- me- rg- ln- st- bk- sr- wd- ar- pk- pl- rp- ab- pv-），不和这里的名字撞
     能点的东西最矮 88rpx；不出现横向滚动条；不用阴影堆、毛玻璃、发光、渐变底
   ========================================================================== */
page {
  --night: #0a1f22;
  --panel: #14353a;
  --panel2: #0f2a2e;
  --ivory: #f3ead6;
  --star: #e9b961;
  --ok: #8fc0a0;
  --bad: #e8836a;
  --ink: #f3ead6;
  --ink2: rgba(243,234,214,.64);
  --ink3: rgba(243,234,214,.4);
  --hair: rgba(243,234,214,.12);
  --hair2: rgba(243,234,214,.24);
  --dark-ink: #0a1f22;
  --dark-ink2: rgba(10,31,34,.62);
  --dark-hair: rgba(10,31,34,.14);
  --leaf: #1f6b4e;
  --star-d: #8a5c0c;
  --bad-d: #b84a33;
  --star-l: rgba(233,185,97,.14);
  --ok-l: rgba(143,192,160,.14);
  --bad-l: rgba(232,131,106,.12);
  /* 两套主题共用的角色（白天的值在 utils/theme.js） */
  --strong: #f3ead6;      /* 强调的字和描边 */
  --raise: #f3ead6;       /* 浮起来的面：词卡、弹层、头像底 */
  --raise-sh: none;       /* 白天：墨线框 + 纸影 */
  --btn: #f3ead6;  --on-btn: #0a1f22;  --on-star: #0a1f22;
  --sheet: #10292d;  --scrim: rgba(5,16,18,.72);
  --wash: rgba(243,234,214,.08);  --inset: rgba(10,31,34,.55);  --glow: rgba(233,185,97,.35);
  --star-line: rgba(233,185,97,.35);  --heat1: rgba(143,192,160,.3);  --heat2: rgba(143,192,160,.62);
  --fb-ok: #1d3d37;  --fb-bad: #3a2a27;  --tag-blue: #9cc9e6;  --tag-blue-l: rgba(156,201,230,.14);
  --bar: #0a1f22;
  --photo: #f8f1e9;       /* 犀鸟图片的底（两套一样） */

  --t-display: 88rpx;
  --t-title: 44rpx;
  --t-section: 32rpx;
  --t-body: 30rpx;
  --t-caption: 24rpx;
  --f-ms: Georgia, "Times New Roman", serif;
  --ms-style: italic;   /* 马来语单词：夜晚斜体，白天正体（theme.js 覆盖） */
  --ms-bold: 700;       /* 大号单词（词卡、详情、弹窗）的字重：夜晚粗，白天常规 */
  --f-zh: "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC", serif;
  --f-body: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;

  --s1: 8rpx; --s2: 16rpx; --s3: 24rpx; --s4: 32rpx; --s5: 48rpx;
  --r-sm: 16rpx; --r-lg: 32rpx; --r-pill: 999rpx;

  /* 旧变量名：还有老页面在用，全部指到上面的角色上 */
  --paper: var(--night); --paper2: var(--panel2); --card: var(--panel); --card2: var(--panel);
  --edge: var(--hair); --line: var(--hair); --bg: var(--night);
  --green: var(--ok); --green-hi: var(--ok); --green-d: var(--ok); --green-l: var(--ok-l);
  --teal: var(--panel); --teal-hi: var(--panel); --teal-d: var(--panel2);
  --amber: var(--star); --amber-hi: var(--star); --amber-d: var(--star); --amber-l: var(--star-l);
  --coral: var(--bad); --coral-d: var(--bad); --coral-l: var(--bad-l);
  --blue: var(--ink2); --blue-d: var(--ink2); --blue-l: var(--hair);
  --yellow: var(--star);

  background: var(--night);
  color: var(--ink);
  font-size: var(--t-body);
  line-height: 1.5;
  font-family: var(--f-body);
}

/* ---------- 版面 ---------- */
.wrap { padding: var(--s3) var(--s4) 96rpx; }
/* 自定义底栏盖在页面上，tab 页底部留出它的高度 */
.tab-pad { height: calc(140rpx + env(safe-area-inset-bottom)); }
.row { display: flex; align-items: center; gap: var(--s2); }
.between { display: flex; align-items: center; justify-content: space-between; gap: var(--s2); }
.center { text-align: center; }
.one { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* ---------- 文字 ---------- */
.h1 { font-size: var(--t-title); font-weight: 700; line-height: 1.3; font-family: var(--f-zh); }
.h2 { font-size: var(--t-section); font-weight: 700; line-height: 1.4; margin: var(--s5) 0 var(--s2); font-family: var(--f-zh); }
.muted { color: var(--ink2); }
.small { font-size: var(--t-caption); }
.ms { font-family: var(--f-ms); font-style: var(--ms-style); font-weight: 400; }
.serif, .no, .num { font-family: var(--f-ms); }
.num { font-size: var(--t-title); line-height: 1.15; }
.num-xl { font-family: var(--f-ms); font-size: var(--t-display); line-height: 1.1; }
.link { color: var(--strong); text-decoration: underline; }
.c-green { color: var(--ok); } .c-coral { color: var(--bad); } .c-yellow, .c-amber { color: var(--star); } .c-blue { color: var(--ink2); }

/* 小节标题行 */
.sec { display: flex; align-items: baseline; justify-content: space-between; gap: var(--s2); margin: var(--s5) 0 var(--s2); }
.sec-t { font-size: var(--t-section); font-weight: 700; line-height: 1.4; font-family: var(--f-zh); }
.sec-x { font-size: var(--t-caption); color: var(--ink2); flex: none; }

/* ---------- 按钮 ---------- */
.btn, button.btn { position: relative; display: inline-flex; align-items: center; justify-content: center; gap: var(--s1); vertical-align: top; width: auto; min-width: 280rpx; height: 96rpx; min-height: 0; margin: 0; padding: 0 var(--s5); border-radius: var(--r-pill); font-size: var(--t-section); font-weight: 600; line-height: 1; letter-spacing: 1rpx; box-sizing: border-box; background: transparent; color: var(--strong); transition: opacity .12s; }
.btn::after { border: 0; }
/* 写成 button.xxx 是为了压住基础库给 button 的默认样式（它的优先级比单个类名高） */
.btn-main, .btn-amber, button.btn-main, button.btn-amber { color: var(--on-btn); background: var(--btn); }
.btn-ghost, .btn-teal, .btn-blue, button.btn-ghost, button.btn-teal, button.btn-blue { color: var(--strong); border: 2rpx solid var(--hair2); }
.btn-danger, button.btn-danger { color: var(--bad); border: 2rpx solid var(--bad); }
.btn.hover { opacity: .72; }
.btn[disabled], button.btn[disabled] { opacity: .4; color: var(--strong); background: transparent; }
button.btn-main[disabled], button.btn-amber[disabled] { color: var(--on-btn); background: var(--btn); }
button.btn-danger[disabled] { color: var(--bad); }
.btn-sm, button.btn-sm { height: 72rpx; min-width: 0; padding: 0 var(--s4); font-size: 26rpx; }
.btn-sm::before { content: ''; position: absolute; left: 0; right: 0; top: -8rpx; bottom: -8rpx; }
.btn-block, button.btn-block { display: flex; width: 100%; }
.btn-arr { font-family: var(--f-ms); font-weight: 400; }
.btn-text { display: flex; align-items: center; justify-content: center; min-height: 88rpx; padding: 0 var(--s4); font-size: 28rpx; color: var(--ink2); }
.btn-text.hover { opacity: .6; }
.btns { display: flex; flex-direction: column; align-items: center; gap: var(--s1); margin-top: var(--s4); }

/* ---------- 面板（少用）---------- */
.card { position: relative; background: var(--panel); border-radius: var(--r-lg); padding: var(--s4); }
.card + .card { margin-top: var(--s3); }
.card-tap.hover { opacity: .72; }
.card-dark { background: var(--panel2); }

/* ---------- 列表行 ---------- */
.list { border-top: 2rpx solid var(--hair); }
.list .item { display: flex; align-items: center; gap: var(--s3); min-height: 104rpx; padding: var(--s2) 0; border-bottom: 2rpx solid var(--hair); box-sizing: border-box; }
.item-main { flex: 1; min-width: 0; }
.item-x { flex: none; font-size: 26rpx; color: var(--ink2); }
.arrow { flex: none; color: var(--ink3); font-size: 32rpx; line-height: 1; }
.hover-row { opacity: .6; }
.card.list { background: transparent; padding: 0; border-radius: 0; }

/* ---------- 排行行 ---------- */
.rk { display: flex; align-items: center; gap: var(--s2); min-height: 104rpx; padding: var(--s2) 0; border-bottom: 2rpx solid var(--hair); box-sizing: border-box; }
.rk-p { flex: none; width: 48rpx; text-align: center; font-family: var(--f-ms); font-size: 28rpx; color: var(--ink2); }
.rk-p.top { color: var(--strong); font-size: var(--t-section); }
.rk-av { flex: none; width: 72rpx; height: 72rpx; border-radius: 50%; background: var(--photo); }
.rk-main { flex: 1; min-width: 0; }
.rk-n { font-size: var(--t-body); font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.rk-sub { font-size: var(--t-caption); color: var(--ink2); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.rk-r { flex: none; text-align: right; }
.rk-s { font-family: var(--f-ms); font-size: 36rpx; line-height: 1.2; }
.rk-x { font-size: var(--t-caption); color: var(--ink2); }
.rk.me { margin: 0 calc(0rpx - var(--s4)); padding-left: var(--s4); padding-right: var(--s4); background: var(--star); color: var(--dark-ink); border-bottom-color: transparent; }
.rk.me .rk-p, .rk.me .rk-sub, .rk.me .rk-x { color: var(--dark-ink2); }
.rk-gap { text-align: center; color: var(--ink3); line-height: 48rpx; letter-spacing: 8rpx; border-bottom: 2rpx solid var(--hair); }

/* ---------- 一排数字 ---------- */
.stats { display: flex; padding: var(--s3) 0; border-top: 2rpx solid var(--hair); border-bottom: 2rpx solid var(--hair); }
.stat { flex: 1; min-width: 0; }
.stat-n { font-family: var(--f-ms); font-size: var(--t-title); line-height: 1.2; }
.stat-u { font-family: var(--f-body); font-size: var(--t-caption); color: var(--ink2); }
.stat-l { font-size: var(--t-caption); color: var(--ink2); }
.stats.mid { text-align: center; }

/* ---------- 文字切换（下划线）：等分、不换行 ---------- */
.tabs { display: flex; border-bottom: 2rpx solid var(--hair); }
.tab { flex: 1; min-width: 0; min-height: 88rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; font-size: 28rpx; color: var(--ink2); white-space: nowrap; border-bottom: 4rpx solid transparent; margin-bottom: -2rpx; box-sizing: border-box; }
.tab.on { color: var(--strong); font-weight: 600; border-bottom-color: var(--strong); }
.tab-n { font-family: var(--f-ms); font-size: var(--t-caption); font-weight: 400; color: var(--ink2); line-height: 1.2; }

/* ---------- 标签、胶囊 ---------- */
.tag { display: inline-block; font-size: var(--t-caption); line-height: 1.5; padding: 0 var(--s2); border-radius: var(--r-pill); color: var(--ink2); border: 2rpx solid var(--hair2); white-space: nowrap; }
.tag.amber { color: var(--star); border-color: var(--star-line); }
.tag.coral { color: var(--bad); border-color: rgba(232,131,106,.5); }
.tag.blue, .tag.gray { color: var(--ink2); border-color: var(--hair2); }
.chips { display: flex; gap: var(--s2); }
.chip { flex: none; display: inline-flex; align-items: center; height: 72rpx; padding: 0 var(--s4); border-radius: var(--r-pill); font-size: 26rpx; color: var(--ink2); border: 2rpx solid var(--hair2); white-space: nowrap; box-sizing: border-box; }
.chip.on { background: var(--btn); color: var(--on-btn); border-color: var(--btn); font-weight: 600; }

/* ---------- 进度条 ---------- */
.bar { height: 8rpx; border-radius: var(--r-pill); background: var(--hair); overflow: hidden; }
.bar-in { height: 100%; border-radius: var(--r-pill); background: var(--star); transition: width .4s; }

/* ---------- 答题选项：对 = 绿线，错 = 橙线 ---------- */
.opt { position: relative; display: flex; align-items: center; justify-content: space-between; gap: var(--s2); min-height: 104rpx; padding: var(--s2) var(--s4); margin-bottom: var(--s2); border: 2rpx solid var(--hair2); border-radius: var(--r-sm); box-sizing: border-box; font-size: var(--t-body); color: var(--strong); word-break: break-word; }
.opt.ms { font-size: 34rpx; }
.opt.hover { opacity: .72; }
.opt.on { border-color: var(--strong); background: var(--hair); }
.opt.right { color: var(--ok); border-color: var(--ok); background: var(--ok-l); }
.opt.right::after { content: ''; flex: none; width: 24rpx; height: 12rpx; border-left: 4rpx solid var(--ok); border-bottom: 4rpx solid var(--ok); transform: rotate(-45deg) translateY(-4rpx); }
.opt.wrong { color: var(--bad); border-color: var(--bad); background: var(--bad-l); }
.opt.wrong::after { content: '你选的'; flex: none; font-size: var(--t-caption); font-family: var(--f-body); font-style: normal; color: var(--bad); }
.opt.dim { opacity: .4; }

/* ---------- 表单 ---------- */
.field { margin-bottom: var(--s4); }
.label { font-size: var(--t-caption); color: var(--ink2); margin-bottom: var(--s1); }
.input { height: 96rpx; padding: 0 var(--s3); border: 2rpx solid var(--hair2); border-radius: var(--r-sm); background: transparent; color: var(--strong); font-size: var(--t-body); box-sizing: border-box; }
.input-focus { border-color: var(--strong); }
.ph { color: var(--ink3); }
.err { color: var(--bad); font-size: var(--t-caption); margin-top: var(--s1); }

/* ---------- 释义 + 例句 ---------- */
.sense { padding: var(--s3) 0; border-top: 2rpx solid var(--hair); }
.sense:first-child { border-top: 0; }
.pos { font-family: var(--f-ms); font-style: italic; font-size: var(--t-caption); color: var(--ink2); margin-right: var(--s2); }
.example { margin-top: var(--s1); padding-left: var(--s3); border-left: 2rpx solid var(--hair2); font-size: 32rpx; line-height: 1.5; }
/* 深色底上细字显小：例句和译文比正文大一号（2026-11-24 老师反馈，对齐 v1 旅行手账的大小） */
.example .small { font-size: 26rpx; line-height: 1.45; }

/* ---------- 成绩头 ---------- */
.res { text-align: center; padding: var(--s3) 0 var(--s4); }
.res-bird { display: block; width: 176rpx; height: 176rpx; border-radius: 50%; margin: 0 auto var(--s3); background: var(--photo); }
.res-n { font-family: var(--f-ms); font-size: var(--t-display); line-height: 1.1; color: var(--star); }
.res-u { font-family: var(--f-body); font-size: var(--t-body); color: var(--ink2); }

/* ---------- 象牙色弹层 ---------- */
.sheet { background: var(--raise); box-shadow: var(--raise-sh); color: var(--dark-ink); border-radius: var(--r-lg); padding: var(--s4); box-sizing: border-box; }

/* ---------- 印章（旅程里盖章用）---------- */
.stamp { width: 132rpx; height: 132rpx; border-radius: 50%; border: 2rpx solid var(--star); color: var(--star); display: flex; flex-direction: column; align-items: center; justify-content: center; position: relative; box-sizing: border-box; text-align: center; line-height: 1.2; flex: none; }
.stamp .s1 { font-size: 26rpx; font-weight: 700; font-family: var(--f-zh); }
.stamp .s2 { font-size: 20rpx; }
.stamp.off { border-color: var(--hair2); color: var(--ink2); border-style: dashed; }

/* ---------- 旧类名：老页面还在用，样子并到新系统里 ---------- */
.songket { height: 2rpx; background: var(--hair); }
.ticket { position: relative; border-bottom: 2rpx solid var(--hair); }
.ticket-cut { border-top: 2rpx dashed var(--hair2); }
.tile { padding: var(--s2) 0; text-align: center; }
.tile .n { font-family: var(--f-ms); font-size: var(--t-title); line-height: 1.2; }
.tile.hover { opacity: .72; }
.medal { width: 48rpx; flex: none; text-align: center; font-family: var(--f-ms); font-size: 28rpx; color: var(--ink2); }
.medal.m1, .medal.m2, .medal.m3 { color: var(--strong); font-size: var(--t-section); }

/* ================= 白天「旅行手账」排版（2026-11-25，照 design/mp-v2 方向 A）=================
   只在 th.day 时用：每页 <block wx:if="{{th.day}}"> 里用 dA- 开头的类，夜晚那套不动。
   尺寸 = 设计稿 px × 2 rpx。颜色写死成手账色（这些类只在白天出现）。 */
.dA { --pa: #f7f2e8; --pa2: #efe6d3; --cd: #fcf9f3; --ik: #1c2420; --ik2: #47524c; --mu: #727a74; --ln: #dcd1bb; --gr: #1f5a43; --gr-d: #15402f; --gr-l: #e3ece4; --tl: #123f45; --am: #c46d1c; --am-l: #f5e2c7; --rd: #b4472f;
  --serif: "Songti SC", "STSong", "Noto Serif CJK SC", "Source Han Serif SC", serif; --latin: var(--f-ms); --mono: Menlo, "SF Mono", Consolas, monospace;
  color: var(--ik); font-size: 30rpx; line-height: 1.5; }
.dA-pad { padding: 8rpx 40rpx 0; }
.dA-eb { font-size: 24rpx; letter-spacing: .12em; color: var(--mu); }
.dA-h1 { font-family: var(--serif); font-size: 56rpx; line-height: 1.25; font-weight: 700; margin-top: 4rpx; }
.dA-rule { height: 3rpx; background: var(--ik); }
.dA-latin { font-family: var(--latin); }
.dA-mono { font-family: var(--mono); }
.dA-btn { display: flex; align-items: center; justify-content: center; height: 104rpx; border-radius: 16rpx; background: var(--gr); color: #fff; font-weight: 700; font-size: 34rpx; padding: 0; margin: 0; line-height: 1; width: auto; }
.dA-btn::after { border: 0; }
.dA-btn.ghost { background: transparent; color: var(--ik); border: 3rpx solid var(--ik); }
.dA-btn .arr { margin-left: 16rpx; font-family: var(--latin); font-weight: 400; }
.dA-sec { display: flex; justify-content: space-between; align-items: baseline; margin: 40rpx 0 16rpx; }
.dA-sec .t { font-family: var(--serif); font-size: 36rpx; font-weight: 700; }
.dA-sec .x { font-size: 26rpx; color: var(--mu); }
.dA-card { background: var(--cd); border: 3rpx solid var(--ik); border-radius: 28rpx; box-shadow: 8rpx 10rpx 0 var(--pa2); }
.dA-stamp { display: inline-flex; align-items: center; justify-content: center; border: 3rpx solid var(--rd); color: var(--rd); border-radius: 8rpx; font-size: 22rpx; font-weight: 700; padding: 2rpx 12rpx; transform: rotate(-6deg); letter-spacing: .1em; }
.dA-lv { display: flex; align-items: center; }
.dA-lv .d { width: 14rpx; height: 14rpx; border-radius: 50%; border: 2.4rpx solid var(--gr); margin-left: 6rpx; box-sizing: border-box; }
.dA-lv .d.f { background: var(--gr); }
.dA-chips { display: flex; flex-wrap: wrap; margin: 24rpx -8rpx 0; }
.dA-chip { height: 68rpx; padding: 0 26rpx; margin: 8rpx; border-radius: 34rpx; border: 2rpx solid var(--ln); display: flex; align-items: center; font-size: 28rpx; color: var(--ik2); background: var(--cd); }
.dA-chip.on { background: var(--ik); color: var(--pa); border-color: var(--ik); }
.dA-seg { display: flex; border: 3rpx solid var(--ik); border-radius: 16rpx; overflow: hidden; }
.dA-seg .s { padding: 0 24rpx; height: 64rpx; display: flex; align-items: center; font-size: 26rpx; }
.dA-seg .s.on { background: var(--ik); color: var(--pa); }
.dA .hover { opacity: .72; }
