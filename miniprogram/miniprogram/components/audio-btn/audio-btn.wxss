.ab { display: inline-flex; align-items: center; gap: 10rpx; padding: 8rpx 18rpx 8rpx 8rpx; border-radius: 999rpx; background: #e4f1ff; color: #2f86d6; font-size: 24rpx; font-weight: 800; vertical-align: middle; }
.ab-hover { opacity: .7; }
.ic { width: 44rpx; height: 44rpx; border-radius: 50%; background: #4aa8ff; display: flex; align-items: center; justify-content: center; }
.tri { width: 0; height: 0; border-left: 16rpx solid #fff; border-top: 10rpx solid transparent; border-bottom: 10rpx solid transparent; margin-left: 4rpx; }
.lb { line-height: 1; }
