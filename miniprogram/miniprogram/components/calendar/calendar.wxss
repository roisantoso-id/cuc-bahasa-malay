.head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }
.title { font-size: 32rpx; font-weight: 700; font-family: "Songti SC", "STSong", serif; }
.nav { width: 88rpx; height: 88rpx; line-height: 84rpx; text-align: center; font-size: 44rpx; color: rgba(243,234,214,.64); }
.grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 8rpx; }
.wk { text-align: center; font-size: 24rpx; color: rgba(243,234,214,.64); padding: 8rpx 0; }
.cell { height: 64rpx; line-height: 64rpx; text-align: center; font-size: 24rpx; font-family: Georgia, serif; border-radius: 50%; }
.cell.on { background: #8fc0a0; color: #0a1f22; }
.cell.today { box-shadow: inset 0 0 0 2rpx #e9b961; }
