.head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12rpx; }
.title { font-weight: 900; }
.nav { width: 64rpx; height: 64rpx; line-height: 60rpx; text-align: center; font-size: 40rpx; color: #8a9097; }
.grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 8rpx; }
.wk { text-align: center; font-size: 22rpx; color: #8a9097; padding: 6rpx 0; }
.cell { height: 64rpx; line-height: 64rpx; text-align: center; font-size: 26rpx; font-weight: 700; border-radius: 50%; }
.cell.on { background: #ff6b5a; color: #fff; }
.cell.today { box-shadow: inset 0 0 0 4rpx #2fae66; }
