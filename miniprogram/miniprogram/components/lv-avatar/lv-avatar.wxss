.la { position: relative; border-radius: 50%; padding: 8rpx; box-sizing: border-box; flex: none; }
.la-img { display: block; width: 100%; height: 100%; border-radius: 50%; background: #f3ead6; border: 4rpx solid #0a1f22; box-sizing: border-box; }
.la-lv { position: absolute; top: -6rpx; left: 50%; transform: translateX(-50%); padding: 0 14rpx; height: 36rpx; line-height: 36rpx; border-radius: 999rpx; background: #e9b961; color: #0a1f22; font-size: 22rpx; font-weight: 800; font-family: Georgia, serif; border: 3rpx solid #0a1f22; white-space: nowrap; }
