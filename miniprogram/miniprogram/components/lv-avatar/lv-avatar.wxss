.la { position: relative; border-radius: 50%; padding: 8rpx; box-sizing: border-box; flex: none; }
.la-img { display: block; width: 100%; height: 100%; border-radius: 50%; background: var(--photo); border: 4rpx solid var(--night); box-sizing: border-box; }
.la-lv { position: absolute; top: -6rpx; left: 50%; transform: translateX(-50%); padding: 0 14rpx; height: 36rpx; line-height: 36rpx; border-radius: 999rpx; background: var(--star); color: var(--on-star); font-size: 22rpx; font-weight: 800; font-family: Georgia, serif; border: 3rpx solid var(--night); white-space: nowrap; }
