.bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 99; display: flex; padding: 10rpx 16rpx calc(10rpx + env(safe-area-inset-bottom)); background: #0f2a2e; border-top: 2rpx solid rgba(243,234,214,.08); border-radius: 36rpx 36rpx 0 0; box-shadow: 0 -12rpx 30rpx rgba(0,0,0,.25); }
.it { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; height: 104rpx; }
.ic { width: 88rpx; height: 60rpx; display: flex; align-items: flex-end; justify-content: center; }
.svg { width: 46rpx; height: 46rpx; margin-bottom: 4rpx; opacity: .85; }
.t { font-size: 22rpx; color: #9aa59f; margin-top: 4rpx; letter-spacing: 1rpx; }
/* 选中：犀鸟头像从栏里探出来，底下一道星光色的托 */
.it.on .t { color: #e9b961; font-weight: 700; }
.bird { width: 76rpx; height: 76rpx; border-radius: 50%; margin-bottom: -2rpx; box-shadow: 0 0 0 4rpx #e9b961, 0 8rpx 16rpx rgba(0,0,0,.4); transform: translateY(-14rpx); background: #f3ead6; }
.bird.hop { animation: hop .5s cubic-bezier(.3,1.7,.5,1); }
@keyframes hop { 0% { transform: translateY(10rpx) scale(.6); } 60% { transform: translateY(-22rpx) scale(1.05); } 100% { transform: translateY(-14rpx) scale(1); } }
