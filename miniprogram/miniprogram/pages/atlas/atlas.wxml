<page-meta page-style="{{th.style}}" background-color="{{th.bg}}" background-text-style="{{th.day ? 'dark' : 'light'}}" />
<wxs src="../../utils/fit.wxs" module="fit" />
<view class="at-page">
  <hb-empty wx:if="{{view === 'loading'}}" image="loading" title="正在点亮星星…" />
  <hb-empty wx:elif="{{view === 'error'}}" image="fail" title="{{error}}"><button class="btn btn-main" hover-class="hover" bindtap="load">再试一次</button></hb-empty>
  <hb-empty wx:elif="{{!days.length}}" image="study" title="还没有学过的词" desc="去「今日」开始学，学过的词会按天出现在这里。" />

  <block wx:else>
    <view class="wrap at-head">
      <view><text class="num-xl">{{learned}}</text><text class="at-u"> 个词已点亮</text></view>
      <view class="muted small">{{cur.label}} · {{cur.date}} · {{cur.words.length}} 个词{{more ? '（显示前 ' + shownN + ' 个）' : ''}}</view>
    </view>

    <!-- 按天切换：全部 / 第 1 天 / 第 2 天 … 一行，左右滑 -->
    <scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="at-days" scroll-into-view="{{intoView}}">
      <view class="at-days-in">
        <view wx:for="{{days}}" wx:key="key" id="d{{index}}" class="at-dy {{sel === index ? 'on' : ''}}" data-i="{{index}}" bindtap="pick">
          <view class="at-dy-t">{{item.label}}</view>
          <view class="at-dy-d">{{item.short}}</view>
        </view>
      </view>
    </scroll-view>

    <!-- 词云：先是漫天星星旋转，再飞过去拼成单词（star-cloud，Three.js），拼好后可点的文字淡入叠在星星上；越熟的词越大越亮 -->
    <view class="at-cloud {{formed ? 'formed' : 'wait'}}" style="height:{{cloudH}}px">
      <star-cloud words="{{cloud}}" width="{{W}}" height="{{cloudH}}" play="{{skyPlay}}" bind:formed="formed" />
      <view wx:for="{{cloud}}" wx:key="k" class="at-w b{{item.b}}" style="left:{{item.x}}px;top:{{item.y}}px;font-size:{{item.fs}}px;animation-delay:{{item.d}}ms, {{item.d + 500}}ms;animation-duration:.5s, {{item.dur}}s" data-r="{{item.rank}}" data-x="{{item.x}}" data-y="{{item.y}}" bindtap="open">{{item.ms}}</view>
    </view>
    <view class="at-hint">越大越亮的词记得越牢 · 点词看释义</view>
  </block>

  <!-- 单词弹窗：从点的那个词的位置放大出来，点空白处缩回去 -->
  <view wx:if="{{pop}}" class="at-mask {{popOn ? 'on' : ''}}" bindtap="close" catchtouchmove="noop">
    <view class="sheet at-pop {{popOn ? 'on' : ''}}" style="transform-origin:{{popOx}}px {{popOy}}px" catchtap="noop">
      <view class="at-pop-h">
        <view class="at-pop-ms" style="font-size:{{fit.fs(pop.ms, 64, 420)}}rpx">{{pop.ms}}</view>
        <say-btn src="{{pop.audio}}" size="md" tone="ivory" />
      </view>
      <view wx:if="{{pop.root}}" class="at-pop-root">词根 {{pop.root}}</view>
      <scroll-view scroll-y class="at-pop-body">
        <view wx:for="{{pop.senses}}" wx:key="index" class="at-pop-s">
          <view class="at-pop-zh"><text wx:if="{{item.pos}}" class="at-pop-pos">{{item.pos}}</text>{{item.zh}}</view>
          <view wx:if="{{item.exMs}}" class="at-pop-ex"><view class="at-pop-exm">{{item.exMs}}</view><view class="at-pop-exz">{{item.exZh}}</view></view>
        </view>
        <view wx:if="{{!pop.senses}}" class="at-pop-exz">正在加载释义…</view>
      </scroll-view>
      <view class="at-pop-f">
        <view class="at-fav-wrap"><view class="at-fav {{pop.fav ? 'on' : ''}} {{favPop ? 'popa' : ''}}" bindtap="fav"><image class="at-fav-i" src="/assets/fx/{{pop.fav ? 'star-amber' : (th.day ? 'star-line-day' : 'star-line')}}.svg" />{{pop.fav ? '已收藏' : '收藏'}}</view><fx-burst fire="{{favFx}}" /></view>
        <view class="at-pop-x" bindtap="close">收起</view>
      </view>
    </view>
  </view>
</view>
<view class="tab-pad" />
