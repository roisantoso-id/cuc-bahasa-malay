/* 图鉴：按天的词云。星光只给记得最牢的词（这就是「点亮」） */
.at-head { padding-bottom: var(--s2); }
.at-u { font-size: var(--t-body); color: var(--ink2); }

/* 按天切换：没有边框的一排，选中是象牙色小块。一行，不换行 */
.at-days { width: 100%; white-space: nowrap; }
.at-days-in { display: inline-flex; gap: var(--s1); padding: 0 var(--s4); }
.at-dy { display: inline-flex; flex-direction: column; align-items: center; justify-content: center; min-width: 112rpx; height: 88rpx; padding: 0 var(--s2); border-radius: var(--r-sm); box-sizing: border-box; }
.at-dy-t { font-size: 26rpx; line-height: 1.3; color: var(--ink2); }
.at-dy-d { font-family: var(--f-ms); font-size: 22rpx; line-height: 1.3; color: var(--ink3); }
.at-dy.on { background: var(--btn); }
.at-dy.on .at-dy-t { color: var(--on-btn); font-weight: 600; }
.at-dy.on .at-dy-d { color: var(--on-btn); opacity: .75; }

/* 词云是这一屏唯一的面板。左右各留 32rpx：atlas.js 按「屏宽 - 32px」排版，别改 */
.at-cloud { position: relative; margin: var(--s2) var(--s4) 0; border-radius: var(--r-lg); background: var(--panel2); overflow: hidden; }
.at-w { position: absolute; white-space: nowrap; font-family: var(--f-ms); font-style: var(--ms-style); line-height: 1.2; padding: 2px 4px; opacity: 0; animation-name: at-pop, at-drift; animation-timing-function: cubic-bezier(.3,1.5,.5,1), ease-in-out; animation-fill-mode: both, none; animation-iteration-count: 1, infinite; animation-direction: normal, alternate; }
.at-w.b0 { color: var(--ink3); }
.at-w.b1 { color: var(--ink2); }
.at-w.b2 { color: var(--strong); }
.at-w.b3 { color: var(--strong); }
.at-w.b4 { color: var(--star); font-weight: 700; }
@keyframes at-pop { from { opacity: 0; transform: scale(.3); } to { opacity: 1; transform: scale(1); } }
@keyframes at-drift { from { transform: translateY(0); opacity: 1; } to { transform: translateY(-5px); opacity: 1; } }
/* 星星还在拼字时先把文字藏起来；拼好（formed）后再弹出来叠在星星上 */
.at-cloud.wait .at-w { animation: none; opacity: 0; }
.at-cloud .at-w { z-index: 1; text-shadow: 0 0 12px var(--glow); }
.at-hint { text-align: center; font-size: var(--t-caption); color: var(--ink2); margin-top: var(--s2); }
@media (prefers-reduced-motion: reduce) { .at-w { animation: none; opacity: 1; } }

/* 单词弹窗（.sheet）。宽 86vw、离顶 18vh：atlas.js 按这两个数算放大的原点，别改 */
.at-mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 200; background: rgba(5,16,18,0); transition: background-color .25s; display: flex; align-items: flex-start; justify-content: center; padding-top: 18vh; }
.at-mask.on { background: var(--scrim); }
.at-pop { width: 86vw; max-height: 62vh; display: flex; flex-direction: column; padding-bottom: var(--s2); transform: scale(.08); opacity: 0; transition: transform .28s cubic-bezier(.3,1.3,.5,1), opacity .2s; }
.at-pop.on { transform: scale(1); opacity: 1; }
.at-pop-h { display: flex; align-items: center; justify-content: space-between; gap: var(--s2); }
.at-pop-ms { font-family: var(--f-ms); font-style: var(--ms-style); font-weight: var(--ms-bold); font-size: 64rpx; color: var(--leaf); line-height: 1.15; white-space: nowrap; }
.at-pop-root { font-size: var(--t-caption); color: var(--dark-ink2); margin-top: var(--s1); }
.at-pop-body { margin-top: var(--s2); max-height: 40vh; }
.at-pop-s { padding: var(--s2) 0; border-top: 2rpx solid var(--dark-hair); }
.at-pop-zh { font-size: var(--t-body); font-weight: 600; line-height: 1.4; }
.at-pop-pos { font-family: var(--f-ms); font-style: italic; font-weight: 400; font-size: var(--t-caption); color: var(--star-d); margin-right: var(--s1); }
.at-pop-ex { margin-top: var(--s1); padding-left: var(--s2); border-left: 2rpx solid var(--dark-hair); }
.at-pop-exm { font-family: var(--f-ms); font-size: 28rpx; line-height: 1.45; }
.at-pop-exz { font-size: var(--t-caption); color: var(--dark-ink2); }
.at-pop-f { display: flex; align-items: center; justify-content: space-between; margin-top: var(--s1); padding-top: var(--s1); border-top: 2rpx solid var(--dark-hair); }
.at-fav-wrap { position: relative; }
.at-fav { display: inline-flex; align-items: center; gap: var(--s1); height: 88rpx; padding-right: var(--s3); font-size: 26rpx; font-weight: 600; }
.at-fav.on { color: var(--star-d); }
.at-fav-i { width: 36rpx; height: 36rpx; }
.at-fav.popa { animation: at-favpop .4s cubic-bezier(.3,1.6,.5,1); }
@keyframes at-favpop { 0% { transform: scale(1); } 40% { transform: scale(1.18); } 100% { transform: scale(1); } }
.at-pop-x { height: 88rpx; line-height: 88rpx; padding-left: var(--s3); font-size: 26rpx; color: var(--dark-ink2); }

/* ================= 白天「旅行手账」A4 图鉴（design/mp-v2 方向 A）：尺寸 = 设计稿 px × 2 ================= */
.dA-at { padding-bottom: 40rpx; }
/* 搜索框：墨线框，点了去查词页 */
.dA-at-srch { display: flex; align-items: center; height: 88rpx; border: 3rpx solid var(--ik); border-radius: 16rpx; padding: 0 24rpx; margin-top: 24rpx; background: var(--cd); color: var(--mu); font-size: 30rpx; box-sizing: border-box; }
.dA-at-srch-i { position: relative; flex: none; width: 24rpx; height: 24rpx; margin-right: 20rpx; border: 3rpx solid var(--ik2); border-radius: 50%; box-sizing: border-box; }
.dA-at-srch-i::after { content: ''; position: absolute; right: -10rpx; bottom: -6rpx; width: 12rpx; height: 3rpx; background: var(--ik2); transform: rotate(45deg); border-radius: 2rpx; }
/* 十站 = 十段词频：柱子按学过的比例填绿；选中的描墨线；没开放的变淡 */
.dA-at-bands { display: flex; margin-top: 28rpx; }
.dA-at-band { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; margin: 0 3rpx; padding-top: 4rpx; }
.dA-at-bar { position: relative; width: 100%; height: 44rpx; border-radius: 4rpx 4rpx 0 0; background: var(--pa2); overflow: hidden; }
.dA-at-fill { position: absolute; left: 0; right: 0; bottom: 0; background: var(--gr); }
.dA-at-no { font-family: var(--mono); font-size: 22rpx; line-height: 1.2; color: var(--mu); margin-top: 8rpx; }
.dA-at-band.on .dA-at-bar { z-index: 1; box-shadow: 0 0 0 2rpx var(--pa), 0 0 0 5rpx var(--ik); }
.dA-at-band.on .dA-at-no { color: var(--ik); font-weight: 700; }
.dA-at-band.off { opacity: .45; }
.dA-at-cap { font-size: 26rpx; color: var(--ik2); margin-top: 12rpx; line-height: 1.5; }
.dA-at-cap-h { font-family: var(--serif); font-size: 30rpx; font-weight: 700; color: var(--ik); }
/* 词性胶囊（通用 .dA-chip，34px 高） */
.dA-at-chips { margin-top: 16rpx; }
/* 词表：序号 / 单词 / 词性 / 释义 / 记得多牢 */
.dA-at-rule { margin-top: 20rpx; }
.dA-at-row { display: flex; align-items: baseline; min-height: 96rpx; padding: 20rpx 0; border-bottom: 2rpx solid var(--ln); box-sizing: border-box; }
.dA-at-rk { flex: none; width: 68rpx; margin-right: 20rpx; font-family: var(--mono); font-size: 24rpx; color: var(--mu); }
.dA-at-ms { flex: none; width: 172rpx; margin-right: 20rpx; font-family: var(--latin); font-size: 40rpx; line-height: 1.2; color: var(--ik); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.dA-at-pos { flex: none; width: 36rpx; margin-right: 20rpx; font-family: var(--serif); font-style: italic; font-size: 26rpx; color: var(--am); }
.dA-at-zh { flex: 1; min-width: 0; font-size: 30rpx; color: var(--ik); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.dA-at-lv { flex: none; align-self: center; margin-left: 14rpx; }
.dA-at-foot { text-align: center; font-size: 24rpx; color: var(--mu); padding: 32rpx 0 8rpx; }
