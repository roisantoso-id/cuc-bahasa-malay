/* 图鉴：按天的词云。星光只给记得最牢的词（这就是「点亮」） */
.at-head { padding-bottom: var(--s2); }
.at-u { font-size: var(--t-body); color: var(--ink2); }

/* 按天切换：没有边框的一排，选中是象牙色小块。一行，不换行 */
.at-days { width: 100%; white-space: nowrap; }
.at-days-in { display: inline-flex; gap: var(--s1); padding: 0 var(--s4); }
.at-dy { display: inline-flex; flex-direction: column; align-items: center; justify-content: center; min-width: 112rpx; height: 88rpx; padding: 0 var(--s2); border-radius: var(--r-sm); box-sizing: border-box; }
.at-dy-t { font-size: 26rpx; line-height: 1.3; color: var(--ink2); }
.at-dy-d { font-family: var(--f-ms); font-size: 22rpx; line-height: 1.3; color: var(--ink3); }
.at-dy.on { background: var(--ivory); }
.at-dy.on .at-dy-t { color: var(--dark-ink); font-weight: 600; }
.at-dy.on .at-dy-d { color: var(--dark-ink2); }

/* 词云是这一屏唯一的面板。左右各留 32rpx：atlas.js 按「屏宽 - 32px」排版，别改 */
.at-cloud { position: relative; margin: var(--s2) var(--s4) 0; border-radius: var(--r-lg); background: var(--panel2); overflow: hidden; }
.at-w { position: absolute; white-space: nowrap; font-family: var(--f-ms); font-style: italic; line-height: 1.2; padding: 2px 4px; opacity: 0; animation-name: at-pop, at-drift; animation-timing-function: cubic-bezier(.3,1.5,.5,1), ease-in-out; animation-fill-mode: both, none; animation-iteration-count: 1, infinite; animation-direction: normal, alternate; }
.at-w.b0 { color: rgba(243,234,214,.5); }
.at-w.b1 { color: rgba(243,234,214,.72); }
.at-w.b2 { color: var(--ivory); }
.at-w.b3 { color: var(--ivory); }
.at-w.b4 { color: var(--star); font-weight: 700; }
@keyframes at-pop { from { opacity: 0; transform: scale(.3); } to { opacity: 1; transform: scale(1); } }
@keyframes at-drift { from { transform: translateY(0); opacity: 1; } to { transform: translateY(-5px); opacity: 1; } }
.at-hint { text-align: center; font-size: var(--t-caption); color: var(--ink2); margin-top: var(--s2); }
@media (prefers-reduced-motion: reduce) { .at-w { animation: none; opacity: 1; } }

/* 单词弹窗（.sheet）。宽 86vw、离顶 18vh：atlas.js 按这两个数算放大的原点，别改 */
.at-mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 200; background: rgba(5,16,18,0); transition: background-color .25s; display: flex; align-items: flex-start; justify-content: center; padding-top: 18vh; }
.at-mask.on { background: rgba(5,16,18,.72); }
.at-pop { width: 86vw; max-height: 62vh; display: flex; flex-direction: column; padding-bottom: var(--s2); transform: scale(.08); opacity: 0; transition: transform .28s cubic-bezier(.3,1.3,.5,1), opacity .2s; }
.at-pop.on { transform: scale(1); opacity: 1; }
.at-pop-h { display: flex; align-items: center; justify-content: space-between; gap: var(--s2); }
.at-pop-ms { font-family: var(--f-ms); font-style: italic; font-weight: 700; font-size: 64rpx; color: var(--leaf); line-height: 1.15; word-break: break-word; }
.at-pop-root { font-size: var(--t-caption); color: var(--dark-ink2); margin-top: var(--s1); }
.at-pop-body { margin-top: var(--s2); max-height: 40vh; }
.at-pop-s { padding: var(--s2) 0; border-top: 2rpx solid var(--dark-hair); }
.at-pop-zh { font-size: var(--t-body); font-weight: 600; line-height: 1.4; }
.at-pop-pos { font-family: var(--f-ms); font-style: italic; font-weight: 400; font-size: var(--t-caption); color: var(--star-d); margin-right: var(--s1); }
.at-pop-ex { margin-top: var(--s1); padding-left: var(--s2); border-left: 2rpx solid var(--dark-hair); }
.at-pop-exm { font-family: var(--f-ms); font-size: 28rpx; line-height: 1.45; }
.at-pop-exz { font-size: var(--t-caption); color: var(--dark-ink2); }
.at-pop-f { display: flex; align-items: center; justify-content: space-between; margin-top: var(--s1); padding-top: var(--s1); border-top: 2rpx solid var(--dark-hair); }
.at-fav-wrap { position: relative; }
.at-fav { display: inline-flex; align-items: center; gap: var(--s1); height: 88rpx; padding-right: var(--s3); font-size: 26rpx; font-weight: 600; }
.at-fav.on { color: var(--star-d); }
.at-fav-i { width: 36rpx; height: 36rpx; }
.at-fav.popa { animation: at-favpop .4s cubic-bezier(.3,1.6,.5,1); }
@keyframes at-favpop { 0% { transform: scale(1); } 40% { transform: scale(1.18); } 100% { transform: scale(1); } }
.at-pop-x { height: 88rpx; line-height: 88rpx; padding-left: var(--s3); font-size: 26rpx; color: var(--dark-ink2); }
