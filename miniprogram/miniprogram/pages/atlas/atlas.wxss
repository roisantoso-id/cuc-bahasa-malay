.head { padding-bottom: 8rpx; }
.lit-n { font-family: Georgia, serif; font-size: 80rpx; line-height: 1.1; color: var(--star); }
.lit-u { font-size: 28rpx; color: var(--ink2); }
.cap { font-size: 24rpx; color: var(--ink2); margin-top: 6rpx; }

.days { width: 100%; white-space: nowrap; margin-top: 16rpx; }
.days-in { display: inline-flex; gap: 14rpx; padding: 0 32rpx; }
.dy { display: inline-flex; flex-direction: column; align-items: center; justify-content: center; min-width: 116rpx; height: 96rpx; padding: 0 18rpx; border-radius: 24rpx; border: 2rpx solid var(--hair2); box-sizing: border-box; }
.dy-t { font-size: 26rpx; font-weight: 700; color: var(--ivory); }
.dy-d { font-size: 20rpx; color: var(--ink2); margin-top: 2rpx; }
.dy.on { background: var(--ivory); border-color: var(--ivory); }
.dy.on .dy-t { color: var(--dark-ink); }
.dy.on .dy-d { color: rgba(10,31,34,.6); }

.cloud { position: relative; margin: 24rpx 32rpx 0; border-radius: 32rpx; background: radial-gradient(ellipse at 50% 45%, #163d43 0%, #0d2629 70%); border: 2rpx solid var(--hair); overflow: hidden; }
.w { position: absolute; white-space: nowrap; font-family: Georgia, serif; font-style: italic; font-weight: 700; line-height: 1.2; padding: 2px 4px; opacity: 0; animation-name: pop, drift; animation-timing-function: cubic-bezier(.3,1.5,.5,1), ease-in-out; animation-fill-mode: both, none; animation-iteration-count: 1, infinite; animation-direction: normal, alternate; }
.w.b0 { color: #8fc0a0; }
.w.b1 { color: #b9d4c2; }
.w.b2 { color: #f3ead6; }
.w.b3 { color: #f6dfa9; }
.w.b4 { color: #e9b961; text-shadow: 0 0 10px rgba(233,185,97,.35); }
@keyframes pop { from { opacity: 0; transform: scale(.3); } to { opacity: 1; transform: scale(1); } }
@keyframes drift { from { transform: translateY(0); opacity: 1; } to { transform: translateY(-5px); opacity: 1; } }
.hint { text-align: center; font-size: 22rpx; color: var(--ink2); margin-top: 18rpx; }
@media (prefers-reduced-motion: reduce) { .w { animation: none; opacity: 1; } }
