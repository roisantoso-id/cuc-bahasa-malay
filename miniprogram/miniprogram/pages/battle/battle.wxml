<view class="wrap">
  <hb-empty wx:if="{{view === 'loading'}}" image="loading" title="正在摆擂台…" />
  <hb-empty wx:elif="{{view === 'error'}}" image="fail" title="{{error || '加载失败'}}"><button class="btn btn-main" hover-class="hover" bindtap="load">再试一次</button></hb-empty>

  <block wx:else>
    <!-- 我的本周 -->
    <view class="mine">
      <image class="mine-av" src="{{me.av || '/assets/avatar.jpg'}}" mode="aspectFill" />
      <view class="mine-main">
        <view class="mine-n">{{me.name || '我'}}</view>
        <view class="mine-s">{{me.place ? '本周第 ' + me.place + ' 名' : '本周还没上榜'}}{{chase ? ' · ' + chase : ''}}</view>
      </view>
      <view class="mine-p"><text class="mine-pn">{{me.points || 0}}</text><text class="mine-pu">分</text></view>
    </view>

    <!-- 两个入口：并排小卡片 -->
    <view class="duo">
      <view class="tile arena" hover-class="hover" bindtap="arena">
        <image class="tile-bird" src="/assets/pass.jpg" mode="aspectFill" />
        <view class="tile-t">每周擂台</view>
        <view class="tile-s">20 题 · 还剩 {{arena ? arena.triesLeft : 3}} 次</view>
        <view class="tile-s">{{cd.d}} 天 {{cd.h}} 小时后结束</view>
        <view class="tile-go">进入 ›</view>
      </view>
      <view class="tile pk">
        <image class="tile-bird" src="/assets/cheer.jpg" mode="aspectFill" />
        <view class="tile-t">好友 PK</view>
        <view class="tile-s">10 题，发给同学比一比</view>
        <view class="tile-row">
          <picker wx:if="{{levels.length}}" range="{{levelNames}}" value="{{levelIdx}}" bindchange="pickLevelIdx"><view class="sel">{{levelNames[levelIdx]}} ▾</view></picker>
          <view class="tile-go go-amber {{busy ? 'dis' : ''}}" bindtap="create">{{busy ? '…' : '发起 ›'}}</view>
        </view>
      </view>
    </view>

    <!-- 周榜 -->
    <view class="between bh"><view class="h2" style="margin:0">周榜</view>
      <view class="tabs"><view wx:for="{{tabs}}" wx:key="k" class="tb {{tab === item.k ? 'on' : ''}}" data-k="{{item.k}}" bindtap="pickTab">{{item.t}}</view></view>
    </view>
    <view wx:if="{{boardLoading && !podium.length}}" class="muted small note">正在排名…</view>
    <view wx:elif="{{boardNote}}" class="muted small note">{{boardNote}}</view>
    <block wx:else>
      <view class="podium">
        <view wx:for="{{podium}}" wx:key="place" class="pd p{{item.place}} {{item.me ? 'me' : ''}}">
          <image wx:if="{{item.av}}" class="pd-av" src="{{item.av}}" mode="aspectFill" />
          <view wx:else class="pd-av pd-mark">{{item.mark}}</view>
          <view class="pd-n">{{item.name}}</view>
          <view class="pd-s">{{item.points}} 分</view>
          <view class="pd-block"><text class="pd-k">{{item.place}}</text></view>
        </view>
      </view>
      <view class="board">
        <block wx:for="{{board}}" wx:key="place">
          <view wx:if="{{item.gap}}" class="gap">· · ·</view>
          <view wx:else class="br {{item.me ? 'me' : ''}}">
            <text class="br-p">{{item.place}}</text>
            <image wx:if="{{item.av}}" class="br-av" src="{{item.av}}" mode="aspectFill" />
            <view wx:else class="br-av pd-mark sm">{{item.mark}}</view>
            <view class="br-main"><view class="br-n">{{item.name}}{{item.me ? '（我）' : ''}}</view><view wx:if="{{item.sub}}" class="br-sub">{{item.sub}}</view></view>
            <text class="br-s">{{item.points}}</text>
          </view>
        </block>
        <view class="more-r" bindtap="rank">看完整榜单 ›</view>
      </view>
    </block>

    <view class="between bh"><view class="h2" style="margin:0">最近的 PK</view></view>
    <view wx:if="{{!pks.length}}" class="muted small note">还没有 PK。在上面选一站点「发起」，发给同学。</view>
    <view wx:else class="list">
      <view wx:for="{{pks}}" wx:key="id" class="item" hover-class="hover-row" data-id="{{item.id}}" bindtap="open">
        <view class="item-main">
          <view class="row"><text class="t">第{{item.level}}站</text><text class="tag {{item.isCreator ? 'amber' : 'blue'}}">{{item.isCreator ? '我发起' : '应战'}}</text></view>
          <view class="muted small">{{item.date}} · {{item.players}} 人参加 · 答对 {{item.correct}}/10</view>
        </view>
        <view class="score">{{item.score}}<text class="muted small"> 分</text></view>
        <text class="arrow">›</text>
      </view>
    </view>
  </block>
</view>
<view class="tab-pad" />
