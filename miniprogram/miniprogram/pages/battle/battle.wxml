<view class="wrap">
  <hb-empty wx:if="{{view === 'loading'}}" image="loading" title="正在摆擂台…" />
  <hb-empty wx:elif="{{view === 'error'}}" image="fail" title="{{error || '加载失败'}}"><button class="btn btn-main" hover-class="hover" bindtap="load">再试一次</button></hb-empty>

  <block wx:else>
    <!-- 两个入口：一行一个，右边一个动作 -->
    <view class="entry">
      <view class="en">
        <view class="en-main">
          <view class="en-t">每周擂台 <text class="en-k">第 {{cd.week}} 周</text></view>
          <view class="en-s">20 题 · 还剩 {{arena ? arena.triesLeft : 3}} 次 · {{cd.d}} 天 {{cd.h}} 小时后结束{{arena && arena.best ? ' · 最高 ' + arena.best.score : ''}}</view>
        </view>
        <button class="btn btn-main btn-sm en-b" hover-class="hover" bindtap="arena">进入</button>
      </view>
      <view class="en">
        <view class="en-main">
          <view class="en-t">好友 PK</view>
          <view class="en-s">10 题，发给同学比谁又快又准</view>
        </view>
        <picker wx:if="{{levels.length}}" range="{{levelNames}}" value="{{levelIdx}}" bindchange="pickLevelIdx"><view class="sel">{{levelNames[levelIdx]}} ▾</view></picker>
        <button class="btn btn-amber btn-sm en-b" hover-class="hover" bindtap="create" disabled="{{busy || !level}}" loading="{{busy}}">发起</button>
      </view>
    </view>

    <view class="between bh"><view class="h2" style="margin:0">周榜</view>
      <view class="tabs"><view wx:for="{{tabs}}" wx:key="k" class="tb {{tab === item.k ? 'on' : ''}}" data-k="{{item.k}}" bindtap="pickTab">{{item.t}}</view></view>
    </view>
    <view class="board">
      <view wx:if="{{boardLoading && !board.length}}" class="muted small note">正在排名…</view>
      <view wx:elif="{{boardNote}}" class="muted small note">{{boardNote}}</view>
      <block wx:for="{{board}}" wx:key="place">
        <view wx:if="{{item.gap}}" class="gap">· · ·</view>
        <view class="br {{item.me ? 'me' : ''}}">
          <text class="br-p">{{item.place}}</text>
          <view class="br-n">{{item.name}}{{item.me ? '（我）' : ''}}</view>
          <text class="br-s">{{item.points}}</text>
        </view>
      </block>
      <view wx:if="{{chase}}" class="chase">{{chase}}</view>
      <view class="more-r" bindtap="rank">看完整榜单 ›</view>
    </view>

    <view class="between bh"><view class="h2" style="margin:0">最近的 PK</view></view>
    <view wx:if="{{!pks.length}}" class="muted small note">还没有 PK。选一站点「发起」，发给同学。</view>
    <view wx:else class="list">
      <view wx:for="{{pks}}" wx:key="id" class="item" hover-class="hover-row" data-id="{{item.id}}" bindtap="open">
        <view class="item-main">
          <view class="row"><text class="t">第{{item.level}}站</text><text class="tag {{item.isCreator ? 'amber' : 'blue'}}">{{item.isCreator ? '我发起' : '应战'}}</text></view>
          <view class="muted small">{{item.date}} · {{item.players}} 人参加 · 答对 {{item.correct}}/10</view>
        </view>
        <view class="score">{{item.score}}<text class="muted small"> 分</text></view>
        <text class="arrow">›</text>
      </view>
    </view>
  </block>
</view>
<view class="tab-pad" />
