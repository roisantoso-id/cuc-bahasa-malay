<page-meta page-style="{{th.style}}" background-color="{{th.bg}}" background-text-style="{{th.day ? 'dark' : 'light'}}" />
<view class="wrap bt-page">
  <hb-empty wx:if="{{view === 'loading'}}" image="loading" title="正在摆擂台…" />
  <hb-empty wx:elif="{{view === 'error'}}" image="fail" title="{{error || '加载失败'}}"><button class="btn btn-main" hover-class="hover" bindtap="load">再试一次</button></hb-empty>

  <!-- 白天「旅行手账」排版（design/mp-v2 方向 A · A5 对战）；夜晚那套在下面 wx:else 里不动 -->
  <block wx:elif="{{th.day}}">
    <view class="dA dA-bt">
      <view class="dA-bt-arena">
        <image class="dA-bt-bird" src="/assets/bird-hero.png" mode="aspectFit" />
        <view class="dA-bt-k dA-mono">周擂台 · 第 {{cd.week}} 周</view>
        <view class="dA-bt-h">{{da.total || 20}} 题，{{da.triesZh || '三'}}次机会</view>
        <view class="dA-bt-p">周日 24:00 截止 · 还剩 {{cd.d}} 天 {{cd.h}} 小时，取最高一次</view>
        <view wx:if="{{da}}" class="dA-bt-kv">
          <view class="dA-bt-kvi"><text class="dA-bt-kvn">{{da.best === null ? '—' : da.best}}</text><text class="dA-bt-kvl">本周最高分</text></view>
          <view class="dA-bt-kvi"><text class="dA-bt-kvn">{{da.triesLeft}}</text><text class="dA-bt-kvl">剩余次数</text></view>
          <view wx:if="{{da.place}}" class="dA-bt-kvi"><text class="dA-bt-kvn">{{da.place}}</text><text class="dA-bt-kvl">全站名次</text></view>
          <view wx:else class="dA-bt-kvi"><text class="dA-bt-kvn">{{da.players}}</text><text class="dA-bt-kvl">本周参加</text></view>
        </view>
        <button class="dA-btn dA-bt-go" hover-class="hover" bindtap="arena">进入擂台</button>
      </view>

      <view class="dA-bt-pk">
        <view class="dA-bt-pk-m"><view class="dA-bt-pk-t">好友 PK</view><view class="dA-bt-pk-d">同一套 10 题，发到微信比一比</view></view>
        <button class="dA-btn dA-bt-pk-b" hover-class="hover" disabled="{{busy}}" bindtap="openPick">{{busy ? '出题中' : '发起'}}</button>
      </view>
      <view wx:if="{{!pks.length}}" class="dA-bt-pk dA-bt-last"><view class="dA-bt-pk-d">还没有 PK，发起一场，答完发给同学</view></view>
      <block wx:else>
        <view class="dA-bt-pk dA-bt-last">
          <view class="dA-bt-last-m" hover-class="hover" data-id="{{pks[0].id}}" bindtap="open">{{pks[0].date}}　第{{pks[0].level}}站 · 答对 <text class="dA-bt-sc">{{pks[0].correct}}/10</text> · {{pks[0].score}} 分</view>
          <view wx:if="{{pks.length > 1}}" class="dA-bt-all" hover-class="hover" bindtap="togglePk">{{showPk ? '收起' : '全部战绩 ›'}}</view>
        </view>
        <block wx:if="{{showPk}}">
          <block wx:for="{{pks}}" wx:key="id">
            <view wx:if="{{index > 0}}" class="dA-bt-pk dA-bt-last" hover-class="hover" data-id="{{item.id}}" bindtap="open">
              <view class="dA-bt-last-m">{{item.date}}　第{{item.level}}站 · {{item.isCreator ? '我发起' : '应战'}} · 答对 {{item.correct}}/10 · {{item.score}} 分</view>
              <text class="dA-bt-all">›</text>
            </view>
          </block>
        </block>
      </block>

      <view class="dA-sec dA-bt-sec">
        <text class="t">周榜</text>
        <view class="dA-seg">
          <view wx:for="{{tabs}}" wx:key="k" class="s {{tab === item.k ? 'on' : ''}}" data-k="{{item.k}}" bindtap="pickTab">{{item.t}}</view>
        </view>
      </view>
      <view class="dA-bt-lbw">
        <view wx:if="{{boardLoading && !dayRows.length}}" class="dA-bt-note">正在排名…</view>
        <view wx:elif="{{boardNote}}" class="dA-bt-note">{{boardNote}}</view>
        <block wx:else>
          <block wx:for="{{dayRows}}" wx:key="place">
            <view wx:if="{{item.gap}}" class="dA-bt-gap">···</view>
            <view class="dA-bt-lb {{item.me ? 'me' : ''}}">
              <text class="dA-bt-rk {{item.place <= 3 ? 'top' : ''}}">{{item.place}}</text>
              <text class="dA-bt-nm">{{item.name}}{{item.me ? '（我）' : ''}}</text>
              <text class="dA-bt-pt">{{item.points}}</text>
            </view>
          </block>
          <view class="dA-bt-more" hover-class="hover" bindtap="rank">完整榜单 ›</view>
        </block>
      </view>
    </view>
  </block>

  <block wx:else>
    <!-- 顶部一块：擂台倒计时 + 剩几次 + 两个按钮，犀鸟缩小放左边 -->
    <view class="bt-hero">
      <view class="bt-top">
        <image class="bt-bird" src="/assets/bird-welcome.png" mode="aspectFit" />
        <view class="bt-hero-l">
          <view class="bt-k">每周擂台 · 第 {{cd.week}} 周 · 距结束</view>
          <view class="bt-cd"><text class="bt-num">{{cd.d}}</text><text class="bt-u">天</text><text class="bt-num">{{cd.h}}</text><text class="bt-u">小时</text></view>
          <view class="bt-k">20 题取三次最高 · 本周还剩 <text class="bt-hl">{{arena ? arena.triesLeft : 3}}</text> 次</view>
        </view>
      </view>
      <view class="bt-acts">
        <button class="btn btn-main bt-a1" hover-class="hover" bindtap="arena">进入擂台</button>
        <button class="btn btn-ghost bt-a2" hover-class="hover" disabled="{{busy}}" bindtap="openPick">{{busy ? '正在出题…' : '发起好友 PK'}}</button>
      </view>
    </view>

    <!-- 周榜 -->
    <view class="sec"><text class="sec-t">周榜</text><view class="sec-x bt-more" hover-class="hover-row" bindtap="rank">完整榜单 ›</view></view>
    <view class="tabs">
      <view wx:for="{{tabs}}" wx:key="k" class="tab {{tab === item.k ? 'on' : ''}}" data-k="{{item.k}}" bindtap="pickTab">{{item.t}}</view>
    </view>

    <!-- 我：这一屏唯一的星光色 -->
    <view class="rk me">
      <image class="rk-av" src="{{me.av || '/assets/avatar.jpg'}}" webp mode="aspectFill" />
      <view class="rk-main">
        <view class="rk-n">{{me.name || '我'}}</view>
        <view class="rk-sub">{{me.place ? '本周第 ' + me.place + ' 名' : '本周还没上榜'}}{{chase ? ' · ' + chase : ''}}</view>
      </view>
      <view class="rk-r"><text class="rk-s">{{me.points || 0}}</text><text class="rk-x"> 分</text></view>
    </view>

    <view wx:if="{{boardLoading && !podium.length}}" class="muted small bt-note">正在排名…</view>
    <view wx:elif="{{boardNote}}" class="muted small bt-note">{{boardNote}}</view>
    <block wx:else>
      <!-- 前三名：只有头像、名字、分数，第一名大一圈 -->
      <view wx:if="{{podium.length >= 3}}" class="bt-podium">
        <view wx:for="{{podium}}" wx:key="place" class="bt-pd bt-p{{item.place}}">
          <view class="bt-pd-k">{{item.place}}</view>
          <image wx:if="{{item.av}}" class="bt-pd-av" src="{{item.av}}" webp mode="aspectFill" />
          <view wx:else class="bt-pd-av bt-mark">{{item.mark}}</view>
          <view class="bt-pd-n">{{item.name}}{{item.me ? '（我）' : ''}}</view>
          <view class="bt-pd-s">{{item.points}} 分</view>
        </view>
      </view>
      <view class="bt-board">
        <block wx:for="{{board}}" wx:key="place">
          <view wx:if="{{item.gap}}" class="rk-gap">···</view>
          <view class="rk">
            <text class="rk-p">{{item.place}}</text>
            <image wx:if="{{item.av}}" class="rk-av" src="{{item.av}}" webp mode="aspectFill" />
            <view wx:else class="rk-av bt-mark sm">{{item.mark}}</view>
            <view class="rk-main"><view class="rk-n">{{item.name}}{{item.me ? '（我）' : ''}}</view><view wx:if="{{item.sub}}" class="rk-sub">{{item.sub}}</view></view>
            <text class="rk-s">{{item.points}}</text>
          </view>
        </block>
      </view>
    </block>

    <view class="sec"><text class="sec-t">最近的 PK</text></view>
    <view wx:if="{{!pks.length}}" class="muted small bt-note">还没有 PK。点上面的「发起好友 PK」，答完发给同学。</view>
    <view wx:else class="list">
      <view wx:for="{{pks}}" wx:key="id" class="item" hover-class="hover-row" data-id="{{item.id}}" bindtap="open">
        <view class="item-main">
          <view>第{{item.level}}站 · {{item.isCreator ? '我发起' : '应战'}}</view>
          <view class="muted small">{{item.date}} · {{item.players}} 人参加 · 答对 {{item.correct}}/10</view>
        </view>
        <view class="rk-r"><text class="rk-s">{{item.score}}</text><text class="rk-x"> 分</text></view>
        <text class="arrow">›</text>
      </view>
    </view>
  </block>
</view>
<view class="tab-pad" />

<!-- 选站弹层（替换系统 picker）：从底部滑出，点哪站就直接发起 -->
<view wx:if="{{pickOpen}}" class="bt-mask {{pickOn ? 'on' : ''}}" bindtap="closePick" catchtouchmove="noop">
  <view class="bt-sheet {{pickOn ? 'on' : ''}}" catchtap="noop">
    <view class="bt-sh-h"><text class="bt-sh-t">选一站来 PK</text><text class="bt-sh-x" bindtap="closePick">取消</text></view>
    <view class="bt-sh-d">从这一站的词里随机出 10 道题</view>
    <view class="bt-st-grid">
      <view wx:for="{{levels}}" wx:key="level" class="bt-st {{item.level === level ? 'cur' : ''}}" hover-class="hover" data-l="{{item.level}}" bindtap="pickAndGo">
        <view class="bt-st-n">{{item.level}}</view>
        <view class="bt-st-c">{{item.city}}</view>
        <view class="bt-st-p">学过 {{item.learned}}</view>
      </view>
    </view>
  </view>
</view>

