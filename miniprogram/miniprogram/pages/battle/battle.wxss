.hero { position: relative; display: flex; align-items: flex-start; min-height: 360rpx; }
.hero-l { flex: 1; min-width: 0; padding-top: 8rpx; position: relative; z-index: 1; }
.k { font-size: 26rpx; color: var(--ink2); }
.cd { margin-top: 12rpx; white-space: nowrap; }
.cd-n { font-family: Georgia, serif; font-size: 88rpx; line-height: 1.1; }
.cd-u { font-size: 28rpx; color: var(--ink2); }
.rule { font-size: 28rpx; margin-top: 8rpx; }
.tries { display: flex; flex-wrap: wrap; align-items: center; gap: 12rpx 16rpx; margin-top: 16rpx; }
.tr-bars { display: flex; gap: 8rpx; }
.tr { width: 40rpx; height: 12rpx; border-radius: 6rpx; background: rgba(243,234,214,.16); }
.tr.on { background: var(--star); }
.tr-t { font-size: 26rpx; color: var(--ink2); }
.tr-b { color: var(--star); font-family: Georgia, serif; font-size: 30rpx; }
.bird { position: absolute; right: -24rpx; top: 0; width: 280rpx; height: 300rpx; }
.acts { display: flex; gap: 20rpx; margin-top: 16rpx; }
.a1 { flex: 1.3; } .a2 { flex: 1; padding: 0 16rpx; }
.pk { margin-top: 24rpx; }
.lvs { margin: 20rpx 0 24rpx; }
.lv { min-height: 88rpx; line-height: 64rpx; box-sizing: border-box; }
.bh { margin-top: 48rpx; margin-bottom: 8rpx; flex-wrap: wrap; }
.tabs { display: flex; gap: 8rpx; }
.tb { min-height: 88rpx; line-height: 88rpx; padding: 0 14rpx; font-size: 28rpx; color: var(--ink2); border-bottom: 4rpx solid transparent; box-sizing: border-box; }
.tb.on { color: var(--star); border-bottom-color: var(--star); }
.board { border-top: 2rpx solid var(--hair); }
.br { display: flex; align-items: center; gap: 20rpx; padding: 0 16rpx; min-height: 92rpx; border-bottom: 2rpx solid var(--hair); }
.br-p { width: 56rpx; flex: none; color: var(--ink2); font-family: Georgia, serif; font-size: 28rpx; }
.br-n { flex: 1; min-width: 0; font-size: 30rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.br-s { flex: none; font-family: Georgia, serif; font-size: 32rpx; }
.br.me { background: var(--star); color: var(--dark-ink); border-radius: 12rpx; border-bottom-color: transparent; font-weight: 700; }
.br.me .br-p { color: var(--dark-ink); }
.gap { text-align: center; color: var(--ink2); line-height: 48rpx; letter-spacing: 6rpx; }
.note { padding: 28rpx 0; }
.more-r { text-align: right; color: var(--ink2); font-size: 26rpx; padding: 24rpx 0; min-height: 88rpx; box-sizing: border-box; }
.t { font-weight: 700; }
.score { font-size: 40rpx; font-family: Georgia, serif; flex-shrink: 0; }
.hover-row { opacity: .7; }
