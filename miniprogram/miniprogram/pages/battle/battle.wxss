/* 对战：倒计时 + 一个主按钮；下面是周榜（带头像）和最近的 PK。星光只给「我」那一行 */
.bt-hero { position: relative; display: flex; align-items: flex-end; min-height: 280rpx; }
.bt-hero-l { flex: 1; min-width: 0; position: relative; z-index: 1; }
.bt-cd { white-space: nowrap; margin: var(--s1) 0; }
.bt-u { font-size: var(--t-body); color: var(--ink2); }
.bt-bird { flex: none; width: 264rpx; height: 272rpx; margin-right: -16rpx; }
.bt-acts { display: flex; gap: var(--s2); margin-top: var(--s4); }
.bt-acts .btn { min-width: 0; padding: 0 var(--s3); }
.bt-a1 { flex: 1.2; }
.bt-a2 { flex: 1; }
.bt-sel { display: flex; align-items: center; justify-content: space-between; min-height: 88rpx; font-size: var(--t-caption); color: var(--ink2); }
.bt-sel-x { color: var(--ivory); }
.bt-more { display: flex; align-items: center; min-height: 88rpx; margin: -28rpx 0; padding-left: var(--s4); }
.bt-note { padding: var(--s4) 0; }

.bt-podium { display: flex; align-items: flex-end; gap: var(--s2); padding: var(--s4) 0 var(--s3); border-bottom: 2rpx solid var(--hair); }
.bt-pd { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; }
.bt-pd-k { font-family: var(--f-ms); font-size: 28rpx; color: var(--ink2); line-height: 1.2; margin-bottom: var(--s1); }
.bt-pd-av { width: 96rpx; height: 96rpx; border-radius: 50%; background: var(--ivory); }
.bt-p1 .bt-pd-av { width: 128rpx; height: 128rpx; }
.bt-p1 .bt-pd-k { color: var(--ivory); font-size: var(--t-section); }
.bt-mark { display: flex; align-items: center; justify-content: center; font-family: var(--f-zh); font-size: 40rpx; font-weight: 700; color: var(--dark-ink); }
.bt-mark.sm { font-size: 30rpx; }
.bt-pd-n { margin-top: var(--s2); font-size: 26rpx; font-weight: 600; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.bt-pd-s { font-size: var(--t-caption); color: var(--ink2); }
