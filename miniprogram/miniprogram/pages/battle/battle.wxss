/* 对战：倒计时 + 一个主按钮；下面是周榜（带头像）和最近的 PK。星光只给「我」那一行 */
.bt-hero { padding: var(--s3); border-radius: var(--r-lg); background: var(--panel); }
.bt-top { display: flex; align-items: center; gap: var(--s2); }
.bt-bird { flex: none; width: 150rpx; height: 156rpx; margin: -12rpx 0 -12rpx -8rpx; }
.bt-hero-l { flex: 1; min-width: 0; }
.bt-k { font-size: var(--t-caption); color: var(--ink2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.bt-hl { color: var(--star); font-weight: 700; }
.bt-cd { display: flex; align-items: baseline; gap: 6rpx; margin: 4rpx 0; white-space: nowrap; }
.bt-num { font-family: var(--f-ms); font-size: 64rpx; font-weight: 700; line-height: 1.1; color: var(--strong); }
.bt-u { font-size: 26rpx; color: var(--ink2); margin-right: 10rpx; }
.bt-acts { display: flex; gap: var(--s2); margin-top: var(--s3); }
.bt-acts .btn { min-width: 0; padding: 0 var(--s3); height: 84rpx; line-height: 84rpx; font-size: 28rpx; }
.bt-a1 { flex: 1.2; }
.bt-a2 { flex: 1; }
.bt-more { display: flex; align-items: center; min-height: 88rpx; margin: -28rpx 0; padding-left: var(--s4); }
.bt-note { padding: var(--s4) 0; }

.bt-podium { display: flex; align-items: flex-end; gap: var(--s2); padding: var(--s2) 0 var(--s2); border-bottom: 2rpx solid var(--hair); }
.bt-pd { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; }
.bt-pd-k { font-family: var(--f-ms); font-size: 28rpx; color: var(--ink2); line-height: 1.2; margin-bottom: var(--s1); }
.bt-pd-av { width: 80rpx; height: 80rpx; border-radius: 50%; background: var(--photo); box-sizing: border-box; }
.bt-pd.mine .bt-pd-av { border: 4rpx solid var(--star); }
.bt-pd.mine .bt-pd-n { color: var(--star); }
.bt-p1 .bt-pd-av { width: 104rpx; height: 104rpx; }
.bt-p1 .bt-pd-k { color: var(--strong); font-size: var(--t-section); }
.bt-mark { display: flex; align-items: center; justify-content: center; font-family: var(--f-zh); font-size: 40rpx; font-weight: 700; color: var(--dark-ink); }
.bt-mark.sm { font-size: 30rpx; }
.bt-pd-n { margin-top: var(--s1); font-size: 26rpx; font-weight: 600; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.bt-pd-s { font-size: var(--t-caption); color: var(--ink2); }

/* 选站弹层（自定义，深色，和整体一致） */
.bt-mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 300; background: rgba(5,16,18,0); transition: background-color .24s; }
.bt-mask.on { background: var(--scrim); }
.bt-sheet { position: absolute; left: 0; right: 0; bottom: 0; padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom)); border-radius: 36rpx 36rpx 0 0; background: var(--sheet); box-shadow: var(--raise-sh); border-top: 2rpx solid var(--hair); transform: translateY(100%); transition: transform .26s cubic-bezier(.3,1.2,.5,1); }
.bt-sheet.on { transform: none; }
.bt-sh-h { display: flex; align-items: center; justify-content: space-between; }
.bt-sh-t { font-size: 34rpx; font-weight: 800; color: var(--strong); }
.bt-sh-x { font-size: 26rpx; color: var(--ink2); padding: 16rpx 0 16rpx 32rpx; }
.bt-sh-d { font-size: 24rpx; color: var(--ink2); margin: 4rpx 0 24rpx; }
.bt-st-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16rpx; }
.bt-st { padding: 20rpx 12rpx; border-radius: 24rpx; border: 2rpx solid var(--hair2); text-align: center; }
.bt-st.hover { background: var(--wash); }
.bt-st.cur { border-color: var(--star); background: var(--star-l); }
.bt-st-n { font-family: Georgia, serif; font-size: 40rpx; font-weight: 700; color: var(--star); line-height: 1.1; }
.bt-st-c { font-size: 28rpx; font-weight: 700; color: var(--strong); margin-top: 4rpx; }
.bt-st-p { font-size: 20rpx; color: var(--ink2); margin-top: 2rpx; }

/* 一屏看完：小节间距收紧 */
.bt-page { padding-top: var(--s2); }
.bt-page .sec { margin: var(--s3) 0 var(--s1); }
.bt-page .bt-note { padding: var(--s2) 0; }
.bt-page .rk.me { min-height: 88rpx; padding-top: var(--s1); padding-bottom: var(--s1); margin-top: var(--s2); }
.bt-page .rk.me .rk-av { width: 64rpx; height: 64rpx; }

/* ================= 白天「旅行手账」排版（A5 对战）：只在 th.day 时出现，类名 dA-bt- 开头 ================= */
.dA-bt { margin: 0 8rpx; }
.dA-bt-arena { position: relative; overflow: hidden; margin-top: 20rpx; padding: 32rpx; border-radius: 28rpx; background: var(--tl); color: #f7f2e8; }
.dA-bt-bird { position: absolute; right: -12rpx; top: 12rpx; width: 224rpx; height: 224rpx; }
.dA-bt-k { font-size: 24rpx; letter-spacing: .1em; opacity: .82; padding-right: 200rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.dA-bt-h { font-family: var(--serif); font-size: 52rpx; line-height: 1.2; font-weight: 700; margin-top: 8rpx; padding-right: 200rpx; }
.dA-bt-p { font-size: 26rpx; opacity: .82; margin-top: 8rpx; padding-right: 180rpx; }
.dA-bt-kv { display: flex; margin: 24rpx 0 28rpx; }
.dA-bt-kvi { min-width: 0; margin-right: 44rpx; display: flex; flex-direction: column; }
.dA-bt-kvn { font-family: var(--latin); font-size: 48rpx; line-height: 1.2; }
.dA-bt-kvl { font-size: 24rpx; opacity: .75; white-space: nowrap; }
.dA-bt-go { background: #f7f2e8; color: var(--tl); }
.dA-bt-pk { display: flex; align-items: center; padding: 28rpx 0; border-bottom: 2rpx solid var(--ln); }
.dA-bt-pk-m { flex: 1; min-width: 0; margin-right: 24rpx; }
.dA-bt-pk-t { font-family: var(--serif); font-size: 36rpx; font-weight: 700; }
.dA-bt-pk-d { font-size: 26rpx; color: var(--mu); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.dA-bt-pk-b { flex: none; width: 192rpx; height: 88rpx; font-size: 30rpx; background: var(--am); }
.dA-bt-last { padding: 20rpx 0; }
.dA-bt-last-m { flex: 1; min-width: 0; font-size: 26rpx; color: var(--ik2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.dA-bt-sc { font-family: var(--latin); font-size: 32rpx; font-weight: 700; color: var(--ik); }
.dA-bt-all { flex: none; margin-left: 20rpx; font-size: 26rpx; color: var(--mu); }
.dA-bt-sec { align-items: center; margin-top: 28rpx; }
.dA-bt-sec .dA-seg { flex: none; margin-left: 16rpx; }
.dA-bt-lbw { border-top: 3rpx solid var(--ik); }
.dA-bt-lb { display: flex; align-items: center; height: 88rpx; border-bottom: 2rpx solid var(--ln); font-size: 30rpx; }
.dA-bt-rk { flex: none; width: 64rpx; font-family: var(--latin); font-size: 36rpx; color: var(--mu); }
.dA-bt-rk.top { color: var(--am); font-weight: 700; }
.dA-bt-nm { flex: 1; min-width: 0; margin-right: 20rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.dA-bt-pt { flex: none; font-family: var(--latin); }
.dA-bt-lb.me { background: var(--am-l); margin: 0 -40rpx; padding: 0 40rpx; border-bottom: 0; font-weight: 700; }
.dA-bt-gap { text-align: center; color: var(--mu); font-size: 26rpx; line-height: 48rpx; border-bottom: 2rpx solid var(--ln); }
.dA-bt-note { padding: 28rpx 0; font-size: 26rpx; color: var(--mu); }
.dA-bt-more { padding: 24rpx 0; text-align: right; font-size: 26rpx; color: var(--mu); }
