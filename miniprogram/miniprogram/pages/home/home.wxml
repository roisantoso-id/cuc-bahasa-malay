<view class="wrap">
  <hb-empty wx:if="{{loading}}" image="loading" title="正在加载…" />
  <hb-empty wx:elif="{{error}}" image="empty" title="加载失败，请重试。"><button class="btn btn-main" hover-class="hover" bindtap="load">重新加载</button></hb-empty>
  <block wx:else>
    <view class="top">
      <view>
        <view class="hello">{{hello}}, {{student.name}}!</view>
        <view class="credit" bindtap="about">张静灵老师主持编写 ›</view>
      </view>
    </view>

    <view class="today">
      <view class="ring" style="background: conic-gradient(#2fae66 {{ring * 3.6}}deg, #e8e8e2 0deg)">
        <view class="ring-in"><view class="ring-n">{{ov.learnedToday}}</view><view class="ring-t">/ {{goal}} 新词</view></view>
      </view>
      <view class="today-r">
        <view class="t-row"><text class="t-k">待复习</text><text class="t-v due">{{ov.dueTotal}}</text></view>
        <view class="t-row"><text class="t-k">累计学会</text><text class="t-v">{{ov.learnedTotal}}</text></view>
      </view>
    </view>
    <button wx:if="{{ov.dueTotal}}" class="btn btn-main" hover-class="hover" bindtap="review">复习 {{ov.dueTotal}} 个词</button>
    <button wx:elif="{{next}}" class="btn btn-main" hover-class="hover" bindtap="cont">继续学「{{next.name}}」</button>
    <view wx:else class="done-all">所有场景都学完了，明天再来复习。</view>

    <view class="h2">生活场景</view>
    <view class="grid">
      <view wx:for="{{ov.scenes}}" wx:key="_id" class="scene" hover-class="hover" data-id="{{item._id}}" bindtap="open">
        <image class="cover" src="{{item.img}}" mode="aspectFill" lazy-load />
        <view class="s-name">{{item.name}}</view>
        <view class="s-ms">{{item.name_ms}}</view>
        <view class="bar"><view class="bar-in" style="width:{{item.pct}}%" /></view>
        <view class="s-meta"><text>{{item.learned}} / {{item.total}}</text><text wx:if="{{item.due}}" class="s-due">{{item.due}} 待复习</text></view>
      </view>
    </view>
  </block>
</view>
