<view class="wrap">
  <hb-empty wx:if="{{loading}}" image="loading" title="正在加载…" />
  <hb-empty wx:elif="{{error}}" image="empty" title="学习安排加载失败，请重试。">
    <button class="btn btn-main" hover-class="hover" bindtap="load">重新加载</button>
  </hb-empty>
  <block wx:else>
    <view class="between">
      <view>
        <view class="hello">{{hello}}</view>
        <view class="muted small">今天也学十分钟吧</view>
      </view>
      <view class="streak" wx:if="{{cal}}">
        <text class="flame">●</text> {{cal.currentStreak}} 天
      </view>
    </view>

    <view class="goal">
      <image class="goal-img" src="/assets/{{allDone ? 'cheer' : 'study'}}.jpg" mode="aspectFit" />
      <view class="goal-txt">
        <block wx:if="{{allDone}}">
          <view class="goal-t">都学完啦</view>
          <view class="goal-d">当前学习已完成，没有到期复习或待学新词。</view>
        </block>
        <block wx:elif="{{review.dueCount}}">
          <view class="goal-t">{{review.dueCount}} 个词等你复习</view>
          <view class="goal-d">先完成到期复习，再学习新词</view>
        </block>
        <block wx:else>
          <view class="goal-t">今天的复习完成了</view>
          <view class="goal-d">去学几个新词吧</view>
        </block>
      </view>
    </view>
    <button wx:if="{{!allDone}}" class="btn btn-main" hover-class="hover" style="margin-top:28rpx" bindtap="study">{{hasActive ? '继续学习' : '开始学习'}}</button>

    <view class="stats">
      <view class="stat"><view class="n" style="color:var(--blue)">{{review.dueCount}}</view><view class="muted small">待复习</view></view>
      <view class="stat"><view class="n" style="color:var(--green)">{{learning.todayLearnedCount}}</view><view class="muted small">今日已学习</view></view>
      <view class="stat"><view class="n">{{learning.totalLearnedCount}}</view><view class="muted small">累计学习</view></view>
    </view>

    <view class="h2">学习打卡</view>
    <view class="card">
      <view class="muted small" style="margin-bottom:12rpx">完成当天新词学习即可打卡。</view>
      <calendar year="{{year}}" month="{{month}}" dates="{{calDates}}" bind:change="changeMonth" />
      <view class="cal-foot" wx:if="{{cal}}">
        <view><text class="b">{{cal.currentStreak}}</text> 当前连续</view>
        <view><text class="b">{{cal.longestStreak}}</text> 最长连续</view>
        <view><text class="b">{{cal.totalCheckInDays}}</text> 累计打卡</view>
      </view>
    </view>

    <view class="h2 between"><text>今日回顾</text><text class="muted small">共 {{todayTotal}} 条</text></view>
    <view wx:if="{{!today.length}}" class="card muted center">今天还没有学习记录。</view>
    <view wx:else class="card list">
      <view wx:for="{{today}}" wx:key="wordId" class="item">
        <view class="item-main">
          <view class="row"><text class="ms word">{{item.headword}}</text><text class="tag {{item.activityType === 'Review' ? 'blue' : ''}}">{{item.activityType === 'Review' ? '今日复习' : '今日新学'}}</text></view>
          <view class="muted small">{{item.first.posLabel}} {{item.first.definition}}</view>
        </view>
        <audio-btn audio-id="{{item.audioResourceId}}" />
      </view>
    </view>
  </block>
</view>
