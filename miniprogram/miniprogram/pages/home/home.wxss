/* 今日：一个数字、一个按钮。星光只给圆环的进度 */
.hm-date { font-size: var(--t-caption); color: var(--ink2); margin-bottom: var(--s1); }
.hm-hero { position: relative; height: 416rpx; margin-top: var(--s3); }
.hm-ring-box { position: relative; width: 384rpx; height: 384rpx; }
.hm-ring { width: 384rpx; height: 384rpx; }
.hm-ring-in { position: absolute; left: 0; top: 0; width: 384rpx; height: 384rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; }
/* 全站唯一比 --t-display 还大的字：首页圆环里的数 */
.hm-big { font-family: var(--f-ms); font-size: 128rpx; line-height: 1.1; }
.hm-lab { font-size: var(--t-caption); color: var(--ink2); }
.hm-bird { position: absolute; right: -24rpx; bottom: 0; width: 320rpx; height: 416rpx; }
.hm-cta { margin: var(--s4) 0 var(--s3); }
.hm-list { border-top: 0; }
.hm-dots { width: 72rpx; height: 72rpx; border-radius: 50%; flex: none; border: 2rpx solid var(--hair2); box-sizing: border-box; background: radial-gradient(circle at 30% 35%, var(--ivory) 0 4rpx, transparent 5rpx), radial-gradient(circle at 62% 28%, var(--ivory) 0 3rpx, transparent 4rpx), radial-gradient(circle at 70% 66%, var(--ivory) 0 5rpx, transparent 6rpx), radial-gradient(circle at 35% 72%, var(--ink3) 0 3rpx, transparent 4rpx); }
.hm-star { font-family: var(--f-ms); font-size: 36rpx; }
.hm-say { width: 72rpx; height: 72rpx; border-radius: 50%; flex: none; display: flex; align-items: center; justify-content: center; border: 2rpx solid var(--hair2); box-sizing: border-box; }
.hm-cone { width: 0; height: 0; border-top: 12rpx solid transparent; border-bottom: 12rpx solid transparent; border-right: 16rpx solid var(--ivory); margin-right: 4rpx; }
.hm-wave { width: 14rpx; height: 24rpx; border: 4rpx solid var(--ivory); border-left: 0; border-radius: 0 24rpx 24rpx 0; }
.hm-w1 { display: flex; align-items: baseline; gap: var(--s2); }
.hm-wms { font-size: 36rpx; }

/* 解锁新成就弹窗 */
.hm-ul-mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 300; background: rgba(5,16,18,.72); display: flex; align-items: center; justify-content: center; }
.hm-ul { width: 82vw; padding: 40rpx 36rpx 24rpx; border-radius: 36rpx; background: var(--ivory); color: var(--dark-ink); text-align: center; animation: ulin .4s cubic-bezier(.3,1.4,.5,1); }
@keyframes ulin { from { transform: scale(.6); opacity: 0; } to { transform: scale(1); opacity: 1; } }
.hm-ul-k { font-size: 24rpx; letter-spacing: 6rpx; color: #b07a1c; font-weight: 700; }
.hm-ul-imgw { position: relative; width: 320rpx; height: 320rpx; margin: 20rpx auto 12rpx; }
.hm-ul-img { width: 320rpx; height: 320rpx; border-radius: 32rpx; }
.hm-ul-img.round { border-radius: 50%; }
.hm-ul-t { font-size: 38rpx; font-weight: 800; }
.hm-ul-d { font-size: 24rpx; color: rgba(10,31,34,.6); margin: 8rpx 0 28rpx; }
.hm-ul .btn-text { color: rgba(10,31,34,.6); margin-top: 8rpx; }
