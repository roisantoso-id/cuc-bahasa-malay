.hello { margin: 8rpx 0 28rpx; }
.hi { color: var(--green); font-size: 28rpx; }
/* 连续天数：立体小方块，打卡后变琥珀色 */
.streak { width: 132rpx; height: 132rpx; border-radius: 34rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; background: linear-gradient(180deg, #fff, var(--card2)); box-shadow: inset 0 3rpx 0 #fff, 0 8rpx 0 var(--edge), 0 16rpx 24rpx -12rpx rgba(90,70,30,.35); }
.streak.on { background: linear-gradient(180deg, var(--amber-hi), var(--amber)); color: #4a2a08; box-shadow: inset 0 4rpx 0 rgba(255,255,255,.4), 0 8rpx 0 var(--amber-d), 0 16rpx 24rpx -10rpx rgba(176,106,34,.5); }
.streak-n { font-size: 50rpx; font-weight: 900; line-height: 1.1; }
.streak-t { font-size: 20rpx; opacity: .75; }

/* 3D 地图 */
.map { position: relative; height: 520rpx; border-radius: 40rpx; overflow: hidden; margin-bottom: 44rpx; }
.map-c { width: 100%; height: 100%; display: block; }
.map-bird { position: absolute; right: 16rpx; bottom: 0; width: 300rpx; height: 300rpx; border-radius: 30rpx; }
.map-tag { position: absolute; left: 28rpx; top: 26rpx; width: 330rpx; padding: 20rpx 24rpx; border-radius: 28rpx; background: rgba(10,42,46,.72); }
.map-k { font-size: 20rpx; color: var(--amber-hi); }
.map-city { font-size: 32rpx; font-weight: 900; margin: 6rpx 0 12rpx; color: #fff; }
.map-city .ms { font-size: 34rpx; }
.map-bar { height: 16rpx; background: rgba(255,255,255,.15); box-shadow: none; }
.map-sub { font-size: 20rpx; color: rgba(244,237,224,.7); margin-top: 10rpx; }

.t-top { padding: 26rpx 30rpx 8rpx; }
.t-k { font-size: 20rpx; color: var(--ink2); }
.t-nums { display: flex; gap: 18rpx; padding: 18rpx 28rpx 34rpx; }
.t-nums .tile { flex: 1; }
.of { font-size: 26rpx; color: var(--ink2); }
.t-bot { padding: 30rpx 28rpx 34rpx; }
.done-t { text-align: center; font-weight: 800; color: var(--green); margin-bottom: 24rpx; }

.quick { display: flex; gap: 18rpx; margin-top: 44rpx; }
.quick .tile { flex: 1; }

.vs { display: flex; align-items: center; gap: 22rpx; margin-top: 44rpx; padding: 22rpx 28rpx; }
.vs-bird { width: 104rpx; height: 104rpx; border-radius: 28rpx; flex-shrink: 0; }
.vs-t { font-size: 32rpx; font-weight: 900; }
.arrow { font-size: 40rpx; }

.route-h { margin-top: 20rpx; }
/* 路线：中间一条凹槽，站点是凸起的圆币，左右交错 */
.route { position: relative; padding: 8rpx 0 24rpx; }
.route::before { content: ''; position: absolute; left: 50%; top: 40rpx; bottom: 60rpx; width: 12rpx; border-radius: 6rpx; background: var(--paper2); box-shadow: inset 0 3rpx 4rpx rgba(90,70,30,.2); transform: translateX(-6rpx); }
.stop { position: relative; display: flex; align-items: center; margin-bottom: 32rpx; }
.stop.r { flex-direction: row-reverse; }
.dot-wrap { width: 132rpx; flex-shrink: 0; display: flex; justify-content: center; position: relative; z-index: 1; }
.stop.l .dot-wrap { margin-left: calc(50% - 66rpx); }
.stop.r .dot-wrap { margin-right: calc(50% - 66rpx); }
.dot { width: 88rpx; height: 88rpx; border-radius: 50%; color: #fff; font-weight: 900; font-size: 32rpx; display: flex; align-items: center; justify-content: center; background: linear-gradient(180deg, var(--green-hi), var(--green)); box-shadow: inset 0 4rpx 0 rgba(255,255,255,.3), 0 8rpx 0 var(--green-d), 0 14rpx 20rpx -8rpx rgba(19,69,49,.45); }
.dot.bird { width: 116rpx; height: 116rpx; background: #fff; box-shadow: 0 0 0 6rpx var(--amber), 0 10rpx 0 6rpx var(--amber-d); }
.stamp.mini { width: 104rpx; height: 104rpx; }
.stamp.mini .s1 { font-size: 20rpx; }
.info { position: absolute; width: calc(50% - 90rpx); }
.stop.l .info { right: 0; }
.stop.r .info { left: 0; text-align: right; }
.city { font-weight: 900; font-size: 30rpx; }
.bar.thin { height: 14rpx; margin: 10rpx 0 4rpx; }
.stop.lock .dot { background: var(--paper2); color: var(--ink2); box-shadow: inset 0 3rpx 5rpx rgba(90,70,30,.2); }
.stop.lock .city { color: var(--ink2); }
.stop.cur .city { color: var(--green); }
