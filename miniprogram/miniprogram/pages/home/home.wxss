.hello { font-size: 44rpx; font-weight: 700; color: var(--green-d); }
.streak { background: #f6e9e6; color: #8a2f21; font-weight: 700; padding: 10rpx 22rpx; border-radius: 6rpx; font-size: 26rpx; }
.flame { color: var(--coral); }
.goal { display: flex; align-items: center; gap: 16rpx; margin-top: 28rpx; background: var(--blue); color: #fff; border-radius: 8rpx; padding: 20rpx 28rpx 20rpx 12rpx; }
.goal-img { width: 180rpx; height: 180rpx; border-radius: 8rpx; background: #fff; flex: none; }
.goal-t { font-size: 38rpx; font-weight: 700; }
.goal-d { font-size: 26rpx; opacity: .9; }
.stats { display: flex; gap: 20rpx; margin-top: 36rpx; }
.stat { flex: 1; background: #fff; border: 2rpx solid var(--line); border-radius: 8rpx; padding: 18rpx 0; text-align: center; }
.n { font-size: 44rpx; font-weight: 700; line-height: 1.2; }
.cal-foot { display: flex; justify-content: space-between; margin-top: 20rpx; padding-top: 16rpx; border-top: 2rpx solid var(--line); font-size: 24rpx; color: var(--ink2); }
.b { font-size: 34rpx; font-weight: 700; color: var(--ink); margin-right: 6rpx; }
.word { font-size: 36rpx; }
.credit { display: inline-flex; align-items: center; gap: 10rpx; font-size: 22rpx; color: #5d646c; margin-bottom: 16rpx; }
.credit .mark { background: #14213d; color: #e3b04b; font-weight: 700; font-size: 20rpx; padding: 4rpx 10rpx; border-radius: 8rpx; }
