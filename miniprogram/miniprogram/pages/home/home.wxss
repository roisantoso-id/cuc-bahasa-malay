/* 今日：一个数字、一个按钮。星光只给圆环的进度 */
.hm-date { font-size: var(--t-caption); color: var(--ink2); margin-bottom: var(--s1); }
.hm-hero { position: relative; height: 416rpx; margin-top: var(--s3); }
.hm-ring-box { position: relative; width: 384rpx; height: 384rpx; }
.hm-ring { width: 384rpx; height: 384rpx; }
.hm-ring-in { position: absolute; left: 0; top: 0; width: 384rpx; height: 384rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; }
/* 全站唯一比 --t-display 还大的字：首页圆环里的数 */
.hm-big { font-family: var(--f-ms); font-size: 128rpx; line-height: 1.1; }
.hm-lab { font-size: var(--t-caption); color: var(--ink2); }
.hm-bird { position: absolute; right: -24rpx; bottom: 0; width: 320rpx; height: 416rpx; }
.hm-cta { margin: var(--s4) 0 var(--s3); }
.hm-list { border-top: 0; }
.hm-dots { width: 72rpx; height: 72rpx; border-radius: 50%; flex: none; border: 2rpx solid var(--hair2); box-sizing: border-box; background: radial-gradient(circle at 30% 35%, var(--strong) 0 4rpx, transparent 5rpx), radial-gradient(circle at 62% 28%, var(--strong) 0 3rpx, transparent 4rpx), radial-gradient(circle at 70% 66%, var(--strong) 0 5rpx, transparent 6rpx), radial-gradient(circle at 35% 72%, var(--ink3) 0 3rpx, transparent 4rpx); }
.hm-star { font-family: var(--f-ms); font-size: 36rpx; }
.hm-say { width: 72rpx; height: 72rpx; border-radius: 50%; flex: none; display: flex; align-items: center; justify-content: center; border: 2rpx solid var(--hair2); box-sizing: border-box; }
.hm-cone { width: 0; height: 0; border-top: 12rpx solid transparent; border-bottom: 12rpx solid transparent; border-right: 16rpx solid var(--strong); margin-right: 4rpx; }
.hm-wave { width: 14rpx; height: 24rpx; border: 4rpx solid var(--strong); border-left: 0; border-radius: 0 24rpx 24rpx 0; }
.hm-w1 { display: flex; align-items: baseline; gap: var(--s2); }
.hm-wms { font-size: 36rpx; }
/* 推荐难度：一个圆里写档位数字 */
.hm-lvl { flex: none; width: 64rpx; height: 64rpx; line-height: 60rpx; text-align: center; border-radius: 50%; border: 2rpx solid var(--star); color: var(--star); font-family: var(--f-ms); font-size: 30rpx; box-sizing: border-box; }

/* 解锁新成就弹窗 */
.hm-ul-mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 300; background: var(--scrim); display: flex; align-items: center; justify-content: center; }
.hm-ul { width: 82vw; padding: 40rpx 36rpx 24rpx; border-radius: 36rpx; background: var(--raise); box-shadow: var(--raise-sh); color: var(--dark-ink); text-align: center; animation: ulin .4s cubic-bezier(.3,1.4,.5,1); }
@keyframes ulin { from { transform: scale(.6); opacity: 0; } to { transform: scale(1); opacity: 1; } }
.hm-ul-k { font-size: 24rpx; letter-spacing: 6rpx; color: var(--star-d); font-weight: 700; }
.hm-ul-imgw { position: relative; width: 320rpx; height: 320rpx; margin: 20rpx auto 12rpx; }
.hm-ul-img { width: 320rpx; height: 320rpx; border-radius: 32rpx; }
.hm-ul-img.round { border-radius: 50%; }
.hm-ul-t { font-size: 38rpx; font-weight: 800; }
.hm-ul-d { font-size: 24rpx; color: var(--dark-ink2); margin: 8rpx 0 28rpx; }
.hm-ul .btn-text { color: var(--dark-ink2); margin-top: 8rpx; }

/* ================= 白天「旅行手账」首页（design/mp-v2 方向 A · A1）：尺寸 = 设计稿 px × 2 ================= */
.dA-hm-greet { display: flex; justify-content: space-between; align-items: flex-end; }
.dA-hm-greet-t { flex: 1; min-width: 0; margin-right: 24rpx; word-break: break-all; }
.dA-hm-av { flex: none; width: 124rpx; height: 124rpx; border-radius: 50%; border: 3rpx solid var(--ik); box-sizing: border-box; background: var(--pa2); }
/* 车票 */
.dA-hm-tk { position: relative; margin-top: 28rpx; }
.dA-hm-tk-top { background: var(--tl); color: #f7f2e8; border-radius: 25rpx 25rpx 0 0; padding: 24rpx 32rpx 32rpx; }
.dA-hm-tk-r { display: flex; justify-content: space-between; font-family: var(--mono); font-size: 24rpx; letter-spacing: .08em; opacity: .8; }
.dA-hm-tk-od { display: flex; align-items: center; margin-top: 20rpx; }
.dA-hm-tk-n { flex: none; max-width: 40%; }
.dA-hm-tk-rt { text-align: right; }
.dA-hm-tk-b { font-family: var(--serif); font-size: 68rpx; line-height: 1.1; font-weight: 700; }
.dA-hm-tk-s { font-size: 26rpx; opacity: .8; white-space: nowrap; }
.dA-hm-tk-ln { flex: 1; min-width: 40rpx; margin: 0 24rpx; border-top: 3rpx dashed rgba(247,242,232,.5); position: relative; height: 0; }
.dA-hm-tk-dot { position: absolute; left: 50%; top: -24rpx; margin-left: -22rpx; width: 44rpx; height: 44rpx; border-radius: 50%; background: var(--am); border: 4rpx solid var(--tl); box-sizing: border-box; }
.dA-hm-tk-meta { display: flex; padding: 24rpx 32rpx; }
.dA-hm-tk-m { flex: 1; min-width: 0; font-size: 24rpx; color: var(--mu); }
.dA-hm-tk-m + .dA-hm-tk-m { margin-left: 16rpx; }
.dA-hm-tk-mb { font-size: 30rpx; color: var(--ik); font-family: var(--serif); font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.dA-hm-tk-mb.dA-latin { font-family: var(--latin); font-weight: 400; }
/* 撕票线：两头的半圆缺口 = 纸色圆（墨线）+ 外侧一块纸色盖住另一半 */
.dA-hm-tk-cut { position: relative; margin: 0 24rpx; border-top: 3rpx dashed var(--ln); height: 0; }
.dA-hm-tk-nt { position: absolute; top: -19rpx; width: 32rpx; height: 32rpx; border-radius: 50%; background: var(--night, var(--pa)); border: 3rpx solid var(--ik); box-sizing: border-box; }
.dA-hm-tk-nt.l { left: -42rpx; }
.dA-hm-tk-nt.r { right: -42rpx; }
.dA-hm-tk-nt.l::after, .dA-hm-tk-nt.r::after { content: ''; position: absolute; top: -6rpx; width: 20rpx; height: 40rpx; background: var(--night, var(--pa)); }
.dA-hm-tk-nt.l::after { left: -6rpx; }
.dA-hm-tk-nt.r::after { right: -6rpx; }
.dA-hm-tk-go { padding: 28rpx 32rpx 32rpx; }
/* 这一周 */
.dA-hm-wk { display: flex; margin-top: 24rpx; }
.dA-hm-wd { flex: 1; min-width: 0; text-align: center; font-size: 22rpx; color: var(--mu); white-space: nowrap; }
.dA-hm-wd + .dA-hm-wd { margin-left: 12rpx; }
.dA-hm-wi { height: 12rpx; border-radius: 6rpx; background: var(--pa2); margin-bottom: 8rpx; }
.dA-hm-wd.on .dA-hm-wi { background: var(--gr); }
.dA-hm-wd.now .dA-hm-wi { background: var(--am); }
.dA-hm-wd.now { color: var(--ik); }
/* 路线 */
.dA-hm-st { display: flex; align-items: center; min-height: 112rpx; padding: 12rpx 0; box-sizing: border-box; }
.dA-hm-st + .dA-hm-st { border-top: 2rpx solid var(--ln); }
.dA-hm-no { flex: none; width: 44rpx; font-size: 26rpx; color: var(--mu); margin-right: 24rpx; }
.dA-hm-nm { flex: 1; min-width: 0; margin-right: 24rpx; }
.dA-hm-nm-r { display: flex; align-items: baseline; min-width: 0; }
.dA-hm-city { flex: 0 1 auto; min-width: 0; font-family: var(--serif); font-size: 34rpx; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.dA-hm-rg { flex: none; font-size: 24rpx; color: var(--mu); margin-left: 12rpx; font-family: var(--latin); white-space: nowrap; }
.dA-hm-bar { height: 8rpx; border-radius: 4rpx; background: var(--pa2); margin-top: 10rpx; overflow: hidden; }
.dA-hm-bar-in { height: 100%; background: var(--gr); }
.dA-hm-rt { flex: none; font-size: 26rpx; color: var(--mu); text-align: right; white-space: nowrap; }
.dA-hm-rt-n { color: var(--ik); font-weight: 700; }
