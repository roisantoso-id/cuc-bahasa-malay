.hello { margin: 8rpx 0 28rpx; }
.hi { color: var(--green-d); font-size: 28rpx; }
.streak { width: 128rpx; height: 128rpx; border-radius: 32rpx; background: #fff; border: 4rpx solid var(--line); display: flex; flex-direction: column; align-items: center; justify-content: center; }
.streak.on { border-color: var(--yellow); background: #fff8e1; }
.streak-n { font-size: 48rpx; font-weight: 900; line-height: 1.1; }
.streak-t { font-size: 20rpx; color: var(--ink2); }

.t-top { padding: 24rpx 28rpx 28rpx; }
.t-k { font-size: 20rpx; color: var(--ink2); }
.t-route { display: flex; align-items: center; justify-content: space-between; margin-top: 16rpx; }
.t-ms { font-size: 52rpx; font-weight: 900; line-height: 1.15; }
.t-bird { width: 120rpx; height: 120rpx; border-radius: 50%; border: 4rpx solid var(--line); }
.t-bot { padding: 28rpx; }
.t-nums { display: flex; margin-bottom: 28rpx; }
.t-nums > view { flex: 1; text-align: center; }
.n { font-size: 52rpx; font-weight: 900; line-height: 1.2; }
.of { font-size: 26rpx; color: var(--ink2); }
.done-t { text-align: center; font-weight: 800; color: var(--green-d); margin-bottom: 20rpx; }
.c-blue { color: var(--blue); } .c-green { color: var(--green); } .c-coral { color: var(--coral); } .c-yellow { color: #e0a800; }

.quick { display: flex; gap: 16rpx; margin-top: 36rpx; }
.q { flex: 1; background: #fff; border: 4rpx solid var(--line); border-radius: 24rpx; box-shadow: 0 6rpx 0 var(--line); text-align: center; padding: 18rpx 0; }
.q.hover { transform: translateY(6rpx); box-shadow: none; }
.q-n, .q-i { font-size: 40rpx; font-weight: 900; line-height: 1.3; }
.q-i { color: var(--blue); }

.route-h { margin-top: 20rpx; }
/* 路线:中间一条虚线,站点左右交错 */
.route { position: relative; padding: 8rpx 0 24rpx; }
.route::before { content: ''; position: absolute; left: 50%; top: 40rpx; bottom: 60rpx; border-left: 6rpx dashed var(--line); transform: translateX(-3rpx); }
.stop { position: relative; display: flex; align-items: center; margin-bottom: 28rpx; }
.stop.r { flex-direction: row-reverse; }
.dot-wrap { width: 132rpx; flex-shrink: 0; display: flex; justify-content: center; position: relative; z-index: 1; }
.stop.l .dot-wrap { margin-left: calc(50% - 66rpx); }
.stop.r .dot-wrap { margin-right: calc(50% - 66rpx); }
.dot { width: 84rpx; height: 84rpx; border-radius: 50%; background: #fff; border: 6rpx solid var(--green); color: var(--green-d); font-weight: 900; font-size: 32rpx; display: flex; align-items: center; justify-content: center; box-sizing: border-box; }
.dot.bird { width: 112rpx; height: 112rpx; border-color: var(--yellow); }
.stamp.mini { width: 104rpx; height: 104rpx; background: #fff; }
.stamp.mini .s1 { font-size: 20rpx; }
.info { position: absolute; width: calc(50% - 90rpx); }
.stop.l .info { right: 0; }
.stop.r .info { left: 0; text-align: right; }
.city { font-weight: 900; font-size: 30rpx; }
.bar.thin { height: 12rpx; margin: 8rpx 0 2rpx; }
.stop.lock .dot { border-color: var(--line); color: var(--ink2); }
.stop.lock .city { color: var(--ink2); }
.stop.cur .city { color: var(--green-d); }
