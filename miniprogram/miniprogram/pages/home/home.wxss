.hello { font-size: 40rpx; font-weight: 900; color: var(--green-d); }
.credit { font-size: 24rpx; color: var(--ink2); margin-top: 6rpx; }
.today { display: flex; align-items: center; gap: 40rpx; margin: 32rpx 0 28rpx; background: #fff; border: 4rpx solid var(--line); border-radius: 36rpx; padding: 32rpx; box-shadow: 0 6rpx 0 var(--line); }
.ring { width: 200rpx; height: 200rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex: none; }
.ring-in { width: 156rpx; height: 156rpx; border-radius: 50%; background: #fff; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.ring-n { font-size: 56rpx; font-weight: 900; line-height: 1; }
.ring-t { font-size: 20rpx; color: var(--ink2); margin-top: 6rpx; }
.today-r { flex: 1; }
.t-row { display: flex; justify-content: space-between; align-items: baseline; padding: 14rpx 0; border-bottom: 2rpx solid var(--line); }
.t-row:last-child { border-bottom: 0; }
.t-k { color: var(--ink2); font-size: 26rpx; }
.t-v { font-size: 44rpx; font-weight: 900; }
.t-v.due { color: var(--blue); }
.done-all { text-align: center; color: var(--ink2); padding: 24rpx 0; }
.grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24rpx; }
.scene { background: #fff; border: 4rpx solid var(--line); border-radius: 32rpx; padding: 20rpx 20rpx 22rpx; box-shadow: 0 6rpx 0 var(--line); }
.scene.hover { transform: translateY(6rpx); box-shadow: none; }
.cover { width: 100%; height: 220rpx; border-radius: 22rpx; background: var(--bg); }
.s-name { font-size: 32rpx; font-weight: 900; margin-top: 14rpx; }
.s-ms { font-size: 22rpx; color: var(--ink2); margin-bottom: 14rpx; }
.s-meta { display: flex; justify-content: space-between; font-size: 22rpx; color: var(--ink2); margin-top: 10rpx; }
.s-due { color: var(--blue); font-weight: 800; }
