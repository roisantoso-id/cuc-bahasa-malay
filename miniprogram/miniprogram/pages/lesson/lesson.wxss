.tabs { display: flex; border-bottom: 2rpx solid var(--line); background: var(--paper); position: sticky; top: 0; z-index: 10; }
.tab { flex: 1; text-align: center; padding: 24rpx 0; color: var(--ink2); font-weight: 600; }
.tab.on { color: var(--brand); box-shadow: inset 0 -6rpx 0 var(--brand); }
.sent-ms { font-size: 36rpx; font-weight: 600; }
.play { color: var(--brand); font-size: 26rpx; }
.word { font-size: 36rpx; margin-right: 12rpx; }
.zh { text-align: right; max-width: 50%; }
.prompt { font-size: 56rpx; font-weight: 800; margin: 24rpx 0 32rpx; }
.opt { font-size: 34rpx; padding-left: 16rpx; }
.opt.right { background: var(--brand-tint); color: var(--brand); font-weight: 700; }
.opt.wrong { color: var(--bad); text-decoration: line-through; }
.result { font-size: 120rpx; font-weight: 800; color: var(--brand); line-height: 1.2; }
