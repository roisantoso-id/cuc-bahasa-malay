<view class="wrap">
  <hb-empty wx:if="{{view === 'loading'}}" image="loading" title="正在翻护照…" />
  <hb-empty wx:elif="{{view === 'error'}}" image="fail" title="{{error}}"><button class="btn btn-main" hover-class="hover" bindtap="load">再试一次</button></hb-empty>
  <block wx:else>
    <view class="me-who">
      <image class="me-av" src="{{student.avatar || '/assets/avatar.jpg'}}" mode="aspectFill" data-url="/pkg-me/wardrobe/wardrobe" bindtap="go" />
      <view class="item-main">
        <view class="h1 one">{{student.name || '同学'}}</view>
        <view class="muted small one">{{student.school || '学校未填'}}{{student.className ? ' · ' + student.className : ''}} · 已盖 {{stamps}} 个章</view>
      </view>
      <view class="btn btn-ghost btn-sm" hover-class="hover" data-url="/pages/register/register" bindtap="go">{{student.name ? '修改资料' : '完善资料'}}</view>
    </view>

    <view wx:if="{{memory}}">
      <view class="sec"><text class="sec-t">记得多牢</text><text class="sec-x">已开放 {{memory.words}} 词</text></view>
      <view class="me-stack">
        <view class="me-sg me-c1" style="width:{{memory.pStrong}}%" />
        <view class="me-sg me-c2" style="width:{{memory.pOk}}%" />
        <view class="me-sg me-c3" style="width:{{memory.pWeak}}%" />
      </view>
      <view class="me-legend">
        <view class="me-lg"><view class="num">{{memory.strong}}</view><view class="me-lg-l"><text class="me-d me-c1" />牢固</view></view>
        <view class="me-lg"><view class="num">{{memory.ok}}</view><view class="me-lg-l"><text class="me-d me-c2" />熟悉</view></view>
        <view class="me-lg"><view class="num">{{memory.weak}}</view><view class="me-lg-l"><text class="me-d me-c3" />快忘了</view></view>
        <view class="me-lg"><view class="num">{{memory.unseen}}</view><view class="me-lg-l"><text class="me-d me-c4" />没见过</view></view>
      </view>

      <view class="sec"><text class="sec-t">未来 7 天要复习</text><text class="sec-x">{{memory.peakLabel}}</text></view>
      <view class="me-bars">
        <view wx:for="{{next7}}" wx:key="index" class="me-bc">
          <view class="me-bn">{{item.n}}</view>
          <view class="me-bt"><view class="me-bf {{item.today ? 'today' : ''}}" style="height:{{item.h}}%" /></view>
          <view class="me-bl {{item.today ? 'today' : ''}}">{{item.label}}</view>
        </view>
      </view>
    </view>

    <view class="sec"><text class="sec-t">最近 30 天</text><text class="sec-x">连续 {{s.streak}} 天 · 共学 {{s.studyDays}} 天</text></view>
    <view class="me-heat">
      <view wx:for="{{heat}}" wx:key="day" class="me-hc l{{item.lv}}" />
    </view>

    <view class="list me-links">
      <view class="item" hover-class="hover-row" data-url="/pkg-word/book/book?type=wrong" bindtap="go"><view class="item-main">错词本</view><text class="item-x">{{total.wrong}} 个</text><text class="arrow">›</text></view>
      <view class="item" hover-class="hover-row" data-url="/pkg-word/book/book?type=fav" bindtap="go"><view class="item-main">收藏</view><text class="item-x">{{total.fav}} 个</text><text class="arrow">›</text></view>
      <view class="item" data-url="/pkg-me/wardrobe/wardrobe" bindtap="go"><view class="item-main">我的犀鸟 · 换装和徽章</view><text class="arrow">›</text></view>
      <view class="item" hover-class="hover-row" bindtap="goal"><view class="item-main">每天新词</view><text class="item-x">{{student.dailyNew}} 个</text><text class="arrow">›</text></view>
      <view class="item" hover-class="hover-row" data-url="/pkg-me/about/about" bindtap="go"><view class="item-main">关于老师</view><text class="arrow">›</text></view>
      <button class="item me-fb" hover-class="hover-row" open-type="feedback"><view class="item-main">意见反馈 / 单词报错</view><text class="arrow">›</text></button>
      <button class="item me-fb" hover-class="hover-row" open-type="contact"><view class="item-main">联系客服</view><text class="arrow">›</text></button>
      <view class="item" hover-class="hover-row" bindtap="privacy"><view class="item-main">隐私说明</view><text class="arrow">›</text></view>
    </view>
    <view class="muted small center me-foot">JomBelajar · 张静灵老师主持编写</view>
  </block>
</view>
<view class="tab-pad" />
