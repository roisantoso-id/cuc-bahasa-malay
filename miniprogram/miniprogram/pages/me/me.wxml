<page-meta page-style="{{th.style}}" background-color="{{th.bg}}" background-text-style="{{th.day ? 'dark' : 'light'}}" />
<view class="wrap me-page">
  <hb-empty wx:if="{{view === 'loading'}}" image="loading" title="正在翻护照…" />
  <hb-empty wx:elif="{{view === 'error'}}" image="fail" title="{{error}}"><button class="btn btn-main" hover-class="hover" bindtap="load">再试一次</button></hb-empty>
  <block wx:else>
    <!-- 顶部：左边头像（进度圈 + L 等级），右边名字和这一站进度；下面一条「下一个目标」（这一站能解锁的两套衣服），再一行四个数 -->
    <view class="me-hero">
      <view class="me-more" hover-class="hover" data-url="/pkg-me/more/more" bindtap="go"><text class="me-dot" /><text class="me-dot" /><text class="me-dot" /></view>
      <view class="me-top" data-url="/pkg-me/wardrobe/wardrobe" bindtap="go">
        <lv-avatar src="{{mascotImg || student.avatar}}" size="{{144}}" level="{{lv.level}}" pct="{{lv.pct}}" />
        <view class="me-id">
          <view class="me-name one">{{student.name || '同学'}}</view>
          <view class="me-sub one">{{student.school || '学校未填'}}{{student.className ? ' · ' + student.className : ''}}</view>
          <view class="me-lv"><text class="me-lv-t">L{{lv.level}} · {{lv.name}}站</text><text class="me-lv-p">{{lv.pct}}%</text></view>
          <view class="me-lv-bar"><view class="me-lv-f" style="width:{{lv.pct}}%" /></view>
        </view>
      </view>

      <view wx:if="{{goal}}" class="me-goal" hover-class="hover" data-url="/pkg-me/wardrobe/wardrobe" bindtap="go">
        <view class="me-goal-imgs">
          <view wx:for="{{goal.imgs}}" wx:key="*this" class="me-goal-box"><image class="me-goal-img" src="{{item}}" webp mode="aspectFit" /></view>
        </view>
        <view class="me-goal-m">
          <view class="me-goal-t">{{goal.title}}</view>
          <view class="me-goal-x">{{goal.sub}}</view>
        </view>
        <text class="arrow">›</text>
      </view>

      <view class="me-stats">
        <view class="me-st" data-url="/pkg-me/wardrobe/wardrobe" bindtap="go"><text class="num">{{stamps}}</text><text class="me-st-l">印章</text></view>
        <view class="me-st" data-url="/pkg-me/wardrobe/wardrobe" bindtap="go"><text class="num">{{badgeN}}</text><text class="me-st-l">徽章</text></view>
        <view class="me-st" hover-class="hover" data-url="/pkg-word/book/book?type=wrong" bindtap="go"><text class="num">{{total.wrong}}</text><text class="me-st-l">错词本 ›</text></view>
        <view class="me-st" hover-class="hover" data-url="/pkg-word/book/book?type=fav" bindtap="go"><text class="num">{{total.fav}}</text><text class="me-st-l">收藏 ›</text></view>
      </view>
    </view>

    <view wx:if="{{memory}}">
      <view class="sec"><text class="sec-t">记得多牢</text><text class="sec-x">学过 {{memory.strong + memory.ok + memory.weak}} / {{memory.words}} 词</text></view>
      <view class="me-stack">
        <view class="me-sg me-c1" style="width:{{memory.pStrong}}%" />
        <view class="me-sg me-c2" style="width:{{memory.pOk}}%" />
        <view class="me-sg me-c3" style="width:{{memory.pWeak}}%" />
      </view>
      <view class="me-legend">
        <view class="me-lg"><view class="num">{{memory.strong}}</view><view class="me-lg-l"><text class="me-d me-c1" />牢固</view></view>
        <view class="me-lg"><view class="num">{{memory.ok}}</view><view class="me-lg-l"><text class="me-d me-c2" />熟悉</view></view>
        <view class="me-lg"><view class="num">{{memory.weak}}</view><view class="me-lg-l"><text class="me-d me-c3" />快忘了</view></view>
        <view class="me-lg"><view class="num">{{memory.unseen}}</view><view class="me-lg-l"><text class="me-d me-c4" />没见过</view></view>
      </view>

      <view class="sec"><text class="sec-t">未来 7 天要复习</text><text class="sec-x">{{memory.peakLabel}}</text></view>
      <view class="me-bars">
        <view wx:for="{{next7}}" wx:key="index" class="me-bc">
          <view class="me-bn">{{item.n}}</view>
          <view class="me-bt"><view class="me-bf {{item.today ? 'today' : ''}}" style="height:{{item.h}}%" /></view>
          <view class="me-bl {{item.today ? 'today' : ''}}">{{item.label}}</view>
        </view>
      </view>
    </view>

    <view class="sec"><text class="sec-t">最近 30 天</text><text class="sec-x">连续 {{s.streak}} 天 · 共学 {{s.studyDays}} 天</text></view>
    <view class="me-heat">
      <view wx:for="{{heat}}" wx:key="day" class="me-hc l{{item.lv}}" />
    </view>

  </block>
</view>
<view class="tab-pad" />
