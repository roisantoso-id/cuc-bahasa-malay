<page-meta page-style="{{th.style}}" background-color="{{th.bg}}" background-text-style="{{th.day ? 'dark' : 'light'}}" />
<view class="wrap me-page">
  <hb-empty wx:if="{{view === 'loading'}}" image="loading" title="正在翻护照…" />
  <hb-empty wx:elif="{{view === 'error'}}" image="fail" title="{{error}}"><button class="btn btn-main" hover-class="hover" bindtap="load">再试一次</button></hb-empty>
  <!-- 白天「旅行手账」排版（design/mp-v2 方向 A · A6 护照）；夜晚那套在下面 wx:else 里不动 -->
  <block wx:elif="{{th.day}}">
    <view class="dA dA-me">
      <view class="dA-me-pp">
        <view class="dA-me-pt dA-mono"><text>PASPORT · 护照</text><text>JOMBELAJAR</text></view>
        <view class="dA-me-id">
          <image class="dA-me-ph" src="{{mascotImg || student.avatar || '/assets/avatar.jpg'}}" webp mode="aspectFill" data-url="/pkg-me/wardrobe/wardrobe" bindtap="go" />
          <view class="dA-me-dl">
            <view class="dA-me-di"><view class="dA-me-dt">姓名</view><view class="dA-me-dd">{{student.name || '同学'}}</view></view>
            <view class="dA-me-di"><view class="dA-me-dt">班级</view><view class="dA-me-dd">{{student.className || student.school || '未填'}}</view></view>
            <view wx:if="{{dDepart}}" class="dA-me-di"><view class="dA-me-dt">出发日</view><view class="dA-me-dd dA-latin">{{dDepart}}</view></view>
            <view class="dA-me-di"><view class="dA-me-dt">连续</view><view class="dA-me-dd">{{s.streak}} 天</view></view>
            <view wx:if="{{dCur}}" class="dA-me-di wide"><view class="dA-me-dt">当前站</view><view class="dA-me-dd">{{dCur}}</view></view>
          </view>
        </view>
        <view class="dA-me-mrz dA-mono">{{dMrz}}</view>
      </view>

      <view class="dA-sec"><text class="t">签证页</text><text class="x">已盖 {{dGot}} / {{dStops.length}} 个章</text></view>
      <view class="dA-me-stamps">
        <view wx:for="{{dStops}}" wx:key="level" class="dA-me-sp {{item.got ? 'got' : item.cur ? 'cur' : ''}}">
          <view class="dA-me-ring"><view class="dA-me-in">{{item.mark}}</view></view>
          <view class="dA-me-city">{{item.city}}</view>
        </view>
      </view>

      <view class="dA-me-stats">
        <view class="dA-me-st"><text class="dA-me-sn">{{total.learned}}</text><text class="dA-me-sl">学过的词</text></view>
        <view class="dA-me-st"><text class="dA-me-sn">{{memory ? memory.strong : total.mastered}}</text><text class="dA-me-sl">已记牢</text></view>
        <view class="dA-me-st"><text class="dA-me-sn">{{s.studyDays}}</text><text class="dA-me-sl">共学天数</text></view>
      </view>

      <view class="dA-me-menu">
        <view class="dA-me-row" hover-class="hover" data-url="/pkg-word/book/book?type=wrong" bindtap="go"><text class="dA-me-rt">错词本</text><text class="dA-me-rx">{{total.wrong}} 个 ›</text></view>
        <view class="dA-me-row" hover-class="hover" data-url="/pkg-word/book/book?type=fav" bindtap="go"><text class="dA-me-rt">收藏</text><text class="dA-me-rx">{{total.fav}} 个 ›</text></view>
        <view class="dA-me-row" hover-class="hover" data-url="/pkg-me/wardrobe/wardrobe" bindtap="go"><text class="dA-me-rt">犀鸟衣柜</text><text class="dA-me-rx">{{costumeN}} 套 · {{badgeN}} 枚徽章 ›</text></view>
        <view class="dA-me-row" hover-class="hover" data-url="/pkg-word/placement/placement" bindtap="go"><text class="dA-me-rt">难度测评</text><text class="dA-me-rx">{{place.level ? place.label + ' · 重新测评' : '还没测'}} ›</text></view>
        <view class="dA-me-row" hover-class="hover" data-url="/pkg-me/more/more" bindtap="go"><text class="dA-me-rt">设置与关于</text><text class="dA-me-rx">›</text></view>
      </view>
    </view>
  </block>

  <block wx:else>
    <!-- 顶部：左边头像（进度圈 + L 等级），右边名字和这一站进度；下面一条「下一个目标」（这一站能解锁的两套衣服），再一行四个数 -->
    <view class="me-hero">
      <view class="me-more" hover-class="hover" data-url="/pkg-me/more/more" bindtap="go"><text class="me-dot" /><text class="me-dot" /><text class="me-dot" /></view>
      <view class="me-top" data-url="/pkg-me/wardrobe/wardrobe" bindtap="go">
        <lv-avatar src="{{mascotImg || student.avatar}}" size="{{144}}" level="{{lv.level}}" pct="{{lv.pct}}" />
        <view class="me-id">
          <view class="me-name one">{{student.name || '同学'}}</view>
          <view class="me-sub one">{{student.school || '学校未填'}}{{student.className ? ' · ' + student.className : ''}}</view>
          <view class="me-lv"><text class="me-lv-t">L{{lv.level}} · {{lv.name}}站</text><text class="me-lv-p">{{lv.pct}}%</text></view>
          <view class="me-lv-bar"><view class="me-lv-f" style="width:{{lv.pct}}%" /></view>
        </view>
      </view>

      <view wx:if="{{goal}}" class="me-goal" hover-class="hover" data-url="/pkg-me/wardrobe/wardrobe" bindtap="go">
        <view class="me-goal-imgs">
          <view wx:for="{{goal.imgs}}" wx:key="*this" class="me-goal-box"><image class="me-goal-img" src="{{item}}" webp mode="aspectFit" /></view>
        </view>
        <view class="me-goal-m">
          <view class="me-goal-t">{{goal.title}}</view>
          <view class="me-goal-x">{{goal.sub}}</view>
        </view>
        <text class="arrow">›</text>
      </view>

      <view class="me-stats">
        <view class="me-st" data-url="/pkg-me/wardrobe/wardrobe" bindtap="go"><text class="num">{{stamps}}</text><text class="me-st-l">印章</text></view>
        <view class="me-st" data-url="/pkg-me/wardrobe/wardrobe" bindtap="go"><text class="num">{{badgeN}}</text><text class="me-st-l">徽章</text></view>
        <view class="me-st" hover-class="hover" data-url="/pkg-word/book/book?type=wrong" bindtap="go"><text class="num">{{total.wrong}}</text><text class="me-st-l">错词本 ›</text></view>
        <view class="me-st" hover-class="hover" data-url="/pkg-word/book/book?type=fav" bindtap="go"><text class="num">{{total.fav}}</text><text class="me-st-l">收藏 ›</text></view>
      </view>
    </view>

    <view wx:if="{{memory}}">
      <view class="sec"><text class="sec-t">记得多牢</text><text class="sec-x">学过 {{memory.strong + memory.ok + memory.weak}} / {{memory.words}} 词</text></view>
      <view class="me-stack">
        <view class="me-sg me-c1" style="width:{{memory.pStrong}}%" />
        <view class="me-sg me-c2" style="width:{{memory.pOk}}%" />
        <view class="me-sg me-c3" style="width:{{memory.pWeak}}%" />
      </view>
      <view class="me-legend">
        <view class="me-lg"><view class="num">{{memory.strong}}</view><view class="me-lg-l"><text class="me-d me-c1" />牢固</view></view>
        <view class="me-lg"><view class="num">{{memory.ok}}</view><view class="me-lg-l"><text class="me-d me-c2" />熟悉</view></view>
        <view class="me-lg"><view class="num">{{memory.weak}}</view><view class="me-lg-l"><text class="me-d me-c3" />快忘了</view></view>
        <view class="me-lg"><view class="num">{{memory.unseen}}</view><view class="me-lg-l"><text class="me-d me-c4" />没见过</view></view>
      </view>

      <view class="sec"><text class="sec-t">未来 7 天要复习</text><text class="sec-x">{{memory.peakLabel}}</text></view>
      <view class="me-bars">
        <view wx:for="{{next7}}" wx:key="index" class="me-bc">
          <view class="me-bn">{{item.n}}</view>
          <view class="me-bt"><view class="me-bf {{item.today ? 'today' : ''}}" style="height:{{item.h}}%" /></view>
          <view class="me-bl {{item.today ? 'today' : ''}}">{{item.label}}</view>
        </view>
      </view>
    </view>

    <view class="list me-place">
      <view class="item" hover-class="hover-row" data-url="/pkg-word/placement/placement" bindtap="go">
        <view class="item-main"><view>难度测评</view><view class="muted small">{{place.level ? '推荐难度 · ' + place.label + (place.vocab ? ' · 约 ' + place.vocab + ' 词' : '') : '还没测，3 分钟测出从哪一档学起'}}</view></view>
        <text class="muted small">{{place.level ? '重新测评' : '去测'}}</text><text class="arrow">›</text>
      </view>
    </view>

    <view class="sec"><text class="sec-t">最近 30 天</text><text class="sec-x">连续 {{s.streak}} 天 · 共学 {{s.studyDays}} 天</text></view>
    <view class="me-heat">
      <view wx:for="{{heat}}" wx:key="day" class="me-hc l{{item.lv}}" />
    </view>

  </block>
</view>
<view class="tab-pad" />
