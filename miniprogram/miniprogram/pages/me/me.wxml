<view class="wrap">
  <hb-empty wx:if="{{view === 'loading'}}" image="loading" title="正在翻护照…" />
  <hb-empty wx:elif="{{view === 'error'}}" image="fail" title="{{error}}"><button class="btn btn-main" hover-class="hover" bindtap="load">再试一次</button></hb-empty>
  <block wx:else>
    <view class="who">
      <image class="av" src="{{student.avatar || '/assets/avatar.jpg'}}" mode="aspectFill" data-url="/pages/register/register" bindtap="go" />
      <view class="item-main">
        <view class="nm">{{student.name || '同学'}}</view>
        <view class="muted small">{{student.school || '学校未填'}}{{student.className ? ' · ' + student.className : ''}} · 已盖 {{stamps}} 个章</view>
      </view>
      <view class="edit" data-url="/pages/register/register" bindtap="go">{{student.name ? '修改资料' : '完善资料'}}</view>
    </view>

    <view wx:if="{{memory}}">
      <view class="between sec"><text class="st">记得多牢</text><text class="muted small">已开放 {{memory.words}} 词</text></view>
      <view class="stack">
        <view class="sg s1" style="width:{{memory.pStrong}}%" />
        <view class="sg s2" style="width:{{memory.pOk}}%" />
        <view class="sg s3" style="width:{{memory.pWeak}}%" />
      </view>
      <view class="legend">
        <text class="lg"><text class="d d1" />牢固 {{memory.strong}}</text>
        <text class="lg"><text class="d d2" />熟悉 {{memory.ok}}</text>
        <text class="lg"><text class="d d3" />快忘了 {{memory.weak}}</text>
        <text class="lg"><text class="d d4" />没见过 {{memory.unseen}}</text>
      </view>

      <view class="between sec"><text class="st">未来 7 天要复习</text><text class="muted small">{{memory.peakLabel}}</text></view>
      <view class="bars">
        <view wx:for="{{next7}}" wx:key="index" class="bc">
          <view class="bn">{{item.n}}</view>
          <view class="bt"><view class="bf {{item.today ? 'today' : ''}}" style="height:{{item.h}}%" /></view>
          <view class="bl">{{item.label}}</view>
        </view>
      </view>
    </view>

    <view class="between sec"><text class="st">最近 30 天</text><text class="muted small">连续 {{s.streak}} 天 · 共学 {{s.studyDays}} 天</text></view>
    <view class="heat">
      <view wx:for="{{heat}}" wx:key="day" class="hc l{{item.lv}}" />
    </view>

    <view class="list links">
      <view class="item" data-url="/pkg-word/book/book?type=wrong" bindtap="go"><view class="item-main">错词本</view><text class="muted">{{total.wrong}} 个 ›</text></view>
      <view class="item" data-url="/pkg-word/book/book?type=fav" bindtap="go"><view class="item-main">收藏</view><text class="muted">{{total.fav}} 个 ›</text></view>
      <view class="item" bindtap="goal"><view class="item-main">每天新词</view><text class="muted">{{student.dailyNew}} 个 ›</text></view>
      <view class="item" data-url="/pkg-me/about/about" bindtap="go"><view class="item-main">关于老师</view><text class="arrow">›</text></view>
      <button class="item fb" open-type="feedback"><view class="item-main">意见反馈 / 单词报错</view><text class="arrow">›</text></button>
      <view class="item" bindtap="privacy"><view class="item-main">隐私说明</view><text class="arrow">›</text></view>
      <button class="item fb" open-type="contact"><view class="item-main">联系客服</view><text class="arrow">›</text></button>
      <view class="item" data-url="/pages/register/register" bindtap="go"><view class="item-main">修改资料</view><text class="arrow">›</text></view>
    </view>
    <view class="muted small center" style="margin-top:40rpx">JomBelajar · 张静灵老师主持编写</view>
  </block>
</view>
<view class="tab-pad" />
