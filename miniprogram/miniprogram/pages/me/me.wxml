<view class="wrap">
  <view class="profile card card-tap" hover-class="hover" data-url="/pages/register/register" bindtap="go">
    <view class="avatar avatar-txt">{{student.name ? student.name[0] : '我'}}</view>
    <view class="item-main">
      <view class="name">{{student.name || '同学'}}</view>
      <view class="muted small">{{student.school}}{{student.className ? ' · ' + student.className : ''}}</view>
      <view class="muted small">{{track}}</view>
    </view>
    <text class="arrow">修改 ›</text>
  </view>

  <view class="stats">
    <view class="stat"><view class="n" style="color:var(--green)">{{ov.learnedToday || 0}}</view><view class="muted small">今日新学</view></view>
    <view class="stat"><view class="n" style="color:var(--blue)">{{ov.dueTotal || 0}}</view><view class="muted small">待复习</view></view>
    <view class="stat"><view class="n">{{ov.learnedTotal || 0}}</view><view class="muted small">累计学会</view></view>
  </view>

  <view class="card list" style="margin-top:36rpx">
    <view class="item" hover-class="hover-row" data-url="/pkg-me/about/about" bindtap="go"><view class="item-main">关于老师<view class="muted small">张静灵老师主持编写</view></view><text class="arrow">›</text></view>
    <button class="item fb" open-type="feedback"><view class="item-main">意见反馈 / 单词报错</view><text class="arrow">›</text></button>
    <view class="item" hover-class="hover-row" bindtap="privacy"><view class="item-main">隐私说明</view><text class="arrow">›</text></view>
  </view>
  <view class="muted small center" style="margin-top:40rpx">JomBelajar · 张静灵老师主持编写</view>
</view>
