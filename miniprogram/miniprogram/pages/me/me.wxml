<view class="wrap">
  <hb-empty wx:if="{{view === 'loading'}}" image="loading" title="正在翻护照…" />
  <hb-empty wx:elif="{{view === 'error'}}" image="fail" title="{{error}}"><button class="btn btn-main" hover-class="hover" bindtap="load">再试一次</button></hb-empty>
  <block wx:else>
    <!-- 护照首页 -->
    <view class="passport">
      <view class="pp-top between">
        <text class="no pp-k">PASPORT BAHASA · 马来语护照</text>
        <text class="pp-edit" data-url="/pages/register/register" bindtap="go">修改资料 ›</text>
      </view>
      <view class="row pp-body">
        <image class="pp-photo" src="/assets/avatar.jpg" mode="aspectFill" />
        <view class="item-main">
          <view class="pp-l">NAMA 姓名</view><view class="pp-v">{{student.name}}</view>
          <view class="pp-l">SEKOLAH 学校</view><view class="pp-v small">{{student.school}}{{student.className ? ' · ' + student.className : ''}}</view>
          <view class="pp-l">起点</view><view class="pp-v small">{{track}}</view>
        </view>
      </view>
      <view class="pp-mrz no">P&lt;MYS&lt;JOMBELAJAR&lt;&lt;{{total.learned}}&lt;&lt;{{s.streak}}&lt;&lt;&lt;</view>
    </view>

    <view class="nums">
      <view><view class="n">{{s.streak}}</view><view class="muted small">连续天数</view></view>
      <view><view class="n">{{s.studyDays}}</view><view class="muted small">学习天数</view></view>
      <view><view class="n c-green">{{total.learned}}</view><view class="muted small">已学</view></view>
      <view><view class="n c-blue">{{total.mastered}}</view><view class="muted small">已掌握</view></view>
    </view>

    <!-- 印章页 -->
    <view class="h2 between"><text>印章</text><text class="muted small">{{stamps}} / 10 站</text></view>
    <view class="card stamps">
      <view wx:for="{{s.levels}}" wx:key="level" class="st-cell">
        <view class="stamp {{item.stamped ? '' : 'off'}}" style="{{item.stamped ? 'transform:rotate(' + (index % 3 * 9 - 12) + 'deg)' : ''}}">
          <text class="s1">{{item.city}}</text>
          <text class="s2">{{item.stamped ? '已到达' : item.total ? item.learned + '/' + item.total : '整理中'}}</text>
        </view>
      </view>
    </view>

    <!-- 近 30 天 -->
    <view class="h2 between"><text>近 30 天</text><text class="muted small"><text class="key k-new" />新学 <text class="key k-rev" />复习</text></view>
    <view class="card">
      <view class="chart">
        <view wx:for="{{days}}" wx:key="day" class="col">
          <view class="stack"><view class="seg rev" style="height:{{item.hRev}}%" /><view class="seg new" style="height:{{item.hNew}}%" /></view>
        </view>
      </view>
      <view class="between muted small"><text>{{days[0].day}}</text><text>今天</text></view>
    </view>

    <!-- 熟练度 -->
    <view class="h2">熟练度</view>
    <view class="card">
      <view wx:for="{{boxes}}" wx:key="label" class="bx">
        <text class="bx-l small">{{item.label}}</text>
        <view class="bar thin bx-bar"><view class="bar-in" style="width:{{item.pct}}%;opacity:{{0.35 + index * 0.11}}" /></view>
        <text class="bx-n small muted">{{item.n}}</text>
      </view>
    </view>

    <view class="card list" style="margin-top:36rpx">
      <view class="item" bindtap="goal"><view class="item-main">每天新词</view><text class="muted">{{student.dailyNew}} 个 ›</text></view>
      <view class="item" data-url="/pkg-word/book/book?type=wrong" bindtap="go"><view class="item-main">单词本</view><text class="arrow">›</text></view>
      <view class="item" data-url="/pkg-me/about/about" bindtap="go"><view class="item-main">关于老师</view><text class="arrow">›</text></view>
      <button class="item fb" open-type="feedback"><view class="item-main">意见反馈 / 单词报错</view><text class="arrow">›</text></button>
      <view class="item" bindtap="privacy"><view class="item-main">隐私说明</view><text class="arrow">›</text></view>
    </view>
    <view class="muted small center" style="margin-top:40rpx">JomBelajar · 张静灵老师主持编写</view>
  </block>
</view>
