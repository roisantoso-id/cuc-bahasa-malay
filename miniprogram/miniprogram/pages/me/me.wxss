/* 护照：只回答三个问题——记得多牢、接下来要复习多少、最近有没有坚持。星光只给「牢固」 */
/* 顶部：头像在左、身份和这一站进度在右；「下一个目标」= 这一站学完能解锁的两套衣服；底下一行四个数（错词本、收藏可点） */
.me-hero { position: relative; padding: var(--s3); background: var(--panel); border-radius: var(--r-lg); }
.me-more { position: absolute; top: var(--s2); right: var(--s2); width: 64rpx; height: 64rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; gap: 6rpx; background: var(--wash); z-index: 2; }
.me-dot { width: 8rpx; height: 8rpx; border-radius: 50%; background: var(--raise); }
.me-top { display: flex; align-items: center; gap: var(--s3); padding-right: 64rpx; }
.me-id { flex: 1; min-width: 0; }
.me-name { font-size: var(--t-title); font-weight: 700; font-family: var(--f-zh); line-height: 1.3; }
.me-sub { font-size: var(--t-caption); color: var(--ink2); margin-top: 4rpx; }
.me-lv { display: flex; justify-content: space-between; align-items: baseline; margin-top: var(--s2); font-size: var(--t-caption); }
.me-lv-t { color: var(--star); font-weight: 600; }
.me-lv-p { color: var(--ink2); font-family: var(--f-ms); }
.me-lv-bar { height: 10rpx; margin-top: 8rpx; border-radius: var(--r-pill); background: var(--hair); overflow: hidden; }
.me-lv-f { height: 100%; border-radius: var(--r-pill); background: var(--star); min-width: 10rpx; }
.me-goal { display: flex; align-items: center; gap: var(--s2); margin-top: var(--s3); padding: var(--s2); border-radius: var(--r-sm); background: var(--inset); }
.me-goal-imgs { display: flex; flex: none; }
.me-goal-box { width: 88rpx; height: 88rpx; border-radius: 16rpx; background: var(--photo); display: flex; align-items: center; justify-content: center; border: 3rpx solid var(--panel); box-sizing: border-box; }
.me-goal-box + .me-goal-box { margin-left: -20rpx; }
.me-goal-img { width: 80rpx; height: 80rpx; }
.me-goal-m { flex: 1; min-width: 0; }
.me-goal-t { font-size: 28rpx; font-weight: 600; color: var(--strong); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.me-goal-x { font-size: var(--t-caption); color: var(--ink2); margin-top: 4rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.me-stats { display: flex; margin-top: var(--s3); }
.me-st { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; }
.me-st + .me-st { border-left: 2rpx solid var(--hair); }
.me-st-l { font-size: var(--t-caption); color: var(--ink2); white-space: nowrap; }

.me-c1 { background: var(--star); } .me-c2 { background: var(--ok); } .me-c3 { background: var(--bad); } .me-c4 { background: var(--hair2); }
.me-stack { display: flex; height: 16rpx; border-radius: var(--r-pill); overflow: hidden; background: var(--hair); }
.me-sg { height: 100%; }
.me-legend { display: flex; margin-top: var(--s2); }
.me-lg { flex: 1; min-width: 0; }
.me-lg-l { display: flex; align-items: center; gap: var(--s1); font-size: var(--t-caption); color: var(--ink2); white-space: nowrap; }
.me-d { display: inline-block; width: 16rpx; height: 16rpx; border-radius: 4rpx; flex: none; }

.me-bars { display: flex; gap: var(--s2); height: 150rpx; }
.me-bc { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; }
.me-bn { font-family: var(--f-ms); font-size: 22rpx; color: var(--ink2); height: 32rpx; line-height: 32rpx; }
.me-bt { flex: 1; width: 100%; display: flex; align-items: flex-end; }
.me-bf { width: 100%; border-radius: 8rpx; background: var(--hair2); }
.me-bf.today { background: var(--raise); }
.me-bl { font-size: 22rpx; color: var(--ink2); height: 36rpx; line-height: 36rpx; }
.me-bl.today { color: var(--strong); }

.me-heat { display: grid; grid-template-columns: repeat(15, minmax(0, 1fr)); gap: 6rpx; }
.me-hc { height: 28rpx; border-radius: 6rpx; background: var(--hair); }
.me-hc.l1 { background: var(--heat1); } .me-hc.l2 { background: var(--heat2); } .me-hc.l3 { background: var(--ok); }


/* 一屏看完：这一页的小节间距收紧（全局 .sec 是 48rpx 上边距） */
.me-page { padding-top: var(--s2); }
.me-page .sec { margin: var(--s3) 0 var(--s1); }
.me-page .me-hero { padding: var(--s2) var(--s3) var(--s3); }
.me-page .me-goal { margin-top: var(--s2); }
.me-page .me-stats { margin-top: var(--s2); }

/* ================= 白天「旅行手账」排版（A6 护照）：只在 th.day 时出现，类名 dA-me- 开头 ================= */
.dA-me { margin: 0 8rpx; }
.dA-me-pp { margin-top: 16rpx; padding: 28rpx 32rpx; border-radius: 28rpx; background: var(--gr-d); color: #f3ead6; }
.dA-me-pt { display: flex; justify-content: space-between; font-size: 22rpx; letter-spacing: .14em; opacity: .75; white-space: nowrap; }
.dA-me-id { display: flex; margin-top: 24rpx; }
.dA-me-ph { flex: none; width: 168rpx; height: 208rpx; margin-right: 28rpx; border-radius: 12rpx; border: 4rpx solid #f3ead6; background: #fff; box-sizing: border-box; }
.dA-me-dl { flex: 1; min-width: 0; display: flex; flex-wrap: wrap; align-content: flex-start; }
.dA-me-di { width: 50%; min-width: 0; padding-right: 20rpx; margin-bottom: 12rpx; box-sizing: border-box; }
.dA-me-di.wide { width: 100%; }
.dA-me-dt { font-size: 20rpx; letter-spacing: .1em; opacity: .65; }
.dA-me-dd { font-family: var(--serif); font-size: 32rpx; line-height: 1.2; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.dA-me-dd.dA-latin { font-family: var(--latin); font-size: 28rpx; line-height: 38rpx; }
.dA-me-mrz { margin-top: 12rpx; font-size: 23rpx; letter-spacing: .06em; opacity: .6; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.dA-me-stamps { display: flex; flex-wrap: wrap; margin-top: 8rpx; }
.dA-me-sp { width: 20%; min-width: 0; display: flex; flex-direction: column; align-items: center; margin-bottom: 20rpx; font-size: 22rpx; color: var(--mu); }
.dA-me-ring { width: 100rpx; height: 100rpx; border-radius: 50%; border: 3rpx dashed var(--ln); box-sizing: border-box; display: flex; align-items: center; justify-content: center; }
.dA-me-in { width: 84rpx; height: 84rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-family: var(--mono); font-size: 26rpx; box-sizing: border-box; }
.dA-me-sp.got { color: var(--ik); }
.dA-me-sp.got .dA-me-ring { border: 4rpx solid var(--rd); transform: rotate(-8deg); }
.dA-me-sp.got .dA-me-in { border: 2rpx solid var(--rd); color: var(--rd); font-family: var(--serif); font-weight: 700; font-size: 30rpx; }
.dA-me-sp.cur { color: var(--gr); }
.dA-me-sp.cur .dA-me-ring { border: 4rpx solid var(--gr); background: var(--gr-l); }
.dA-me-sp.cur .dA-me-in { color: var(--gr); font-weight: 700; }
.dA-me-city { margin-top: 8rpx; max-width: 100%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.dA-me-stats { display: flex; margin-top: 16rpx; border-top: 3rpx solid var(--ik); border-bottom: 2rpx solid var(--ln); }
.dA-me-st { flex: 1; min-width: 0; padding: 20rpx 0; display: flex; flex-direction: column; }
.dA-me-st + .dA-me-st { border-left: 2rpx solid var(--ln); padding-left: 24rpx; }
.dA-me-sn { font-family: var(--latin); font-size: 52rpx; line-height: 1.1; }
.dA-me-sl { font-size: 24rpx; color: var(--mu); white-space: nowrap; }

.dA-me-row { display: flex; align-items: center; height: 90rpx; border-bottom: 2rpx solid var(--ln); font-size: 32rpx; }
.dA-me-rt { flex: none; }
.dA-me-rx { flex: 1; min-width: 0; margin-left: 24rpx; text-align: right; font-size: 26rpx; color: var(--mu); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.dA-me-menu { margin-top: 8rpx; }

/* 难度测评入口（夜晚） */
.me-place { margin-top: var(--s4); }
