.profile { display: flex; align-items: center; gap: 24rpx; }
.avatar { width: 120rpx; height: 120rpx; border-radius: 50%; background: var(--green-l); flex: none; }
.name { font-size: 36rpx; font-weight: 700; }
.stats { display: flex; gap: 20rpx; margin-top: 28rpx; }
.stat { flex: 1; background: #fff; border: 2rpx solid var(--line); border-radius: 8rpx; padding: 18rpx 0; text-align: center; }
.n { font-size: 44rpx; font-weight: 700; line-height: 1.2; }
.hover-row { opacity: .6; }
button.fb { background: transparent; border-radius: 0; margin: 0; padding: 28rpx 0; font-size: 30rpx; line-height: 1.55; text-align: left; color: var(--ink); width: 100%; }
button.fb::after { border: 0; }

.avatar-txt { display: flex; align-items: center; justify-content: center; background: #14213d; color: #a8823a; font-size: 48rpx; font-family: "Songti SC", serif; }
