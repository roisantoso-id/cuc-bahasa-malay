.who { display: flex; align-items: center; gap: 24rpx; padding-top: 8rpx; }
.av { width: 128rpx; height: 128rpx; border-radius: 50%; flex: none; border: 4rpx solid var(--star); }
.nm { font-size: 44rpx; font-weight: 800; font-family: "Songti SC", "STSong", -apple-system, "PingFang SC", serif; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.edit { flex: none; font-size: 26rpx; color: var(--star); border: 2rpx solid var(--hair2); border-radius: 999rpx; padding: 0 24rpx; line-height: 72rpx; min-height: 72rpx; }
.sec { margin: 48rpx 0 20rpx; }
.st { font-size: 32rpx; font-weight: 800; font-family: "Songti SC", "STSong", -apple-system, "PingFang SC", serif; }
.stack { display: flex; height: 20rpx; border-radius: 999rpx; overflow: hidden; background: rgba(243,234,214,.1); }
.sg { height: 100%; }
.s1 { background: var(--star); } .s2 { background: var(--ok); } .s3 { background: var(--bad); }
.legend { display: flex; flex-wrap: wrap; gap: 8rpx 28rpx; margin-top: 20rpx; font-size: 26rpx; }
.d { display: inline-block; width: 16rpx; height: 16rpx; border-radius: 4rpx; margin-right: 8rpx; }
.d1 { background: var(--star); } .d2 { background: var(--ok); } .d3 { background: var(--bad); } .d4 { background: rgba(243,234,214,.3); }
.bars { display: flex; gap: 14rpx; height: 260rpx; }
.bc { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; }
.bn { font-size: 26rpx; font-family: Georgia, serif; color: var(--ink2); height: 40rpx; }
.bt { flex: 1; width: 100%; display: flex; align-items: flex-end; }
.bf { width: 100%; border-radius: 8rpx; background: rgba(243,234,214,.14); }
.bf.today { background: var(--star); }
.bl { font-size: 24rpx; color: var(--ink2); height: 44rpx; line-height: 44rpx; }
.heat { display: grid; grid-template-columns: repeat(10, minmax(0, 1fr)); gap: 10rpx; }
.hc { height: 44rpx; border-radius: 8rpx; background: rgba(243,234,214,.08); }
.hc.l1 { background: rgba(143,192,160,.35); } .hc.l2 { background: var(--ok); } .hc.l3 { background: var(--star); }
.links { margin-top: 40rpx; border-top: 2rpx solid var(--hair); }
button.fb { background: transparent; border-radius: 0; margin: 0; padding: 28rpx 0; font-size: 30rpx; line-height: 1.55; text-align: left; color: var(--ink); width: 100%; display: flex; align-items: center; gap: 20rpx; }
button.fb::after { border: 0; }
