/* 护照：只回答三个问题——记得多牢、接下来要复习多少、最近有没有坚持。星光只给「牢固」 */
/* 顶部：我的犀鸟（最重要，放最上）；右上角「···」进设置与关于，护照本身只放学习数据 */
.me-hero { position: relative; display: flex; flex-direction: column; align-items: center; padding: var(--s4) var(--s3) var(--s4); background: var(--panel); border-radius: var(--r-lg); }
.me-more { position: absolute; top: var(--s2); right: var(--s2); width: 72rpx; height: 72rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; gap: 6rpx; background: rgba(243,234,214,.08); }
.me-dot { width: 8rpx; height: 8rpx; border-radius: 50%; background: var(--ivory); }
.me-bird { margin-top: var(--s2); }
.me-name { margin-top: var(--s2); font-size: var(--t-title); font-weight: 700; max-width: 100%; }
.me-ach { display: flex; width: 100%; margin-top: var(--s3); }
.me-ach-n { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; }
.me-ach-l { font-size: var(--t-caption); color: var(--ink2); }
.me-badges { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--s1); margin-top: var(--s3); }
.me-bdg { width: 64rpx; height: 64rpx; border-radius: 50%; background: var(--ivory); }
.me-dress { margin-top: var(--s3); align-self: stretch; }
.me-quick { display: flex; gap: var(--s2); margin-top: var(--s2); }
.me-q { flex: 1; min-width: 0; display: flex; align-items: baseline; justify-content: space-between; gap: var(--s1); padding: var(--s2) var(--s3); background: var(--panel); border-radius: var(--r-sm); }
.me-q-l { font-size: var(--t-caption); color: var(--ink2); white-space: nowrap; }

.me-c1 { background: var(--star); } .me-c2 { background: var(--ok); } .me-c3 { background: var(--bad); } .me-c4 { background: var(--hair2); }
.me-stack { display: flex; height: 16rpx; border-radius: var(--r-pill); overflow: hidden; background: var(--hair); }
.me-sg { height: 100%; }
.me-legend { display: flex; margin-top: var(--s3); }
.me-lg { flex: 1; min-width: 0; }
.me-lg-l { display: flex; align-items: center; gap: var(--s1); font-size: var(--t-caption); color: var(--ink2); white-space: nowrap; }
.me-d { display: inline-block; width: 16rpx; height: 16rpx; border-radius: 4rpx; flex: none; }

.me-bars { display: flex; gap: var(--s2); height: 240rpx; }
.me-bc { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; }
.me-bn { font-family: var(--f-ms); font-size: var(--t-caption); color: var(--ink2); height: 40rpx; }
.me-bt { flex: 1; width: 100%; display: flex; align-items: flex-end; }
.me-bf { width: 100%; border-radius: 8rpx; background: var(--hair2); }
.me-bf.today { background: var(--ivory); }
.me-bl { font-size: var(--t-caption); color: var(--ink2); height: 48rpx; line-height: 48rpx; }
.me-bl.today { color: var(--ivory); }

.me-heat { display: grid; grid-template-columns: repeat(10, minmax(0, 1fr)); gap: var(--s1); }
.me-hc { height: 40rpx; border-radius: 8rpx; background: var(--hair); }
.me-hc.l1 { background: rgba(143,192,160,.3); } .me-hc.l2 { background: rgba(143,192,160,.62); } .me-hc.l3 { background: var(--ok); }

