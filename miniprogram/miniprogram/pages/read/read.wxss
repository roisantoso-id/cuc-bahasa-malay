.seg { display: flex; background: #f0f0ea; border-radius: 24rpx; padding: 8rpx; }
.seg-i { flex: 1; text-align: center; padding: 16rpx 0; border-radius: 18rpx; font-weight: 900; color: var(--ink2); }
.seg-i.on { background: #fff; color: var(--ink); box-shadow: 0 4rpx 0 var(--line); }
.search { display: flex; gap: 16rpx; align-items: center; margin: 24rpx 0 16rpx; }
.cats { margin-bottom: 16rpx; white-space: nowrap; }
.title { font-size: 34rpx; font-weight: 900; margin: 10rpx 0 6rpx; }
.cover { position: relative; margin: -28rpx -28rpx 20rpx; height: 300rpx; border-radius: 28rpx 28rpx 0 0; overflow: hidden; background: #e4f1ff; }
.cover-img { width: 100%; height: 100%; }
.cover-ph { height: 100%; display: flex; align-items: center; justify-content: center; font-size: 72rpx; color: var(--blue); }
.dur { position: absolute; right: 16rpx; bottom: 16rpx; background: rgba(0,0,0,.65); color: #fff; font-size: 22rpx; padding: 4rpx 12rpx; border-radius: 10rpx; }
