<view class="wrap">
  <image wx:if="{{!edit}}" class="hero" src="/assets/welcome.jpg" mode="aspectFit" />
  <view wx:if="{{!edit}}" class="h1 center">Selamat datang!</view>
  <view wx:if="{{!edit}}" class="muted center small" style="margin-bottom:36rpx">填一下学习资料，老师可以按班级看到大家的进度。</view>

  <view class="field"><view class="label">姓名 / 昵称</view><input class="input" value="{{form.name}}" maxlength="30" data-k="name" bindinput="input" placeholder="怎么称呼你" /></view>
  <view class="field"><view class="label">学校</view><input class="input" value="{{form.school}}" maxlength="60" data-k="school" bindinput="input" placeholder="例如：中国传媒大学" /></view>
  <view class="field"><view class="label">班级</view><input class="input" value="{{form.className}}" maxlength="40" data-k="className" bindinput="input" placeholder="例如：马来语 2025 级（没有可不填）" /></view>
  <view class="field">
    <view class="label">你的马来语基础</view>
    <view class="seg">
      <view class="seg-i {{form.track === 'zero' ? 'on' : ''}}" data-v="zero" bindtap="setTrack">零基础</view>
      <view class="seg-i {{form.track === 'heritage' ? 'on' : ''}}" data-v="heritage" bindtap="setTrack">会说一些</view>
    </view>
  </view>
  <view class="field"><view class="label">手机号</view><input class="input" type="number" value="{{form.phone}}" maxlength="15" data-k="phone" bindinput="input" placeholder="用于老师联系你" /></view>

  <view class="agree" bindtap="toggleAgree">
    <view class="box {{agree ? 'on' : ''}}">{{agree ? '✓' : ''}}</view>
    <text class="small">我已阅读并同意 <text class="link" catchtap="privacy">隐私说明</text>，同意保存以上资料和学习记录。</text>
  </view>
  <view wx:if="{{error}}" class="err">{{error}}</view>
  <view class="btns"><button class="btn btn-main" hover-class="hover" loading="{{busy}}" disabled="{{busy}}" bindtap="submit">{{edit ? '保存' : '开始背单词'}}</button></view>
</view>
