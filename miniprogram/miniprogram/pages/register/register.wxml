<view class="wrap">
  <view class="muted small" style="margin-bottom:32rpx">以下都可以不填。填了学校和班级，老师能按班级看到大家的进度。</view>

  <!-- 头像：微信官方头像选择器（可选微信头像或相册），检测通过后同学才看得到 -->
  <view class="av-row">
    <button class="av-btn" open-type="chooseAvatar" bindchooseavatar="chooseAvatar">
      <image class="av-img" src="{{avatar || '/assets/avatar.jpg'}}" mode="aspectFill" />
      <view class="av-edit">{{avBusy ? '上传中' : '换头像'}}</view>
    </button>
    <view class="av-tip muted small">{{avatarPending ? '头像审核中，通过后同学才能看到' : '点头像可以换成你的微信头像'}}</view>
  </view>
  <view class="field"><view class="label">昵称</view><input class="input" type="nickname" placeholder-class="ph" value="{{form.name}}" maxlength="30" data-k="name" bindinput="input" bindblur="input" placeholder="怎么称呼你（可以一键填微信昵称）" /></view>
  <view class="field"><view class="label">学校</view><input class="input" placeholder-class="ph" value="{{form.school}}" maxlength="60" data-k="school" bindinput="input" placeholder="例如：中国传媒大学（选填）" /></view>
  <view class="field"><view class="label">班级</view><input class="input" placeholder-class="ph" value="{{form.className}}" maxlength="40" data-k="className" bindinput="input" placeholder="例如：马来语 2025 级（没有可不填）" /></view>
  <view class="field">
    <view class="label">你的马来语基础</view>
    <view class="seg">
      <view class="seg-i {{form.track === 'zero' ? 'on' : ''}}" data-v="zero" bindtap="setTrack">零基础</view>
      <view class="seg-i {{form.track === 'some' ? 'on' : ''}}" data-v="some" bindtap="setTrack">会说一些</view>
    </view>
  </view>
  <view class="field"><view class="label">手机号</view><input class="input" placeholder-class="ph" type="number" value="{{form.phone}}" maxlength="15" data-k="phone" bindinput="input" placeholder="方便老师联系你（选填）" /></view>

  <view class="agree" bindtap="toggleAgree">
    <view class="box {{agree ? 'on' : ''}}">{{agree ? '✓' : ''}}</view>
    <text class="small">我已阅读并同意 <text class="link" catchtap="privacy">隐私说明</text>，同意保存以上资料和学习记录。</text>
  </view>
  <view wx:if="{{error}}" class="err">{{error}}</view>
  <view class="btns"><button class="btn btn-main" hover-class="hover" loading="{{busy}}" disabled="{{busy}}" bindtap="submit">保存</button></view>
</view>
