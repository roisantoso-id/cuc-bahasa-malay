/* 对战分包共用（前缀 bx-）：答题复盘行。排行行、成绩头、一排数字都用全局的 .rk / .res / .stats */
.bx-rv { display: flex; align-items: flex-start; gap: var(--s2); padding: var(--s3) 0; border-bottom: 2rpx solid var(--hair); }
.bx-no { flex: none; width: 48rpx; font-family: var(--f-ms); font-size: 28rpx; color: var(--ink2); text-align: center; }
.bx-main { flex: 1; min-width: 0; word-break: break-word; }
.bx-q { font-size: var(--t-body); font-weight: 600; }
.bx-q.ms { font-size: var(--t-section); font-weight: 400; }
.bx-a { font-size: var(--t-caption); color: var(--ink2); }
.bx-a .ms { font-size: 28rpx; }
.bx-a.ok { color: var(--ok); }
.bx-mark { flex: none; width: 48rpx; text-align: right; font-size: var(--t-caption); color: var(--ok); line-height: 72rpx; }
.bx-mark.bad { color: var(--bad); }
.bx-note { padding: var(--s3) 0; }
.bx-list { border-top: 2rpx solid var(--hair); }
