<wxs src="../../utils/avatar.wxs" module="av" />
<view class="wrap">
  <hb-empty wx:if="{{view === 'loading'}}" image="loading" title="正在打开 PK…" />
  <hb-empty wx:elif="{{view === 'error'}}" image="fail" title="{{error || '加载失败'}}">
    <button class="btn btn-main" hover-class="hover" bindtap="load">再试一次</button>
    <view class="btn-text" hover-class="hover" bindtap="home">去对战首页</view>
  </hb-empty>
  <hb-empty wx:elif="{{view === 'expired'}}" image="empty" title="这场 PK 已经过期了" desc="PK 发起后 7 天内有效。">
    <button class="btn btn-main" hover-class="hover" bindtap="home">自己发起一场</button>
  </hb-empty>

  <!-- 没答过：接受挑战 -->
  <view wx:elif="{{view === 'invite'}}" class="pk-invite">
    <image class="res-bird" src="/assets/welcome.jpg" mode="aspectFill" />
    <view class="muted small">{{pk.isCreator ? '你发起的 PK' : '邀请你来 PK'}}</view>
    <view class="h1 one">{{pk.creator ? pk.creator.name : '同学'}}</view>
    <view wx:if="{{pk.creator && (pk.creator.school || pk.creator.className)}}" class="muted small">{{pk.creator.school}} {{pk.creator.className}}</view>
    <view class="pk-facts">第{{pk.level}}站 · 10 题 · {{ranking.length}} 人已参加</view>
    <view class="muted small">答对越多、用时越短，分越高。每人只算第一次。</view>
    <view class="btns"><button class="btn btn-main" hover-class="hover" bindtap="play">{{pk.isCreator ? '开始答题' : '接受挑战'}}</button></view>
    <view wx:if="{{pk.isCreator}}" class="muted small pk-tip">先自己答一遍，再发给同学。</view>
  </view>

  <!-- 答过：结果 -->
  <block wx:else>
    <view class="res">
      <image class="res-bird" src="/assets/{{my && my.place === 1 ? 'cheer' : 'pass'}}.jpg" mode="aspectFill" />
      <view class="muted small">第{{pk.level}}站 · {{ranking.length}} 人参加{{pk.expired ? ' · 已结束' : ''}}</view>
      <view class="res-n">{{my ? my.score : 0}}<text class="res-u"> 分</text></view>
      <view class="muted small">第 {{my ? my.place : '-'}} 名 · 答对 {{my ? my.correct : 0}}/10 · {{my ? my.time : ''}}</view>
      <view class="btns">
        <button wx:if="{{!pk.expired}}" class="btn btn-main" open-type="share" hover-class="hover">邀请同学来挑战</button>
        <view class="btn-text" hover-class="hover" bindtap="home">再发起一场</view>
      </view>
    </view>

    <view class="sec"><text class="sec-t">排名</text></view>
    <view class="bx-list">
      <view wx:for="{{ranking}}" wx:key="place" class="rk {{item.me ? 'me' : ''}}">
        <text class="rk-p {{item.place < 4 ? 'top' : ''}}">{{item.place}}</text>
        <image class="rk-av" src="{{av.of(item)}}" webp mode="aspectFill" />
        <view class="rk-main">
          <view class="rk-n">{{item.name}}{{item.me ? '（我）' : ''}}</view>
          <view class="rk-sub">{{item.school || '—'}} {{item.className}}</view>
        </view>
        <view class="rk-r">
          <view class="rk-s">{{item.score}}</view>
          <view class="rk-x">{{item.correct}}/10 · {{item.time}}</view>
        </view>
      </view>
    </view>

    <view class="sec"><text class="sec-t">我的答题</text></view>
    <view class="bx-list">
      <view wx:for="{{list}}" wx:key="no" class="bx-rv">
        <view class="bx-no">{{item.no}}</view>
        <view class="bx-main">
          <view wx:if="{{item.type === 'audio2ms'}}" class="bx-a">听音选词</view>
          <view wx:else class="bx-q {{item.type === 'ms2zh' ? 'ms' : ''}}">{{item.prompt}}</view>
          <view class="bx-a">我选：<text class="{{item.type === 'ms2zh' ? '' : 'ms'}}">{{item.pickedText || '没答'}}</text></view>
          <view wx:if="{{!item.ok && item.answerText}}" class="bx-a ok">答案：<text class="{{item.type === 'ms2zh' ? '' : 'ms'}}">{{item.answerText}}</text></view>
        </view>
        <say-btn wx:if="{{item.audio}}" src="{{item.audio}}" size="md" />
        <text class="bx-mark {{item.ok ? '' : 'bad'}}">{{item.ok ? '对' : '错'}}</text>
      </view>
    </view>
  </block>
</view>

<fx-confetti fire="{{cfFire}}" />
