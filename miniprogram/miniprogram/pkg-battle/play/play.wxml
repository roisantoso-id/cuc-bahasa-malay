<page-meta page-style="{{th.style}}" background-color="{{th.bg}}" background-text-style="{{th.day ? 'dark' : 'light'}}" />
<wxs src="../../utils/fit.wxs" module="fit" />
<view class="wrap">
  <hb-empty wx:if="{{view === 'loading'}}" image="loading" title="正在出题…" />
  <hb-empty wx:elif="{{view === 'error'}}" image="fail" title="{{error || '加载失败'}}">
    <button class="btn btn-main" hover-class="hover" bindtap="load">再试一次</button>
    <view class="btn-text" hover-class="hover" bindtap="back">返回</view>
  </hb-empty>
  <hb-empty wx:elif="{{view === 'submitting'}}" image="loading" title="正在交卷…" desc="用时 {{time}} 秒" />
  <hb-empty wx:elif="{{view === 'submitError'}}" image="fail" title="{{error || '交卷失败'}}" desc="答案还在，可以再交一次。">
    <button class="btn btn-main" hover-class="hover" bindtap="submit">再交一次</button>
    <view class="btn-text" hover-class="hover" bindtap="back">返回</view>
  </hb-empty>

  <!-- 答题 -->
  <block wx:elif="{{view === 'play'}}">
    <view class="bar"><view class="bar-in" style="width:{{(i + 1) / total * 100}}%" /></view>
    <view class="between pl-top">
      <text class="no">{{i + 1}} / {{total}}</text>
      <text class="no pl-clock">{{time}} 秒</text>
    </view>

    <view class="pl-q">
      <view class="muted small">{{q.kind}}</view>
      <view wx:if="{{q.type === 'audio2ms'}}" class="pl-listen">
        <view class="pl-play" hover-class="hover" bindtap="replay"><view class="pl-cone" /><view class="pl-wave" /></view>
        <view class="muted small">没听清就再点一下</view>
      </view>
      <view wx:else class="pl-prompt {{q.type === 'ms2zh' ? 'ms' : ''}}" style="{{q.type === 'ms2zh' ? 'font-size:' + fit.fs(q.prompt, 88, 600) + 'rpx' : ''}}">{{q.prompt}}</view>
    </view>

    <view>
      <view wx:for="{{q.options}}" wx:key="index" class="opt pl-opt {{picked === index ? 'on' : ''}} {{q.type === 'ms2zh' ? '' : 'ms'}}" hover-class="{{picked === -1 ? 'hover' : 'none'}}" data-k="{{index}}" bindtap="pick">{{item}}</view>
    </view>
    <view class="muted small center pl-tip">选了就不能改，对错交卷后再看</view>
  </block>

  <!-- 擂台成绩 -->
  <block wx:elif="{{view === 'result'}}">
    <view class="res">
      <image class="res-bird" src="/assets/{{result.last.correct === result.total ? 'cheer' : 'pass'}}.jpg" mode="aspectFill" />
      <view class="res-n">{{result.last.score}}<text class="res-u"> 分</text></view>
      <view class="muted small">答对 {{result.last.correct}}/{{result.total}} · 用时 {{result.lastTime}}</view>
    </view>
    <view class="stats mid">
      <view class="stat"><view class="stat-n">{{result.best.score}}</view><view class="stat-l">本周最好</view></view>
      <view class="stat"><view class="stat-n">{{result.place}}</view><view class="stat-l">全站名次</view></view>
      <view class="stat"><view class="stat-n">{{result.triesLeft}}</view><view class="stat-l">剩余次数</view></view>
    </view>
    <view class="btns">
      <button wx:if="{{result.triesLeft > 0}}" class="btn btn-main" hover-class="hover" bindtap="again">再打一次</button>
      <button wx:else class="btn btn-main" hover-class="hover" bindtap="toArena">看擂台排名</button>
      <view wx:if="{{result.triesLeft > 0}}" class="btn-text" hover-class="hover" bindtap="toArena">看擂台排名</view>
    </view>

    <view class="sec"><text class="sec-t">这次的答题</text><text wx:if="{{result.triesLeft > 0}}" class="sec-x">3 次用完后公布答案</text></view>
    <view class="bx-list">
      <view wx:for="{{list}}" wx:key="no" class="bx-rv">
        <view class="bx-no">{{item.no}}</view>
        <view class="bx-main">
          <view wx:if="{{item.type === 'audio2ms'}}" class="bx-a">听音选词</view>
          <view wx:else class="bx-q {{item.type === 'ms2zh' ? 'ms' : ''}}">{{item.prompt}}</view>
          <view class="bx-a">我选：<text class="{{item.type === 'ms2zh' ? '' : 'ms'}}">{{item.pickedText || '没答'}}</text></view>
          <view wx:if="{{!item.ok && item.answerText}}" class="bx-a ok">答案：<text class="{{item.type === 'ms2zh' ? '' : 'ms'}}">{{item.answerText}}</text></view>
        </view>
        <say-btn wx:if="{{item.audio}}" src="{{item.audio}}" size="md" />
        <text class="bx-mark {{item.ok ? '' : 'bad'}}">{{item.ok ? '对' : '错'}}</text>
      </view>
    </view>
  </block>
</view>

<fx-confetti fire="{{cfFire}}" />
