/* 关于老师：和全站同一片夜色，不另起一套颜色。人是一行一行的，不是卡片 */
.ab-prof { display: flex; align-items: center; gap: var(--s3); margin-top: var(--s4); }
.ab-photo { flex: none; width: 176rpx; height: 232rpx; border-radius: var(--r-sm); background: var(--panel); }
.ab-name { font-family: var(--f-zh); font-size: var(--t-title); font-weight: 700; line-height: 1.3; }
.ab-bio { margin-top: var(--s3); font-size: 28rpx; line-height: 1.75; color: var(--ink2); }

/* 书架：一行，左右滑（不出滚动条） */
.ab-shelf { width: 100%; white-space: nowrap; }
.ab-books { display: inline-flex; gap: var(--s3); padding: 0 var(--s4); }
.ab-book { width: 200rpx; white-space: normal; }
.ab-cover { display: block; width: 200rpx; height: 296rpx; border-radius: 8rpx; background: var(--panel); }
.ab-bt { margin-top: var(--s2); font-size: 26rpx; font-weight: 600; line-height: 1.35; }

.ab-top { padding-bottom: 0; }
.ab-rest { padding-top: 0; padding-bottom: 96rpx; }
.ab-team { border-top: 2rpx solid var(--hair); }
.ab-person { display: flex; align-items: flex-start; gap: var(--s3); padding: var(--s3) 0; border-bottom: 2rpx solid var(--hair); }
.ab-avatar { width: 96rpx; height: 96rpx; }
.ab-pn { font-size: var(--t-section); font-weight: 600; }
.ab-pd { margin-top: var(--s1); font-size: 26rpx; line-height: 1.7; color: var(--ink2); }
.ab-live { margin-bottom: var(--s2); }
.ab-live-img { display: block; width: 100%; border-radius: var(--r-sm); }
.ab-live-cap { padding: var(--s2) 0; }
.ab-foot { margin-top: var(--s5); }
