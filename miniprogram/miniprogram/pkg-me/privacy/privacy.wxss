.pv { padding-bottom: 64rpx; }
.pv-hero { position: relative; padding: 16rpx 200rpx 24rpx 0; }
.pv-bird { position: absolute; right: -8rpx; top: 0; width: 190rpx; height: 196rpx; }
.pv-h1 { font-family: "Songti SC", "STSong", serif; font-size: 48rpx; font-weight: 900; line-height: 1.3; color: var(--ivory); }
.pv-hl { color: var(--star); }
.pv-upd { font-size: 22rpx; color: var(--ink2); margin-top: 10rpx; }
/* 三条承诺：唯一的面板，是这页的重点 */
.pv-promise { margin-top: 16rpx; padding: 8rpx 28rpx; border-radius: 32rpx; background: var(--panel); border: 2rpx solid rgba(233,185,97,.35); }
.pv-pr { display: flex; align-items: flex-start; gap: 20rpx; padding: 22rpx 0; border-bottom: 2rpx solid var(--hair); }
.pv-pr:last-child { border-bottom: 0; }
.pv-n { flex: none; width: 48rpx; height: 48rpx; line-height: 48rpx; border-radius: 50%; text-align: center; font-family: Georgia, serif; font-weight: 700; font-size: 26rpx; color: var(--dark-ink); background: var(--star); }
.pv-pr-t { font-size: 30rpx; font-weight: 800; color: var(--ivory); line-height: 1.4; }
.pv-pr-d { font-size: 24rpx; color: var(--ink2); margin-top: 4rpx; }
/* 清单行：内容 · 用途 · 右侧标签 */
.pv-list { border-top: 2rpx solid var(--hair); }
.pv-row { display: flex; align-items: center; gap: 16rpx; padding: 20rpx 0; border-bottom: 2rpx solid var(--hair); }
.pv-main { flex: 1; min-width: 0; }
.pv-k { font-size: 28rpx; font-weight: 700; color: var(--ivory); }
.pv-v { font-size: 24rpx; color: var(--ink2); margin-top: 4rpx; line-height: 1.45; }
.pv-tag { flex: none; font-size: 22rpx; font-weight: 700; padding: 6rpx 16rpx; border-radius: 999rpx; white-space: nowrap; }
.pv-tag.must { color: var(--ivory); background: rgba(243,234,214,.12); }
.pv-tag.opt { color: var(--ok); background: rgba(143,192,160,.15); }
.pv-tag.none { color: var(--star); background: rgba(233,185,97,.14); }
.pv-tag.see { color: var(--star); background: rgba(233,185,97,.14); }
.pv-tag.teach { color: #9cc9e6; background: rgba(156,201,230,.14); }
.pv-tag.self { color: var(--ok); background: rgba(143,192,160,.15); }
.pv-p { font-size: 26rpx; line-height: 1.6; color: var(--ivory); margin-bottom: 12rpx; }
.pv-acts { margin-top: 48rpx; }
.pv-del-d { text-align: center; font-size: 22rpx; color: var(--ink2); margin: 12rpx 0 28rpx; }
