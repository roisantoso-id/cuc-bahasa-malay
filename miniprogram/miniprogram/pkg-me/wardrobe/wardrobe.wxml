<view class="wrap">
  <hb-empty wx:if="{{view === 'loading'}}" image="loading" title="正在打开衣柜…" />
  <hb-empty wx:elif="{{view === 'error'}}" image="fail" title="{{error}}"><button class="btn btn-main" hover-class="hover" bindtap="load">再试一次</button></hb-empty>
  <block wx:else>
    <!-- 当前形象 -->
    <view class="wd-now">
      <lv-avatar src="{{curImg}}" size="{{176}}" level="{{lv.level}}" pct="{{lv.pct}}" />
      <view class="wd-now-main">
        <view class="wd-now-t">{{curTitle || '原版犀鸟'}}</view>
        <view class="muted small">L{{lv.level}} · 这一站学了 {{lv.pct}}% · 排行榜和 PK 里用这个头像</view>
      </view>
    </view>

    <view class="sec"><text class="sec-t">服装</text><text class="sec-r">已解锁 {{costumeN}} / {{costumes.length}}</text></view>
    <view class="wd-grid">
      <view class="wd-it {{!mascot ? 'on' : ''}}" bindtap="pick" data-k="">
        <view class="wd-box"><image class="wd-img" src="/assets/avatar.jpg" mode="aspectFill" /></view>
        <view class="wd-t">原版犀鸟</view>
      </view>
      <view wx:for="{{costumes}}" wx:key="key" class="wd-it {{item.unlocked ? '' : 'lock'}} {{mascot === item.key ? 'on' : ''}}" data-i="{{index}}" data-g="costumes" bindtap="open">
        <view class="wd-box"><image class="wd-img" src="{{item.img}}" webp mode="aspectFit" /></view>
        <view class="wd-t">{{item.short}}</view>
        <view class="wd-lock">{{item.unlocked ? (mascot === item.key ? '正在穿' : '已解锁') : item.how}}</view>
        <view wx:if="{{!item.unlocked}}" class="wd-lk">未解锁</view>
      </view>
    </view>

    <view class="sec"><text class="sec-t">徽章</text><text class="sec-r">已获得 {{badgeN}} / {{badges.length}}</text></view>
    <view class="wd-grid badges">
      <view wx:for="{{badges}}" wx:key="key" class="wd-it {{item.unlocked ? '' : 'lock'}}" data-i="{{index}}" data-g="badges" bindtap="open">
        <view class="wd-box round"><image class="wd-img" src="{{item.img}}" webp mode="aspectFill" /></view>
        <view class="wd-t">{{item.title}}</view>
      </view>
    </view>
  </block>
</view>

<!-- 点任何一件都能放大看；解锁了可以直接换上 -->
<view wx:if="{{pv}}" class="wd-mask {{pvOn ? 'on' : ''}}" catchtouchmove="noop" bindtap="close">
  <view class="wd-pv {{pvOn ? 'on' : ''}}" catchtap="noop">
    <image class="wd-pv-img {{pv.type === 'badge' ? 'round' : ''}}" src="{{pv.img}}" webp mode="aspectFill" />
    <view class="wd-pv-t">{{pv.title}}</view>
    <view class="wd-pv-d {{pv.unlocked ? 'ok' : ''}}">{{pv.unlocked ? (pv.type === 'badge' ? '已获得' : (mascot === pv.key ? '正在穿' : '已解锁')) : pv.desc}}</view>
    <view wx:if="{{pv.type === 'costume' && pv.unlocked && mascot !== pv.key}}" class="btn btn-main wd-pv-b" hover-class="hover" data-k="{{pv.key}}" bindtap="wear">换上</view>
    <view wx:else class="btn btn-ghost wd-pv-b" hover-class="hover" bindtap="close">{{pv.unlocked ? '好的' : '继续加油'}}</view>
  </view>
</view>
