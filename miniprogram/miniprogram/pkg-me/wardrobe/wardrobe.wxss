.wd-now { display: flex; align-items: center; gap: 24rpx; padding: 24rpx 0 8rpx; }
.wd-now-t { font-size: 34rpx; font-weight: 800; color: var(--ivory); margin-bottom: 6rpx; }
.wd-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24rpx 16rpx; margin-top: 16rpx; }
.wd-it { display: flex; flex-direction: column; align-items: center; min-width: 0; }
/* 服装图是米白底全身像：外框同色、留一圈边，整只鸟都看得到（不裁头尾）；没解锁也是彩色，只在角上放一把小锁 */
.wd-it { position: relative; }
.wd-box { width: 100%; height: 218rpx; border-radius: 24rpx; background: #f8f1e9; overflow: hidden; display: flex; align-items: center; justify-content: center; box-sizing: border-box; }
.wd-img { display: block; width: 200rpx; height: 200rpx; }
.wd-it.on .wd-box { box-shadow: 0 0 0 5rpx var(--star); }
.wd-lk { position: absolute; top: 10rpx; right: 10rpx; padding: 0 12rpx; height: 34rpx; line-height: 34rpx; border-radius: 999rpx; background: rgba(10,31,34,.72); color: var(--ivory); font-size: 20rpx; }
.wd-t { margin-top: 10rpx; font-size: 24rpx; color: var(--ivory); text-align: center; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.wd-it.lock .wd-t { color: var(--ink2); }
.wd-lock { font-size: 20rpx; color: var(--ink2); text-align: center; line-height: 1.35; margin-top: 2rpx; }
.wd-box.round { border-radius: 50%; width: 200rpx; height: 200rpx; background: var(--ivory); }
.wd-box.round .wd-img { width: 100%; height: 100%; }
.wd-it.lock .wd-box.round { opacity: .45; }

.wd-mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 300; display: flex; align-items: center; justify-content: center; background: rgba(5,16,18,0); transition: background-color .22s; }
.wd-mask.on { background: rgba(5,16,18,.72); }
.wd-pv { width: 560rpx; padding: 40rpx 40rpx 36rpx; border-radius: 36rpx; background: #10292d; border: 2rpx solid var(--hair); display: flex; flex-direction: column; align-items: center; transform: scale(.86); opacity: 0; transition: transform .3s cubic-bezier(.3,1.4,.5,1), opacity .2s; }
.wd-pv.on { transform: none; opacity: 1; }
.wd-pv-img { width: 420rpx; height: 420rpx; border-radius: 32rpx; background: var(--ivory); }
.wd-pv-img.round { border-radius: 50%; }
.wd-pv-t { margin-top: 28rpx; font-size: 36rpx; font-weight: 800; color: var(--ivory); text-align: center; }
.wd-pv-d { margin-top: 8rpx; font-size: 26rpx; color: var(--ink2); text-align: center; }
.wd-pv-d.ok { color: var(--star); }
.wd-pv-b { margin-top: 32rpx; align-self: stretch; }
