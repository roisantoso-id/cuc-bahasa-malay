.wd-now { display: flex; align-items: center; gap: 24rpx; padding: 24rpx 0 8rpx; }
.wd-now-t { font-size: 34rpx; font-weight: 800; color: var(--ivory); margin-bottom: 6rpx; }
.wd-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24rpx 16rpx; margin-top: 16rpx; }
.wd-it { display: flex; flex-direction: column; align-items: center; min-width: 0; }
/* 服装图是米白底全身像：外框同色、留一圈边，整只鸟都看得到（不裁头尾）；没解锁也是彩色，只在角上放一把小锁 */
.wd-it { position: relative; }
.wd-box { width: 100%; height: 218rpx; border-radius: 24rpx; background: #f8f1e9; overflow: hidden; display: flex; align-items: center; justify-content: center; box-sizing: border-box; }
.wd-img { display: block; width: 200rpx; height: 200rpx; }
.wd-it.on .wd-box { box-shadow: 0 0 0 5rpx var(--star); }
.wd-lk { position: absolute; top: 10rpx; right: 10rpx; padding: 0 12rpx; height: 34rpx; line-height: 34rpx; border-radius: 999rpx; background: rgba(10,31,34,.72); color: var(--ivory); font-size: 20rpx; }
.wd-t { margin-top: 10rpx; font-size: 24rpx; color: var(--ivory); text-align: center; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.wd-it.lock .wd-t { color: var(--ink2); }
.wd-lock { font-size: 20rpx; color: var(--ink2); text-align: center; line-height: 1.35; margin-top: 2rpx; }
/* 徽章轨道 */
.wd-tr { margin-top: 16rpx; padding: 28rpx 24rpx 20rpx; border-radius: 32rpx; background: var(--panel); }
.wd-tr-h { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; }
.wd-tr-t { font-size: 30rpx; font-weight: 700; color: var(--ivory); flex: none; }
.wd-tr-n { font-size: 22rpx; color: var(--ink2); text-align: right; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.wd-tr-n.hot { color: var(--star); }
.wd-tr-a { position: relative; display: flex; justify-content: space-between; margin-top: 24rpx; }
.wd-tr-line { position: absolute; left: 48rpx; right: 48rpx; top: 46rpx; height: 6rpx; border-radius: 3rpx; background: var(--hair); overflow: hidden; }
.wd-tr-fill { height: 100%; background: var(--star); border-radius: 3rpx; transition: width .6s cubic-bezier(.34,1.56,.64,1); }
.wd-nd { position: relative; width: 96rpx; display: flex; flex-direction: column; align-items: center; }
.wd-nd-c { width: 84rpx; height: 84rpx; margin: 6rpx 0; border-radius: 50%; box-sizing: border-box; background: var(--night); border: 3rpx solid var(--hair); overflow: hidden; }
.wd-nd-c.got { width: 96rpx; height: 96rpx; margin: 0; border: 5rpx solid var(--star); }
.wd-nd-c.next { border: 3rpx dashed var(--star); }
.wd-nd-img { display: block; width: 100%; height: 100%; opacity: .22; }
.wd-nd-c.got .wd-nd-img { opacity: 1; }
.wd-nd-c.next .wd-nd-img { opacity: .5; }
.wd-nd-l { margin-top: 10rpx; font-size: 20rpx; color: var(--ink2); white-space: nowrap; }
.wd-nd-l.got { color: var(--ivory); font-weight: 600; }
.wd-nd-l.next { color: var(--star); font-weight: 600; }
.wd-mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 300; display: flex; align-items: center; justify-content: center; background: rgba(5,16,18,0); transition: background-color .22s; }
.wd-mask.on { background: rgba(5,16,18,.72); }
.wd-pv { position: relative; width: 640rpx; padding: 40rpx 40rpx 40rpx; border-radius: 40rpx; background: #10292d; border: 2rpx solid var(--hair); display: flex; flex-direction: column; align-items: center; box-sizing: border-box; transform: translateY(40rpx) scale(.9); opacity: 0; transition: transform .34s cubic-bezier(.3,1.4,.5,1), opacity .2s; }
.wd-pv.on { transform: none; opacity: 1; }
.wd-x { position: absolute; top: 20rpx; right: 20rpx; width: 56rpx; height: 56rpx; border-radius: 50%; background: rgba(243,234,214,.08); }
.wd-x-l { position: absolute; left: 16rpx; top: 27rpx; width: 24rpx; height: 3rpx; border-radius: 2rpx; background: var(--ivory); transform: rotate(45deg); }
.wd-x-l.r { transform: rotate(-45deg); }
.wd-pill { padding: 6rpx 24rpx; border-radius: 999rpx; font-size: 24rpx; font-weight: 700; background: rgba(243,234,214,.1); color: var(--star); margin-bottom: 24rpx; }
.wd-pill.win { background: var(--star); color: #0a1f22; }
.wd-pill.badge { background: var(--ok); color: #0a1f22; }
.wd-pv-stage { display: flex; align-items: center; gap: 12rpx; }
.wd-pv-box { position: relative; width: 400rpx; height: 400rpx; border-radius: 32rpx; background: #f8f1e9; display: flex; align-items: center; justify-content: center; }
.wd-pv-box.round { border-radius: 50%; background: var(--ivory); width: 340rpx; height: 340rpx; margin: 30rpx; }
.wd-pv-box.dim .wd-pv-img { opacity: .9; }
.wd-pv-box.round.dim { opacity: .45; }
.wd-pv-img { width: 372rpx; height: 372rpx; border-radius: 32rpx; }
.wd-pv-box.round .wd-pv-img { width: 100%; height: 100%; border-radius: 50%; }
.wd-pv-box.hop { animation: wdhop .6s cubic-bezier(.3,1.6,.5,1) both; }
.wd-pv-box.stamp { animation: wdstamp .5s cubic-bezier(.3,1.6,.5,1) both; }
.wd-pv-box.rise { animation: wdrise .35s cubic-bezier(.2,.7,.2,1) both; }
@keyframes wdhop { 0% { transform: translateY(30rpx) scale(.8); } 55% { transform: translateY(-20rpx) scale(1.05, .96); } 100% { transform: none; } }
@keyframes wdstamp { 0% { transform: scale(1.9) rotate(-18deg); opacity: 0; } 70% { transform: scale(.94) rotate(3deg); opacity: 1; } 100% { transform: none; } }
@keyframes wdrise { from { transform: translateY(16rpx); opacity: 0; } to { transform: none; opacity: 1; } }
.wd-nav { width: 56rpx; height: 56rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: rgba(243,234,214,.08); flex: none; }
.wd-nav.off { opacity: .2; pointer-events: none; }
.wd-chev { width: 14rpx; height: 14rpx; border-left: 3rpx solid var(--ivory); border-bottom: 3rpx solid var(--ivory); transform: translateX(3rpx) rotate(45deg); }
.wd-nav.r .wd-chev { transform: translateX(-3rpx) rotate(-135deg); }
.wd-pv-t { margin-top: 28rpx; font-size: 40rpx; font-weight: 800; color: var(--ivory); text-align: center; font-family: var(--f-zh); }
.wd-pv-ms { margin-top: 4rpx; font-size: 26rpx; color: var(--ink2); font-family: var(--f-ms); font-style: italic; }
.wd-story { margin-top: 16rpx; font-size: 26rpx; line-height: 1.6; color: var(--ivory); opacity: .88; text-align: center; }
.wd-how { margin-top: 16rpx; font-size: 24rpx; color: var(--star); text-align: center; }
.wd-pg { align-self: stretch; height: 12rpx; margin-top: 28rpx; border-radius: 999rpx; background: var(--hair); overflow: hidden; }
.wd-pg-f { height: 100%; border-radius: 999rpx; background: var(--star); animation: wdgrow .9s cubic-bezier(.34,1.2,.64,1) .15s both; transform-origin: left; }
@keyframes wdgrow { from { transform: scaleX(0); } to { transform: scaleX(1); } }
.wd-pg-n { align-self: stretch; display: flex; justify-content: space-between; margin-top: 10rpx; font-size: 22rpx; color: var(--ink2); }
.wd-pv-b { margin-top: 32rpx; align-self: stretch; }
