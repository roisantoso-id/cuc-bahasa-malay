.prompt { font-size: 36rpx; font-weight: 700; line-height: 1.45; margin-bottom: 24rpx; }
.tf { display: flex; gap: 20rpx; }
.tf .opt { flex: 1; text-align: center; }
.opt { background: #fff; border: 2rpx solid #d9d4c8; border-radius: 8rpx; padding: 24rpx 28rpx; font-weight: 800; margin-bottom: 20rpx; }
.opt.on { border-color: #3c5a8a; background: #eceff5; }
.label { font-size: 26rpx; font-weight: 800; margin-bottom: 12rpx; }
.field { margin-bottom: 24rpx; }
.input { background: #fff; border: 2rpx solid #d9d4c8; border-radius: 8rpx; padding: 0 24rpx; height: 92rpx; font-size: 32rpx; }
