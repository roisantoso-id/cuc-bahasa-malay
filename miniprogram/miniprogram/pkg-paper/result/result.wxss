.head { text-align: center; }
.img { width: 260rpx; height: 260rpx; display: block; margin: 0 auto; }
.score { font-size: 32rpx; color: var(--ink2); margin-bottom: 12rpx; }
.big { font-size: 96rpx; font-weight: 700; }
.big.ok { color: var(--green); } .big.no { color: var(--coral); }
.okc { color: var(--green-d); } .noc { color: #8a2f21; }
.q-ok { border-color: #d9d4c8; } .q-no { border-color: #e3c9c4; }
.prompt { font-weight: 800; margin: 12rpx 0; }
.exp { margin-top: 12rpx; padding: 14rpx 18rpx; background: #f3eee2; border-radius: 8rpx; }
