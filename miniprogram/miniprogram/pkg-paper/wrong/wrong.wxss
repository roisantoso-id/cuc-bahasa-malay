.seg { display: flex; background: #f0f0ea; border-radius: 24rpx; padding: 8rpx; margin-bottom: 24rpx; }
.seg-i { flex: 1; text-align: center; padding: 16rpx 0; border-radius: 18rpx; font-weight: 900; color: var(--ink2); }
.seg-i.on { background: #fff; color: var(--ink); box-shadow: 0 4rpx 0 var(--line); }
.prompt { font-weight: 800; margin: 12rpx 0 16rpx; }
.fb { margin-top: 24rpx; padding: 20rpx 24rpx; border-radius: 24rpx; }
.fb.ok { background: var(--green-l); color: var(--green-d); }
.fb.no { background: #ffe9e6; color: #d94a3a; }
