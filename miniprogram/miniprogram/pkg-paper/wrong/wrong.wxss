.seg { display: flex; background: #ece8df; border-radius: 8rpx; padding: 8rpx; margin-bottom: 24rpx; }
.seg-i { flex: 1; text-align: center; padding: 16rpx 0; border-radius: 8rpx; font-weight: 700; color: var(--ink2); }
.seg-i.on { background: #fff; color: var(--ink); }
.prompt { font-weight: 800; margin: 12rpx 0 16rpx; }
.fb { margin-top: 24rpx; padding: 20rpx 24rpx; border-radius: 8rpx; }
.fb.ok { background: var(--green-l); color: var(--green-d); }
.fb.no { background: #f6e9e6; color: #8a2f21; }
