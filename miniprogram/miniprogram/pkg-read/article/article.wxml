<view class="wrap">
  <hb-empty wx:if="{{loading}}" image="loading" title="正在加载…" />
  <hb-empty wx:elif="{{error === 'notfound'}}" image="empty" title="文章不存在或已下架"><button class="btn btn-main" hover-class="hover" bindtap="back">返回文章列表</button></hb-empty>
  <hb-empty wx:elif="{{error}}" image="empty" title="文章加载失败"><button class="btn btn-main" hover-class="hover" bindtap="load">重新加载</button></hb-empty>
  <block wx:else>
    <view class="row" style="gap:8rpx;flex-wrap:wrap"><text wx:for="{{a.categories}}" wx:key="id" class="tag">{{item.name}}</text></view>
    <view class="h1" style="margin-top:12rpx">{{a.title}}</view>
    <view wx:if="{{a.summary}}" class="muted" style="margin-top:8rpx">{{a.summary}}</view>
    <view class="muted small" style="margin-top:12rpx">{{a.author.nickname || 'JomBelajar 编辑'}} · 发布于 {{a.date}}</view>

    <view wx:if="{{a.readingAudioResourceId}}" class="player">
      <view class="play" hover-class="hover" bindtap="toggle" aria-role="button" aria-label="{{playing ? '暂停朗读' : '播放朗读'}}">
        <view wx:if="{{playing}}" class="pause"><view /><view /></view>
        <view wx:else class="tri" />
      </view>
      <view class="item-main">
        <view class="small ms">文章朗读</view>
        <slider min="0" max="{{dur || 1}}" value="{{pos}}" activeColor="#2fae66" block-size="16" bindchange="seek" style="margin:4rpx 0" />
        <view class="muted small">{{posText}} / {{durText}}</view>
      </view>
    </view>

    <view class="body">
      <rich-text wx:if="{{html}}" nodes="{{html}}" user-select />
      <view wx:else class="muted">文章正文暂时不可用。</view>
    </view>
  </block>
</view>
