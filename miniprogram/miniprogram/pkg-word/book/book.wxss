.tabs { display: flex; background: #fff; border-bottom: 2rpx solid var(--line); position: sticky; top: 0; z-index: 2; }
.tab { flex: 1; text-align: center; padding: 24rpx 0; font-weight: 800; color: var(--ink2); border-bottom: 6rpx solid transparent; }
.tab.on { color: var(--ink); border-bottom-color: var(--green); }
.head { margin-bottom: 20rpx; }
.one { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.star { font-size: 40rpx; color: var(--line); padding: 0 8rpx; }
.star.on { color: #e0a800; }
