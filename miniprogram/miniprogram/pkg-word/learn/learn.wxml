<view class="page">
  <hb-empty wx:if="{{view === 'loading'}}" image="loading" title="正在准备单词…" />
  <hb-empty wx:elif="{{view === 'error'}}" image="empty" title="{{error || '加载失败'}}"><button class="btn btn-main" hover-class="hover" bindtap="back">返回</button></hb-empty>
  <hb-empty wx:elif="{{view === 'empty'}}" image="cheer" title="这里暂时没有要学的词" desc="都学过了，到期的词会自动出现在复习里。"><button class="btn btn-main" hover-class="hover" bindtap="back">返回</button></hb-empty>

  <!-- 词卡 -->
  <block wx:elif="{{view === 'card'}}">
    <view class="top">
      <view class="bar"><view class="bar-in" style="width:{{idx / total * 100}}%" /></view>
      <view class="top-r"><text class="muted small">{{idx}} / {{total}}</text><text class="tag {{card.mode === 'review' ? 'blue' : ''}}">{{card.mode === 'review' ? '复习' : '新词'}}</text></view>
    </view>
    <view class="card-big" bindtap="flip">
      <view class="w">{{card.ms}}</view>
      <view class="sound" catchtap="play">▶ 发音</view>
      <block wx:if="{{flipped}}">
        <view class="zh">{{card.zh}}<text class="pos">{{card.pos}}</text></view>
        <view class="ex">
          <view class="ex-ms">{{card.example_ms}}</view>
          <view class="ex-zh">{{card.example_zh}}</view>
        </view>
      </block>
      <view wx:else class="hint">先想一想它是什么意思，再点卡片看答案</view>
    </view>
    <view class="actions">
      <block wx:if="{{flipped}}">
        <view class="grades">
          <view class="g g-forgot" hover-class="hover" data-r="forgot" bindtap="grade">不认识</view>
          <view class="g g-vague" hover-class="hover" data-r="vague" bindtap="grade">模糊</view>
          <view class="g g-know" hover-class="hover" data-r="know" bindtap="grade">认识</view>
        </view>
        <view class="master" data-r="mastered" bindtap="grade">太简单了，设为已掌握</view>
      </block>
      <button wx:else class="btn btn-main" hover-class="hover" bindtap="flip">看答案</button>
    </view>
  </block>

  <!-- 小测 -->
  <block wx:elif="{{view === 'quiz'}}">
    <view class="top"><view class="quiz-k">小测一下 · {{quiz.askMs ? '选出中文意思' : '选出马来语'}}</view></view>
    <view class="quiz-p {{quiz.askMs ? 'ms' : ''}}">{{quiz.prompt}}</view>
    <view class="opts">
      <view wx:for="{{quiz.options}}" wx:key="*this" class="opt {{picked && item === quiz.answer ? 'right' : ''}} {{picked === item && item !== quiz.answer ? 'wrong' : ''}}" data-o="{{item}}" bindtap="pick">{{item}}</view>
    </view>
  </block>

  <!-- 结束 -->
  <view wx:elif="{{view === 'done'}}" class="done">
    <image class="done-img" src="/assets/cheer.jpg" mode="aspectFit" />
    <view class="h1 center">这一组完成了</view>
    <view class="sum">
      <view><view class="n c-know">{{stats.know}}</view>认识</view>
      <view><view class="n c-vague">{{stats.vague}}</view>模糊</view>
      <view><view class="n c-forgot">{{stats.forgot}}</view>不认识</view>
      <view><view class="n">{{stats.mastered}}</view>已掌握</view>
    </view>
    <view class="muted small center">不认识和模糊的词，明天会出现在复习里。</view>
    <view class="btns">
      <button class="btn btn-main" hover-class="hover" bindtap="again">再学一组</button>
      <button class="btn btn-ghost" hover-class="hover" bindtap="back">返回</button>
    </view>
  </view>
</view>
