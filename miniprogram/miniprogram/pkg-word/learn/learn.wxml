<page-meta page-style="{{th.style}}" background-color="{{th.bg}}" background-text-style="{{th.day ? 'dark' : 'light'}}" />
<wxs src="../../utils/fit.wxs" module="fit" />
<wxs module="u">module.exports = { L: ['A', 'B', 'C', 'D'] }</wxs>
<view class="ln-page">
  <hb-empty wx:if="{{view === 'loading'}}" image="loading" title="正在准备单词…" />
  <hb-empty wx:elif="{{view === 'error'}}" image="fail" title="{{error || '加载失败'}}"><button class="btn btn-main" hover-class="hover" bindtap="back">返回</button></hb-empty>
  <hb-empty wx:elif="{{view === 'empty'}}" image="cheer" title="这里暂时没有要学的词" desc="到期的词会自动出现在复习里。"><button class="btn btn-main" hover-class="hover" bindtap="back">返回</button></hb-empty>

  <block wx:elif="{{view === 'card' || view === 'quiz'}}">
  <!-- 白天：旅行手账版（设计稿 A2 词卡 / A3 小测） -->
  <view wx:if="{{th.day}}" class="dA dA-ln">
    <view class="dA-ln-top">
      <view class="dA-ln-x" hover-class="hover" bindtap="back">×</view>
      <view wx:if="{{view === 'quiz' && qp.list}}" class="dA-ln-pips"><view wx:for="{{qp.list}}" wx:key="index" class="dA-ln-pip {{index === qp.cur ? (picked ? (fbOk ? 'dA-ln-pip-y' : 'dA-ln-pip-n') : 'dA-ln-pip-c') : (item ? 'dA-ln-pip-' + item : '')}}" /></view>
      <view wx:else class="dA-ln-prog"><view class="dA-ln-prog-i" style="width:{{idx / total * 100}}%" /></view>
      <text wx:if="{{view === 'card' || !qp.list}}" class="dA-ln-no">{{idx}} / {{total}}</text>
    </view>

    <block wx:if="{{view === 'card'}}">
      <view class="dA-card dA-ln-card {{fly ? 'dA-ln-fly-' + fly : ''}}" style="transform: translate({{dx}}px, {{dy < 0 ? dy : dy * 0.25}}px) rotate({{dx / 18}}deg); transition: {{drag ? 'none' : 'transform .28s ease, opacity .28s'}};">
        <!-- 正面 + 虚线：点一下翻面，左右上滑打分（释义那块只管上下滚） -->
        <view class="dA-ln-ft" bindtap="flip" bindtouchstart="tStart" bindtouchmove="tMove" bindtouchend="tEnd" bindtouchcancel="tEnd">
          <view class="dA-ln-f {{flipped ? 'dA-ln-f-open' : ''}}">
            <view class="dA-ln-m"><text class="dA-ln-m-l">№ {{card.rank}}{{card.level ? ' · T' + card.level : ''}}</text><text class="dA-ln-m-r">{{wrongShown ? '刚才答错' : card.first ? '初次见面' : card.again ? '再来一次' : card.kind === 'review' ? '复习' : '第 ' + (card.seen || 2) + ' 次见'}}</text></view>
            <view class="dA-ln-w" style="font-size:{{flipped ? fit.fs(card.ms, 96, 560) : fit.fs(card.ms, 132, 560)}}rpx">{{card.ms}}</view>
            <view class="dA-ln-spk" hover-class="hover" catchtap="play"><view class="dA-ln-cone" /><view class="dA-ln-wave" /><text>再听一遍</text></view>
          </view>
          <view class="dA-ln-seam"><view class="dA-ln-dash" /><text class="dA-ln-seam-t">{{flipped ? '背面' : '点一下翻面'}}</text><view class="dA-ln-dash" /></view>
        </view>
        <scroll-view wx:if="{{flipped}}" scroll-y class="dA-ln-b">
          <view class="dA-ln-bin">
            <view wx:for="{{card.senses}}" wx:key="index" class="dA-ln-sn">
              <view class="dA-ln-mean"><text wx:if="{{item.pos}}" class="dA-ln-pos">{{item.pos}}</text><text class="dA-ln-zh">{{item.zh}}</text></view>
              <view wx:if="{{item.exMs}}" class="dA-ln-ex">
                <view class="dA-ln-ex-ms"><text wx:for="{{item.parts}}" wx:for-item="p" wx:key="index" class="{{p.hit ? 'dA-ln-mark' : ''}}">{{p.t}}</text></view>
                <view class="dA-ln-ex-zh">{{item.exZh}}</view>
              </view>
            </view>
            <view wx:if="{{card.root}}" class="dA-ln-root"><text>词根</text><text class="dA-ln-root-w">{{card.root}}</text></view>
            <view class="dA-ln-fav-row"><view class="dA-ln-fav-wrap"><view class="dA-ln-fav {{card.fav ? 'dA-ln-fav-on' : ''}}" catchtap="fav"><image class="dA-ln-fav-i" src="/assets/fx/{{card.fav ? 'star-amber' : 'star-line-day'}}.svg" />{{card.fav ? '已收藏' : '收藏'}}</view><fx-burst fire="{{favFx}}" /></view></view>
          </view>
        </scroll-view>
      </view>
      <view class="dA-ln-grow" />
      <view class="dA-ln-act">
        <block wx:if="{{flipped}}">
          <view class="dA-ln-grade">
            <view class="dA-ln-g {{hint === 'forgot' ? 'dA-ln-g-on' : ''}}" hover-class="hover" data-r="forgot" bindtap="grade">不认识<text class="dA-ln-gh">{{card.hints.forgot}}</text></view>
            <view class="dA-ln-g {{hint === 'vague' ? 'dA-ln-g-on' : ''}}" hover-class="hover" data-r="vague" bindtap="grade">模糊<text class="dA-ln-gh">{{card.hints.vague}}</text></view>
            <view class="dA-ln-g dA-ln-g-ok {{hint === 'know' ? 'dA-ln-g-on' : ''}}" hover-class="hover" data-r="know" bindtap="grade">认识<text class="dA-ln-gh">{{card.hints.know}}</text></view>
          </view>
          <view wx:if="{{card.kind === 'new'}}" class="dA-ln-link" hover-class="hover" data-r="mastered" bindtap="grade">太简单了，设为已掌握</view>
        </block>
        <button wx:else class="dA-btn" hover-class="hover" bindtap="flip">翻面看释义</button>
      </view>
    </block>

    <view wx:else class="dA-ln-q">
      <view class="dA-eb">{{quiz.type === 'ms2zh' ? '看词选义' : quiz.type === 'listen' ? '听音选词' : quiz.type === 'zh2ms' ? '看义选词' : quiz.type === 'cloze' ? '例句补全' : '拼写'}} · 第 {{qp.cur + 1}} / {{qp.n}} 题{{quiz.graded ? '' : ' · 小练习'}}</view>
      <view wx:if="{{quiz.type === 'listen'}}" class="dA-ln-listen"><say-btn src="{{quiz.word.audio}}" size="lg" tone="big" /><text class="dA-ln-tr">没听清就再点一下</text></view>
      <block wx:elif="{{quiz.type === 'cloze'}}">
        <view class="dA-ln-sent">{{quiz.cloze.before}}<text class="dA-ln-blank">{{picked ? quiz.answer : '　'}}</text>{{quiz.cloze.after}}</view>
        <view class="dA-ln-tr">{{quiz.cloze.zh}}</view>
      </block>
      <view wx:elif="{{quiz.type === 'ms2zh'}}" class="dA-ln-pw" style="font-size:{{fit.fs(quiz.prompt, 108, 660)}}rpx">{{quiz.prompt}}</view>
      <view wx:else class="dA-ln-pz">{{quiz.prompt}}</view>

      <block wx:if="{{quiz.type === 'spell'}}">
        <input class="dA-ln-spell {{picked ? (picked === quiz.answer ? 'dA-ln-spell-y' : 'dA-ln-spell-n') : ''}}" placeholder-class="dA-ln-ph" value="{{typed}}" placeholder="{{quiz.hint}}" focus confirm-type="done" bindinput="typing" bindconfirm="checkSpell" disabled="{{!!picked}}" />
        <view wx:if="{{picked && picked !== quiz.answer}}" class="dA-ln-tr">正确答案：<text class="dA-ln-ans">{{quiz.answer}}</text></view>
        <button wx:if="{{!picked}}" class="dA-btn dA-ln-ok" hover-class="hover" bindtap="checkSpell">确定</button>
      </block>
      <view wx:else class="dA-ln-opts">
        <view wx:for="{{quiz.options}}" wx:key="*this" class="dA-ln-opt {{quiz.type === 'ms2zh' ? 'dA-ln-opt-zh' : ''}} {{picked && item === quiz.answer ? 'dA-ln-opt-y' : ''}} {{picked === item && item !== quiz.answer ? 'dA-ln-opt-n' : ''}} {{picked && item !== quiz.answer && picked !== item ? 'dA-ln-opt-dim' : ''}}" data-o="{{item}}" bindtap="pick">
          <text class="dA-ln-l">{{u.L[index]}}</text><text class="dA-ln-ot">{{item}}</text>
          <block wx:if="{{picked && item === quiz.answer}}"><text class="dA-ln-os">{{quiz.type === 'ms2zh' ? quiz.word.ms : quiz.zh}} · {{picked === item ? '答对' : '正确答案'}}</text><text class="dA-ln-ck">✓</text></block>
          <text wx:elif="{{picked === item}}" class="dA-ln-ck">✗</text>
        </view>
      </view>
      <view wx:if="{{quiz.graded && !picked}}" class="dA-ln-link" hover-class="hover" bindtap="dontKnow">想不起来</view>
    </view>

    <view wx:if="{{view === 'quiz' && picked}}" class="dA-ln-fb {{fbOk ? '' : 'dA-ln-fb-n'}}">
      <image class="dA-ln-fb-bird" src="/assets/{{fbOk ? 'cheer' : 'fail'}}.jpg" mode="aspectFill" />
      <view class="dA-ln-fb-m"><view class="dA-ln-fb-t">{{fbOk ? '答对了' : picked === '__skip' ? '没关系' : '答错了'}}{{fbOk && combo >= 3 ? ' · 连对 ' + combo + ' 题' : ''}}</view><view class="dA-ln-fb-l">{{fbLine}}</view></view>
      <button class="dA-btn dA-ln-fb-b" hover-class="hover" bindtap="cont">{{!fbOk && quiz.graded ? '看词卡' : '下一题'}}</button>
    </view>
  </view>

  <block wx:else>
    <view class="ln-top">
      <view class="bar ln-pbar"><view class="bar-in ln-pin" style="width:{{idx / total * 100}}%"><view wx:for="{{[idx]}}" wx:key="*this" class="ln-shine" /></view></view>
      <view class="ln-top-r"><text class="no">{{idx}} / {{total}}</text>
        <text wx:if="{{combo >= 3}}" class="ln-combo {{comboPop ? 'pop' : ''}}"><text class="ln-flame" />连对 ×{{combo}}</text>
        <text wx:if="{{view === 'quiz' && !quiz.graded}}">小练习</text>
        <text wx:else>{{card.again ? '再来一次' : card.kind === 'review' ? '复习' : '新词'}}</text>
      </view>
    </view>

    <!-- 词卡:象牙色卡片,正面只有词和发音 -->
    <block wx:if="{{view === 'card'}}">
      <!-- 手势：左滑不认识、右滑认识、上滑模糊；卡片跟手倾斜，松手过线就飞出去 -->
      <view class="ln-card {{flipped ? 'flipped' : ''}} {{fly ? 'fly-' + fly : ''}}" style="transform: translate({{dx}}px, {{dy < 0 ? dy : dy * 0.25}}px) rotate({{dx / 18}}deg); transition: {{drag ? 'none' : 'transform .28s ease, opacity .28s'}};" bindtap="flip" bindtouchstart="tStart" bindtouchmove="tMove" bindtouchend="tEnd" bindtouchcancel="tEnd">
        <view class="ln-badge {{hint}}" wx:if="{{hint}}">{{hint === 'know' ? '认识' : hint === 'forgot' ? '不认识' : '模糊'}}</view>
        <view class="ln-card-in">
          <view class="ln-w" style="font-size:{{flipped ? fit.fs(card.ms, 80, 400) : fit.fs(card.ms, 96, 590)}}rpx">{{card.ms}}</view>
          <view wx:if="{{!flipped}}" class="ln-card-hint">点卡片翻看释义</view>
        </view>
        <view class="ln-say"><say-btn src="{{card.audio}}" size="md" tone="ivory" /></view>
      </view>
      <scroll-view wx:if="{{flipped}}" scroll-y class="ln-below">
        <!-- 一行说明代替一排标签；右边是收藏 -->
        <view class="ln-meta">
          <view class="ln-meta-t one"><text class="no">№ {{card.rank}}</text>{{card.level ? ' · T' + card.level : ''}}{{card.senses[0].pos ? ' · ' + card.senses[0].pos : ''}} · {{card.first ? '初次见面' : card.again ? '再来一次' : '第 ' + (card.seen || 2) + ' 次见'}}</view>
          <view class="ln-fav-wrap"><view class="ln-fav {{card.fav ? 'on' : ''}} {{favPop ? 'pop' : ''}}" catchtap="fav"><image class="ln-fav-i" src="/assets/fx/{{card.fav ? 'star-amber' : (th.day ? 'star-line-day' : 'star-line')}}.svg" />{{card.fav ? '已收藏' : '收藏'}}</view><fx-burst fire="{{favFx}}" /></view>
        </view>
        <view wx:for="{{card.senses}}" wx:key="index" class="ln-sn">
          <view class="ln-mean"><text class="pos">{{item.pos}}</text>{{item.zh}}</view>
          <view wx:if="{{item.exMs}}" class="example">
            <view class="ln-ex-ms"><text wx:for="{{item.parts}}" wx:for-item="p" wx:key="index" class="{{p.hit ? 'ln-hit' : ''}}">{{p.t}}</text></view>
            <view class="muted small">{{item.exZh}}</view>
          </view>
        </view>
        <view wx:if="{{card.root}}" class="ln-root">词根 <text class="serif ln-root-w">{{card.root}}</text></view>
      </scroll-view>
      <view wx:else class="ln-grow" />
    </block>

    <!-- 题 -->
    <view wx:else class="ln-quiz">
      <view class="ln-q-k">{{quiz.type === 'ms2zh' ? '看词选义' : quiz.type === 'listen' ? '听音选词' : quiz.type === 'zh2ms' ? '看义选词' : quiz.type === 'cloze' ? '选词填空' : '拼写'}}</view>
      <view wx:if="{{quiz.type === 'listen'}}" class="ln-q-listen"><view class="ln-q-ring"><say-btn src="{{quiz.word.audio}}" size="lg" tone="big" /></view><view class="muted small">没听清就再点一下</view></view>
      <view wx:elif="{{quiz.type === 'cloze'}}" class="ln-q-cloze"><view class="ln-cl-ms">{{quiz.cloze.before}}<text class="ln-cl-gap">{{picked ? quiz.answer : '＿＿＿'}}</text>{{quiz.cloze.after}}</view><view class="muted small">{{quiz.cloze.zh}}</view></view>
      <view wx:else class="ln-q-p {{quiz.type === 'ms2zh' ? 'ms' : 'zhp'}}" style="{{quiz.type === 'ms2zh' ? 'font-size:' + fit.fs(quiz.prompt, 88, 680) + 'rpx' : ''}}">{{quiz.prompt}}</view>

      <block wx:if="{{quiz.type === 'spell'}}">
        <input class="input ln-spell {{picked ? (picked === quiz.answer ? 'ok' : 'bad') : ''}}" placeholder-class="ph" value="{{typed}}" placeholder="{{quiz.hint}}" focus confirm-type="done" bindinput="typing" bindconfirm="checkSpell" disabled="{{!!picked}}" />
        <view wx:if="{{picked && picked !== quiz.answer}}" class="ln-answer">正确答案：<text class="ms">{{quiz.answer}}</text></view>
        <view class="btns"><button class="btn btn-main" hover-class="hover" bindtap="checkSpell" disabled="{{!!picked}}">确定</button></view>
      </block>
      <view wx:else class="ln-opts">
        <view wx:for="{{quiz.options}}" wx:key="*this" class="opt {{picked && item === quiz.answer ? 'right' : ''}} {{picked === item && item !== quiz.answer ? 'wrong' : ''}} {{quiz.type !== 'ms2zh' ? 'ms' : ''}} {{picked && item !== quiz.answer && picked !== item ? 'dim' : ''}}" data-o="{{item}}" bindtap="pick">{{item}}</view>
      </view>
      <view wx:if="{{quiz.graded && !picked}}" class="btn-text" hover-class="hover" bindtap="dontKnow">想不起来</view>
      <view class="ln-grow" />
    </view>

    <!-- 题目底部反馈条 -->
    <view wx:if="{{view === 'quiz' && picked}}" class="ln-fb {{fbOk ? 'ok' : 'bad'}}">
      <image class="ln-fb-bird" src="/assets/{{fbOk ? 'cheer' : 'fail'}}.jpg" mode="aspectFill" />
      <view class="item-main"><view class="ms ln-fb-w one" style="font-size:{{fit.fs(quiz.word.ms, 40, 320)}}rpx">{{quiz.word.ms}}</view><view class="ln-fb-l {{fbOk ? 'ok' : ''}}">{{fbLine}}</view></view>
      <button class="btn btn-main ln-fb-b" hover-class="hover" bindtap="cont">继续</button>
    </view>

    <view wx:if="{{view === 'card'}}" class="ln-actions">
      <block wx:if="{{flipped}}">
        <!-- 三只犀鸟：拖向哪边哪只放大；也可以直接点 -->
        <view class="ln-birds">
          <view class="ln-bd {{hint === 'forgot' ? 'on' : ''}}" hover-class="hover" data-r="forgot" bindtap="grade"><image src="/assets/fail.jpg" mode="aspectFill" /><view class="ln-bd-t">← 不认识</view><view class="ln-gh">{{card.hints.forgot}}</view></view>
          <view class="ln-bd {{hint === 'vague' ? 'on' : ''}}" hover-class="hover" data-r="vague" bindtap="grade"><image src="/assets/loading.jpg" mode="aspectFill" /><view class="ln-bd-t">↑ 模糊</view><view class="ln-gh">{{card.hints.vague}}</view></view>
          <view class="ln-bd {{hint === 'know' ? 'on' : ''}}" hover-class="hover" data-r="know" bindtap="grade"><image src="/assets/cheer.jpg" mode="aspectFill" /><view class="ln-bd-t">认识 →</view><view class="ln-gh">{{card.hints.know}}</view></view>
        </view>
        <view wx:if="{{card.kind === 'new'}}" class="btn-text" hover-class="hover" data-r="mastered" bindtap="grade">太简单了，设为已掌握</view>
      </block>
      <button wx:else class="btn btn-main btn-block" hover-class="hover" bindtap="flip">看释义</button>
    </view>
  </block>
  </block>

  <!-- 结束:盖章 -->
  <block wx:elif="{{view === 'done'}}">
  <view wx:if="{{th.day}}" class="dA dA-ln-done">
    <view class="dA-ln-done-in">
      <view class="dA-stamp dA-ln-stamp">{{stop ? stop.city : '完成'}}</view>
      <view class="dA-eb dA-ln-c">JOMBELAJAR · {{date}}</view>
      <view class="dA-h1 dA-ln-c">这一程走完了</view>
      <view class="dA-ln-xp"><text class="dA-ln-xp-n">+{{xp}}</text><text class="dA-ln-xp-u">经验</text></view>
      <view wx:if="{{streak}}" class="dA-ln-tr dA-ln-c">已经连续学了 {{streak}} 天</view>
      <view class="dA-ln-sum">
        <view class="dA-ln-st"><view class="dA-ln-st-n dA-ln-st-y">{{stats.know}}</view><view class="dA-ln-st-l">认识</view></view>
        <view class="dA-ln-st"><view class="dA-ln-st-n">{{stats.vague}}</view><view class="dA-ln-st-l">模糊</view></view>
        <view class="dA-ln-st"><view class="dA-ln-st-n dA-ln-st-n2">{{stats.forgot}}</view><view class="dA-ln-st-l">不认识</view></view>
        <view class="dA-ln-st"><view class="dA-ln-st-n">{{stats.mastered}}</view><view class="dA-ln-st-l">已掌握</view></view>
      </view>
      <view wx:if="{{stop}}" class="dA-ln-tr dA-ln-c">{{stop.city}}站：已学 {{stop.learned}} / {{stop.total}}。模糊和不认识的词会排进后面的复习。</view>
    </view>
    <button class="dA-btn" hover-class="hover" bindtap="again">{{left ? '继续今天的' : '再学 10 个'}}</button>
    <view class="dA-ln-link" hover-class="hover" bindtap="back">回到路线</view>
  </view>
  <view wx:else class="ln-done">
    <view class="stamp ln-stamp ln-stampin">
      <text class="s2 no">JOMBELAJAR</text>
      <text class="s1">{{stop ? stop.city : '完成'}}</text>
      <text class="s2 no">{{date}}</text>
    </view>
    <view class="h1 center ln-pop" style="animation-delay:.15s">这一程走完了</view>
    <view class="ln-xp ln-pop" style="animation-delay:.3s"><text class="ln-xp-n">+{{xp}}</text><text class="ln-xp-u"> 经验</text></view>
    <view wx:if="{{streak}}" class="muted small center">已经连续学了 {{streak}} 天</view>
    <view class="stats mid ln-sum ln-pop" style="animation-delay:.5s">
      <view class="stat"><view class="stat-n c-green">{{stats.know}}</view><view class="stat-l">认识</view></view>
      <view class="stat"><view class="stat-n">{{stats.vague}}</view><view class="stat-l">模糊</view></view>
      <view class="stat"><view class="stat-n c-coral">{{stats.forgot}}</view><view class="stat-l">不认识</view></view>
      <view class="stat"><view class="stat-n">{{stats.mastered}}</view><view class="stat-l">已掌握</view></view>
    </view>
    <view wx:if="{{stop}}" class="muted small center">{{stop.city}}站：已学 {{stop.learned}} / {{stop.total}}。模糊和不认识的词会排进后面的复习。</view>
    <view class="btns">
      <button class="btn btn-main" hover-class="hover" bindtap="again">{{left ? '继续今天的' : '再学 10 个'}}</button>
      <view class="btn-text" hover-class="hover" bindtap="back">回到路线</view>
    </view>
  </view>
  </block>
</view>
<fx-confetti fire="{{cfFire}}" />
