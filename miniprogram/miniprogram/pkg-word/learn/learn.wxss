/* 背词：一张象牙色词卡浮在夜色里。星光只给进度条 */
.ln-page { height: 100vh; display: flex; flex-direction: column; padding: var(--s3) var(--s4) calc(var(--s4) + env(safe-area-inset-bottom)); box-sizing: border-box; }
.ln-top { margin-bottom: var(--s3); flex: none; }
.ln-top-r { display: flex; justify-content: space-between; align-items: center; margin-top: var(--s1); font-size: var(--t-caption); color: var(--ink2); }
.ln-grow { flex: 1; }

/* 词卡 */
.ln-card { position: relative; flex: none; height: 400rpx; border-radius: var(--r-lg); background: var(--raise); box-shadow: var(--raise-sh); padding: var(--s2); box-sizing: border-box; will-change: transform; }
.ln-card-in { height: 100%; border: 2rpx solid var(--dark-hair); border-radius: var(--r-sm); display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 0 var(--s3); box-sizing: border-box; }
.ln-w { font-family: var(--f-ms); font-style: italic; font-weight: 700; font-size: var(--t-display); line-height: 1.15; white-space: nowrap; text-align: center; color: var(--leaf); }
.ln-card-hint { margin-top: var(--s2); font-size: var(--t-caption); color: var(--dark-ink2); }
.ln-say { position: absolute; right: var(--s4); bottom: var(--s4); }
/* 翻开后卡片收矮，把位置让给释义和例句，一屏看完 */
.ln-card.flipped { height: 248rpx; }
.ln-card.flipped .ln-w { padding: 0 96rpx; }
.ln-card.flipped .ln-say { bottom: 50%; transform: translateY(50%); }

/* 释义 */
.ln-below { flex: 1; min-height: 0; margin-top: var(--s2); box-sizing: border-box; }
.ln-meta { display: flex; align-items: center; justify-content: space-between; gap: var(--s2); }
.ln-meta-t { flex: 1; min-width: 0; font-size: var(--t-caption); color: var(--ink2); }
.ln-fav-wrap { position: relative; flex: none; }
.ln-fav { display: inline-flex; align-items: center; gap: var(--s1); height: 88rpx; padding-left: var(--s3); font-size: 26rpx; color: var(--ink2); }
.ln-fav.on { color: var(--strong); }
.ln-fav-i { width: 36rpx; height: 36rpx; }
.ln-fav.pop { animation: ln-favpop .4s cubic-bezier(.3,1.6,.5,1); }
@keyframes ln-favpop { 0% { transform: scale(1); } 40% { transform: scale(1.18); } 100% { transform: scale(1); } }
.ln-sn { padding: var(--s2) 0; border-top: 2rpx solid var(--hair); }
.ln-mean { font-family: var(--f-zh); font-size: 36rpx; font-weight: 700; line-height: 1.4; }
.ln-ex-ms { font-family: var(--f-ms); font-size: 32rpx; line-height: 1.5; }
.ln-hit { background: var(--hair2); border-radius: 6rpx; padding: 0 6rpx; }
.ln-root { padding: var(--s2) 0; border-top: 2rpx solid var(--hair); font-size: var(--t-caption); color: var(--ink2); }
.ln-root-w { font-size: 28rpx; color: var(--strong); }

/* 打分：三只犀鸟，没有边框；拖向哪边哪只抬起来 */
.ln-actions { margin-top: var(--s2); flex: none; }
.ln-birds { display: flex; gap: var(--s2); padding-top: var(--s2); border-top: 2rpx solid var(--hair); }
.ln-bd { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; padding: var(--s1) 0; border-radius: var(--r-sm); transition: transform .18s, background-color .18s; }
.ln-bd image { width: 88rpx; height: 88rpx; border-radius: 50%; background: var(--photo); transition: transform .18s; }
.ln-bd-t { margin-top: var(--s1); font-size: 28rpx; font-weight: 600; }
.ln-gh { font-size: var(--t-caption); color: var(--ink2); line-height: 1.3; }
.ln-bd.hover { opacity: .72; }
.ln-bd.on { background: var(--hair); transform: translateY(-8rpx); }
.ln-bd.on image { transform: scale(1.18); animation: ln-hop .5s ease-in-out infinite alternate; }
@keyframes ln-hop { from { transform: scale(1.18) translateY(0); } to { transform: scale(1.18) translateY(-8rpx); } }

/* 手势：松手过线飞出去；拖的时候卡片角上盖一个字 */
.ln-card.fly-know { transform: translate(140%, -20rpx) rotate(22deg) !important; opacity: 0; }
.ln-card.fly-forgot { transform: translate(-140%, -20rpx) rotate(-22deg) !important; opacity: 0; }
.ln-card.fly-vague { transform: translate(0, -120%) !important; opacity: 0; }
.ln-badge { position: absolute; top: var(--s4); z-index: 2; padding: 0 var(--s2); border-radius: 8rpx; font-size: 28rpx; font-weight: 700; line-height: 1.6; border: 4rpx solid; transform: rotate(-8deg); background: var(--raise); }
.ln-badge.know { left: var(--s4); color: var(--leaf); }
.ln-badge.forgot { right: var(--s4); color: var(--bad-d); transform: rotate(8deg); }
.ln-badge.vague { left: 50%; margin-left: -56rpx; color: var(--star-d); transform: none; }

/* 题 */
.ln-quiz { flex: 1; display: flex; flex-direction: column; padding-bottom: 160rpx; }
.ln-q-k { font-size: var(--t-caption); color: var(--ink2); text-align: center; }
.ln-q-p { text-align: center; margin: var(--s5) 0; }
.ln-q-p.ms { font-size: var(--t-display); line-height: 1.15; white-space: nowrap; }
.ln-q-p.zhp { font-family: var(--f-zh); font-size: var(--t-title); font-weight: 700; }
.ln-q-listen { display: flex; flex-direction: column; align-items: center; gap: var(--s2); margin: var(--s4) 0 var(--s5); }
.ln-q-ring { width: 264rpx; height: 264rpx; border-radius: 50%; border: 2rpx solid var(--hair); display: flex; align-items: center; justify-content: center; box-sizing: border-box; }
.ln-q-ring say-btn { transform: scale(1.6); }
.ln-q-cloze { margin: var(--s4) 0 var(--s5); padding: var(--s3) 0; border-top: 2rpx solid var(--hair); border-bottom: 2rpx solid var(--hair); }
.ln-cl-ms { font-family: var(--f-ms); font-size: 36rpx; line-height: 1.6; margin-bottom: var(--s1); }
.ln-cl-gap { display: inline-block; min-width: 140rpx; padding: 0 var(--s1); border-bottom: 2rpx solid var(--strong); font-style: italic; text-align: center; }
.ln-spell { height: 112rpx; font-family: var(--f-ms); font-style: italic; font-size: var(--t-title); text-align: center; }
.ln-spell.ok { border-color: var(--ok); background: var(--ok-l); }
.ln-spell.bad { border-color: var(--bad); background: var(--bad-l); }
.ln-answer { text-align: center; margin-top: var(--s3); }

/* 底部反馈条：面板色，贴底 */
.ln-fb { position: fixed; left: 0; right: 0; bottom: 0; display: flex; align-items: center; gap: var(--s3); padding: var(--s3) var(--s4) calc(var(--s3) + env(safe-area-inset-bottom)); background: var(--panel); }
.ln-fb-w { font-size: 40rpx; line-height: 1.2; }
.ln-fb-l { font-size: var(--t-caption); color: var(--ink2); }
.ln-fb-l.ok { color: var(--ok); }
button.ln-fb-b { flex: none; min-width: 200rpx; }

/* 结束 */
.ln-done { flex: 1; display: flex; flex-direction: column; justify-content: center; }
.ln-stamp { width: 264rpx; height: 264rpx; margin: 0 auto var(--s5); }
.ln-stamp .s1 { font-size: var(--t-title); margin: var(--s1) 0; }
.ln-stamp .s2 { font-size: 22rpx; letter-spacing: 2rpx; }
.ln-sum { margin: var(--s4) 0 var(--s3); }

/* ---- 多邻国式反馈（2026-11-19，规范见 ~/.claude/skills/app-motion） ---- */
/* 进度条：宽度带回弹地长，每前进一格扫过一道光 */
.ln-pin { position: relative; overflow: hidden; transition: width .45s cubic-bezier(.34,1.56,.64,1); }
.ln-shine { position: absolute; top: 0; bottom: 0; width: 60rpx; left: -60rpx; background: linear-gradient(90deg, transparent, rgba(255,255,255,.6), transparent); animation: shine .7s ease-out .1s; }
@keyframes shine { to { left: 110%; } }
/* 连对 */
.ln-combo { display: inline-flex; align-items: center; gap: 6rpx; margin-left: 16rpx; padding: 2rpx 16rpx; border-radius: 999rpx; background: var(--star-l); color: var(--star); font-size: 22rpx; font-weight: 800; }
.ln-combo.pop { animation: cpop .45s cubic-bezier(.3,1.8,.5,1); }
@keyframes cpop { 0% { transform: scale(.6); } 60% { transform: scale(1.25); } 100% { transform: scale(1); } }
.ln-flame { width: 14rpx; height: 18rpx; border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%; background: linear-gradient(180deg, #f2b874, #e8836a); }
/* 答题反馈条：从底部弹上来，答对绿、答错珊瑚色，犀鸟蹦一下 */
.ln-fb { animation: fbup .32s cubic-bezier(.3,1.4,.5,1); }
.ln-fb.ok { background: var(--fb-ok); }
.ln-fb.bad { background: var(--fb-bad); }
@keyframes fbup { from { transform: translateY(100%); opacity: .4; } to { transform: none; opacity: 1; } }
.ln-fb-bird { width: 88rpx; height: 88rpx; border-radius: 50%; flex: none; margin-right: 16rpx; background: var(--raise); animation: hopb .6s cubic-bezier(.3,1.6,.5,1) .1s both; }
.ln-fb.bad .ln-fb-bird { animation: wobble .5s ease-in-out .1s both; }
@keyframes hopb { 0% { transform: translateY(20rpx) scale(.7); } 50% { transform: translateY(-16rpx) scale(1.08, .95); } 100% { transform: none; } }
@keyframes wobble { 0%,100% { transform: rotate(0); } 25% { transform: rotate(-10deg); } 75% { transform: rotate(8deg); } }
/* 结算：印章砸下来，标题 / 经验值 / 统计依次弹出 */
.ln-stampin { animation: stampin .5s cubic-bezier(.3,1.6,.5,1) both; }
@keyframes stampin { 0% { transform: scale(2.2) rotate(-25deg); opacity: 0; } 70% { transform: scale(.92) rotate(-12deg); opacity: 1; } 100% { transform: scale(1) rotate(-12deg); } }
.ln-pop { animation: lpop .45s cubic-bezier(.3,1.5,.5,1) both; }
@keyframes lpop { from { transform: translateY(24rpx) scale(.9); opacity: 0; } to { transform: none; opacity: 1; } }
.ln-xp { text-align: center; margin: 8rpx 0 24rpx; }
.ln-xp-n { font-family: Georgia, serif; font-size: 72rpx; font-weight: 700; color: var(--star); }
.ln-xp-u { font-size: 26rpx; color: var(--ink2); }

/* ==== 白天版「旅行手账」（设计稿 mp-v2 方向 A：A2 词卡 / A3 小测）；尺寸 = 稿上 px × 2 ==== */
.dA-ln { flex: 1; min-height: 0; display: flex; flex-direction: column; margin: 0 -32rpx; padding: 0 40rpx; overflow: hidden; }
.dA-ln-top { flex: none; display: flex; align-items: center; height: 80rpx; }
.dA-ln-x { flex: none; width: 56rpx; height: 80rpx; line-height: 76rpx; font-family: var(--latin); font-size: 52rpx; color: var(--ik); }
.dA-ln-prog { flex: 1; height: 8rpx; margin: 0 28rpx; border-radius: 4rpx; background: var(--pa2); overflow: hidden; }
.dA-ln-prog-i { height: 100%; background: var(--gr); transition: width .4s ease; }
.dA-ln-no { flex: none; font-family: var(--latin); font-size: 28rpx; color: var(--ik2); }
.dA-ln-pips { flex: 1; display: flex; margin: 0 28rpx 0 20rpx; }
.dA-ln-pip { flex: 1; height: 8rpx; margin-left: 8rpx; border-radius: 4rpx; background: var(--pa2); }
.dA-ln-pip:first-child { margin-left: 0; }
.dA-ln-pip-y { background: var(--gr); }
.dA-ln-pip-n { background: var(--rd); }
.dA-ln-pip-v { background: var(--am); }
.dA-ln-pip-c { background: var(--ik); }

/* A2 词卡：墨线框纸卡，正面词 + 再听一遍，虚线下面是背面 */
.dA-ln-card { position: relative; flex: 0 1 auto; min-height: 0; display: flex; flex-direction: column; margin-top: 12rpx; overflow: hidden; will-change: transform; }
.dA-ln-fly-know { transform: translate(140%, -20rpx) rotate(22deg) !important; opacity: 0; }
.dA-ln-fly-forgot { transform: translate(-140%, -20rpx) rotate(-22deg) !important; opacity: 0; }
.dA-ln-fly-vague { transform: translate(0, -120%) !important; opacity: 0; }
.dA-ln-ft { flex: none; }
.dA-ln-f { padding: 32rpx 40rpx 60rpx; text-align: center; }
.dA-ln-f-open { padding-bottom: 28rpx; }
.dA-ln-m { display: flex; justify-content: space-between; font-family: var(--mono); font-size: 24rpx; line-height: 1.4; color: var(--mu); letter-spacing: .06em; }
.dA-ln-m-l { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; text-align: left; }
.dA-ln-m-r { flex: none; margin-left: 16rpx; }
.dA-ln-w { margin-top: 76rpx; font-family: var(--latin); line-height: 1.15; letter-spacing: -.01em; white-space: nowrap; overflow: hidden; color: var(--ik); }
.dA-ln-f-open .dA-ln-w { margin-top: 24rpx; }
.dA-ln-spk { display: inline-flex; align-items: center; height: 88rpx; padding: 0 36rpx; margin-top: 44rpx; border-radius: 44rpx; border: 3rpx solid var(--ik); box-sizing: border-box; font-size: 28rpx; font-weight: 600; }
.dA-ln-f-open .dA-ln-spk { height: 72rpx; margin-top: 20rpx; }
.dA-ln-cone { width: 0; height: 0; border-top: 10rpx solid transparent; border-bottom: 10rpx solid transparent; border-right: 13rpx solid var(--ik); margin-right: 2rpx; }
.dA-ln-wave { width: 9rpx; height: 20rpx; border: 3rpx solid var(--ik); border-left: 0; border-radius: 0 20rpx 20rpx 0; margin-right: 16rpx; }
.dA-ln-seam { display: flex; align-items: center; padding: 0 28rpx; font-size: 24rpx; color: var(--mu); }
.dA-ln-dash { flex: 1; border-top: 3rpx dashed var(--ln); }
.dA-ln-seam-t { margin: 0 20rpx; }
.dA-ln-b { flex: 0 1 auto; min-height: 0; }
.dA-ln-bin { padding: 40rpx 40rpx 24rpx; }
.dA-ln-sn + .dA-ln-sn { margin-top: 36rpx; }
.dA-ln-mean { line-height: 1.4; }
.dA-ln-pos { font-family: var(--serif); font-style: italic; font-size: 30rpx; color: var(--am); margin-right: 16rpx; }
.dA-ln-zh { font-family: var(--serif); font-size: 48rpx; font-weight: 700; }
.dA-ln-sn + .dA-ln-sn .dA-ln-zh { font-size: 36rpx; }
.dA-ln-ex { margin-top: 24rpx; padding-left: 24rpx; border-left: 6rpx solid var(--am-l); }
.dA-ln-ex-ms { font-family: var(--latin); font-size: 36rpx; line-height: 1.4; word-break: break-word; }
.dA-ln-mark { background: linear-gradient(transparent 62%, var(--am-l) 62%); }
.dA-ln-ex-zh { margin-top: 4rpx; font-size: 28rpx; color: var(--ik2); }
.dA-ln-root { display: flex; align-items: center; margin-top: 36rpx; font-size: 28rpx; color: var(--ik2); }
.dA-ln-root-w { margin-left: 12rpx; font-family: var(--latin); font-size: 30rpx; color: var(--ik); }
.dA-ln-fav-row { display: flex; justify-content: flex-end; margin-top: 8rpx; }
.dA-ln-fav-wrap { position: relative; }
.dA-ln-fav { display: inline-flex; align-items: center; height: 72rpx; font-size: 26rpx; color: var(--mu); }
.dA-ln-fav-on { color: var(--am); }
.dA-ln-fav-i { width: 32rpx; height: 32rpx; margin-right: 8rpx; }
.dA-ln-grow { flex: 1 1 0; min-height: 24rpx; }
.dA-ln-act { flex: none; }
.dA-ln-grade { display: flex; }
.dA-ln-g { flex: 1; min-width: 0; height: 120rpx; margin-left: 20rpx; border-radius: 16rpx; border: 3rpx solid var(--ik); background: var(--cd); box-sizing: border-box; display: flex; flex-direction: column; align-items: center; justify-content: center; font-size: 32rpx; font-weight: 700; line-height: 1.3; transition: transform .18s; }
.dA-ln-g:first-child { margin-left: 0; }
.dA-ln-gh { font-size: 22rpx; font-weight: 400; color: var(--mu); }
.dA-ln-g-ok { background: var(--gr); border-color: var(--gr); color: #fff; }
.dA-ln-g-ok .dA-ln-gh { color: rgba(255, 255, 255, .8); }
.dA-ln-g-on { transform: translateY(-10rpx); box-shadow: 6rpx 8rpx 0 var(--pa2); }
.dA-ln-link { padding: 20rpx 0 4rpx; text-align: center; font-size: 26rpx; color: var(--mu); }

/* A3 小测：句子最大，选项是四行字（字母 + 细线），不是盒子 */
.dA-ln-q { flex: 1; min-height: 0; display: flex; flex-direction: column; padding: 20rpx 8rpx 240rpx; }
.dA-ln-sent { margin-top: 28rpx; font-family: var(--latin); font-size: 54rpx; line-height: 1.4; word-break: break-word; }
.dA-ln-blank { display: inline-block; min-width: 208rpx; border-bottom: 4rpx solid var(--gr); color: var(--gr); font-style: italic; text-align: center; line-height: 1.2; }
.dA-ln-tr { margin-top: 16rpx; font-size: 28rpx; color: var(--ik2); }
.dA-ln-listen { display: flex; flex-direction: column; align-items: center; margin: 40rpx 0 8rpx; }
.dA-ln-pw { margin: 40rpx 0 8rpx; font-family: var(--latin); line-height: 1.15; white-space: nowrap; overflow: hidden; }
.dA-ln-pz { margin-top: 32rpx; font-family: var(--serif); font-size: 52rpx; font-weight: 700; line-height: 1.35; }
.dA-ln-opts { margin-top: 40rpx; border-top: 3rpx solid var(--ik); }
.dA-ln-opt { display: flex; align-items: center; min-height: 128rpx; border-bottom: 2rpx solid var(--ln); font-family: var(--latin); font-size: 44rpx; box-sizing: border-box; }
.dA-ln-opt-zh { padding: 16rpx 0; font-family: var(--serif); font-size: 34rpx; }
.dA-ln-l { flex: none; width: 32rpx; margin-right: 28rpx; font-family: var(--mono); font-size: 26rpx; font-weight: 400; color: var(--mu); }
.dA-ln-ot { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.dA-ln-opt-zh .dA-ln-ot { white-space: normal; line-height: 1.4; }
.dA-ln-os { flex: none; max-width: 260rpx; margin-left: 16rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-family: "PingFang SC", "Helvetica Neue", sans-serif; font-size: 26rpx; font-weight: 400; color: var(--mu); }
.dA-ln-ck { flex: none; margin-left: 12rpx; font-size: 32rpx; font-weight: 700; }
.dA-ln-opt-y { color: var(--gr); font-weight: 700; }
.dA-ln-opt-y .dA-ln-os { color: var(--gr); }
.dA-ln-opt-n { color: var(--rd); }
.dA-ln-opt-dim { opacity: .45; }
.dA-ln-spell { height: 112rpx; margin-top: 40rpx; border-top: 3rpx solid var(--ik); border-bottom: 2rpx solid var(--ln); font-family: var(--latin); font-style: italic; font-size: 52rpx; text-align: center; color: var(--ik); }
.dA-ln-spell-y { color: var(--gr); border-bottom-color: var(--gr); }
.dA-ln-spell-n { color: var(--rd); border-bottom-color: var(--rd); }
.dA-ln-ph { color: var(--mu); }
.dA-ln-ans { font-family: var(--latin); font-weight: 700; color: var(--ik); }
.dA-ln-ok { margin-top: 40rpx; }
.dA-ln-fb { position: fixed; left: 0; right: 0; bottom: 0; z-index: 5; display: flex; align-items: center; padding: 28rpx 40rpx calc(28rpx + env(safe-area-inset-bottom)); background: var(--gr-l); border-top: 3rpx solid var(--gr); animation: fbup .32s cubic-bezier(.3,1.4,.5,1); }
.dA-ln-fb-n { background: var(--pa); border-top-color: var(--rd); }
.dA-ln-fb-bird { flex: none; width: 128rpx; height: 128rpx; margin-right: 24rpx; border-radius: 50%; border: 3rpx solid var(--gr); box-sizing: border-box; }
.dA-ln-fb-n .dA-ln-fb-bird { border-color: var(--rd); }
.dA-ln-fb-m { flex: 1; min-width: 0; }
.dA-ln-fb-t { font-size: 34rpx; font-weight: 700; color: var(--gr-d); }
.dA-ln-fb-n .dA-ln-fb-t { color: var(--rd); }
.dA-ln-fb-l { font-size: 26rpx; line-height: 1.4; color: var(--ik2); }
.dA-ln-fb-b { flex: none; width: 208rpx; height: 96rpx; margin-left: 20rpx; font-size: 32rpx; }

/* 结束：红章 + 经验 + 一行墨线统计 */
.dA-ln-done { flex: 1; display: flex; flex-direction: column; padding: 0 8rpx; }
.dA-ln-done-in { flex: 1; display: flex; flex-direction: column; justify-content: center; }
.dA-ln-stamp { align-self: center; margin-bottom: 32rpx; padding: 12rpx 32rpx; font-size: 40rpx; border-width: 4rpx; }
.dA-ln-c { text-align: center; }
.dA-ln-xp { margin: 16rpx 0; text-align: center; }
.dA-ln-xp-n { font-family: var(--latin); font-size: 96rpx; font-weight: 700; color: var(--am); }
.dA-ln-xp-u { margin-left: 8rpx; font-size: 26rpx; color: var(--mu); }
.dA-ln-sum { display: flex; margin: 32rpx 0 24rpx; padding: 20rpx 0; border-top: 3rpx solid var(--ik); border-bottom: 2rpx solid var(--ln); }
.dA-ln-st { flex: 1; text-align: center; }
.dA-ln-st-n { font-family: var(--latin); font-size: 52rpx; font-weight: 700; line-height: 1.3; }
