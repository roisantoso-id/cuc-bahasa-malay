/* 背词：一张象牙色词卡浮在夜色里。星光只给进度条 */
.ln-page { height: 100vh; display: flex; flex-direction: column; padding: var(--s3) var(--s4) calc(var(--s4) + env(safe-area-inset-bottom)); box-sizing: border-box; }
.ln-top { margin-bottom: var(--s3); flex: none; }
.ln-top-r { display: flex; justify-content: space-between; align-items: center; margin-top: var(--s1); font-size: var(--t-caption); color: var(--ink2); }
.ln-grow { flex: 1; }

/* 词卡 */
.ln-card { position: relative; flex: none; height: 400rpx; border-radius: var(--r-lg); background: var(--ivory); padding: var(--s2); box-sizing: border-box; will-change: transform; }
.ln-card-in { height: 100%; border: 2rpx solid var(--dark-hair); border-radius: var(--r-sm); display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 0 var(--s3); box-sizing: border-box; }
.ln-w { font-family: var(--f-ms); font-style: italic; font-weight: 700; font-size: var(--t-display); line-height: 1.15; word-break: break-word; text-align: center; color: var(--leaf); }
.ln-card-hint { margin-top: var(--s2); font-size: var(--t-caption); color: var(--dark-ink2); }
.ln-say { position: absolute; right: var(--s4); bottom: var(--s4); }
/* 翻开后卡片收矮，把位置让给释义和例句，一屏看完 */
.ln-card.flipped { height: 208rpx; }
.ln-card.flipped .ln-w { font-size: 64rpx; padding: 0 96rpx; }
.ln-card.flipped .ln-say { bottom: 50%; transform: translateY(50%); }

/* 释义 */
.ln-below { flex: 1; min-height: 0; margin-top: var(--s2); box-sizing: border-box; }
.ln-meta { display: flex; align-items: center; justify-content: space-between; gap: var(--s2); }
.ln-meta-t { flex: 1; min-width: 0; font-size: var(--t-caption); color: var(--ink2); }
.ln-fav-wrap { position: relative; flex: none; }
.ln-fav { display: inline-flex; align-items: center; gap: var(--s1); height: 88rpx; padding-left: var(--s3); font-size: 26rpx; color: var(--ink2); }
.ln-fav.on { color: var(--ivory); }
.ln-fav-i { width: 36rpx; height: 36rpx; }
.ln-fav.pop { animation: ln-favpop .4s cubic-bezier(.3,1.6,.5,1); }
@keyframes ln-favpop { 0% { transform: scale(1); } 40% { transform: scale(1.18); } 100% { transform: scale(1); } }
.ln-sn { padding: var(--s2) 0; border-top: 2rpx solid var(--hair); }
.ln-mean { font-family: var(--f-zh); font-size: var(--t-section); font-weight: 700; line-height: 1.4; }
.ln-ex-ms { font-family: var(--f-ms); font-size: 28rpx; line-height: 1.45; }
.ln-hit { background: var(--hair2); border-radius: 6rpx; padding: 0 6rpx; }
.ln-root { padding: var(--s2) 0; border-top: 2rpx solid var(--hair); font-size: var(--t-caption); color: var(--ink2); }
.ln-root-w { font-size: 28rpx; color: var(--ivory); }

/* 打分：三只犀鸟，没有边框；拖向哪边哪只抬起来 */
.ln-actions { margin-top: var(--s2); flex: none; }
.ln-birds { display: flex; gap: var(--s2); padding-top: var(--s2); border-top: 2rpx solid var(--hair); }
.ln-bd { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; padding: var(--s1) 0; border-radius: var(--r-sm); transition: transform .18s, background-color .18s; }
.ln-bd image { width: 88rpx; height: 88rpx; border-radius: 50%; background: var(--ivory); transition: transform .18s; }
.ln-bd-t { margin-top: var(--s1); font-size: 28rpx; font-weight: 600; }
.ln-gh { font-size: var(--t-caption); color: var(--ink2); line-height: 1.3; }
.ln-bd.hover { opacity: .72; }
.ln-bd.on { background: var(--hair); transform: translateY(-8rpx); }
.ln-bd.on image { transform: scale(1.18); animation: ln-hop .5s ease-in-out infinite alternate; }
@keyframes ln-hop { from { transform: scale(1.18) translateY(0); } to { transform: scale(1.18) translateY(-8rpx); } }

/* 手势：松手过线飞出去；拖的时候卡片角上盖一个字 */
.ln-card.fly-know { transform: translate(140%, -20rpx) rotate(22deg) !important; opacity: 0; }
.ln-card.fly-forgot { transform: translate(-140%, -20rpx) rotate(-22deg) !important; opacity: 0; }
.ln-card.fly-vague { transform: translate(0, -120%) !important; opacity: 0; }
.ln-badge { position: absolute; top: var(--s4); z-index: 2; padding: 0 var(--s2); border-radius: 8rpx; font-size: 28rpx; font-weight: 700; line-height: 1.6; border: 4rpx solid; transform: rotate(-8deg); background: var(--ivory); }
.ln-badge.know { left: var(--s4); color: var(--leaf); }
.ln-badge.forgot { right: var(--s4); color: var(--bad-d); transform: rotate(8deg); }
.ln-badge.vague { left: 50%; margin-left: -56rpx; color: var(--star-d); transform: none; }

/* 题 */
.ln-quiz { flex: 1; display: flex; flex-direction: column; padding-bottom: 160rpx; }
.ln-q-k { font-size: var(--t-caption); color: var(--ink2); text-align: center; }
.ln-q-p { text-align: center; margin: var(--s5) 0; }
.ln-q-p.ms { font-size: var(--t-display); line-height: 1.15; }
.ln-q-p.zhp { font-family: var(--f-zh); font-size: var(--t-title); font-weight: 700; }
.ln-q-listen { display: flex; flex-direction: column; align-items: center; gap: var(--s2); margin: var(--s4) 0 var(--s5); }
.ln-q-ring { width: 264rpx; height: 264rpx; border-radius: 50%; border: 2rpx solid var(--hair); display: flex; align-items: center; justify-content: center; box-sizing: border-box; }
.ln-q-ring say-btn { transform: scale(1.6); }
.ln-q-cloze { margin: var(--s4) 0 var(--s5); padding: var(--s3) 0; border-top: 2rpx solid var(--hair); border-bottom: 2rpx solid var(--hair); }
.ln-cl-ms { font-family: var(--f-ms); font-size: 36rpx; line-height: 1.6; margin-bottom: var(--s1); }
.ln-cl-gap { display: inline-block; min-width: 140rpx; padding: 0 var(--s1); border-bottom: 2rpx solid var(--ivory); font-style: italic; text-align: center; }
.ln-spell { height: 112rpx; font-family: var(--f-ms); font-style: italic; font-size: var(--t-title); text-align: center; }
.ln-spell.ok { border-color: var(--ok); background: var(--ok-l); }
.ln-spell.bad { border-color: var(--bad); background: var(--bad-l); }
.ln-answer { text-align: center; margin-top: var(--s3); }

/* 底部反馈条：面板色，贴底 */
.ln-fb { position: fixed; left: 0; right: 0; bottom: 0; display: flex; align-items: center; gap: var(--s3); padding: var(--s3) var(--s4) calc(var(--s3) + env(safe-area-inset-bottom)); background: var(--panel); }
.ln-fb-w { font-size: 40rpx; line-height: 1.2; }
.ln-fb-l { font-size: var(--t-caption); color: var(--ink2); }
.ln-fb-l.ok { color: var(--ok); }
button.ln-fb-b { flex: none; min-width: 200rpx; }

/* 结束 */
.ln-done { flex: 1; display: flex; flex-direction: column; justify-content: center; }
.ln-stamp { width: 264rpx; height: 264rpx; margin: 0 auto var(--s5); }
.ln-stamp .s1 { font-size: var(--t-title); margin: var(--s1) 0; }
.ln-stamp .s2 { font-size: 22rpx; letter-spacing: 2rpx; }
.ln-sum { margin: var(--s4) 0 var(--s3); }
