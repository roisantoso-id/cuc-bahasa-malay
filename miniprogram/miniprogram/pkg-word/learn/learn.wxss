.page { height: 100vh; display: flex; flex-direction: column; padding: 24rpx 32rpx calc(32rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.top { margin-bottom: 24rpx; flex: none; }
.top-r { display: flex; justify-content: space-between; align-items: center; margin-top: 14rpx; }
.grow { flex: 1; }

/* 词卡：象牙卡片，大斜体衬线词 */
.wcard { position: relative; flex: none; height: 400rpx; border-radius: 40rpx; background: var(--ivory); padding: 16rpx; box-sizing: border-box; }
.wc-in { height: 100%; border: 2rpx solid rgba(10,31,34,.18); border-radius: 28rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 0 24rpx; box-sizing: border-box; }
.w { font-size: 96rpx; font-style: italic; font-weight: 700; line-height: 1.15; word-break: break-word; text-align: center; font-family: Georgia, "Times New Roman", serif; color: #1f6b4e; }
.wc-hint { margin-top: 20rpx; font-size: 26rpx; color: rgba(10,31,34,.55); }
.wc-say { position: absolute; right: 40rpx; bottom: 40rpx; }
.below { flex: 1; min-height: 0; margin-top: 24rpx; box-sizing: border-box; }
.tags { display: flex; flex-wrap: wrap; align-items: center; gap: 12rpx; }
.fav { margin-left: auto; font-size: 26rpx; font-weight: 700; color: var(--ink2); padding: 8rpx 22rpx; border-radius: 999rpx; border: 2rpx solid var(--hair2); }
.fav.on { color: var(--star); border-color: var(--star); }
.sn { margin-top: 24rpx; }
.mean { font-size: 38rpx; font-weight: 700; font-family: "Songti SC", "STSong", -apple-system, "PingFang SC", serif; }
.pos { font-size: 26rpx; font-style: italic; color: var(--star); margin-right: 14rpx; font-family: Georgia, serif; font-weight: 400; }
.ex { margin-top: 16rpx; padding-top: 16rpx; border-top: 2rpx solid var(--hair); }
.ex-ms { font-family: Georgia, serif; font-size: 34rpx; line-height: 1.5; }
.ex-ms .hit { background: rgba(233,185,97,.28); color: var(--ivory); border-radius: 6rpx; padding: 0 6rpx; }
.ex-zh { font-size: 26rpx; color: var(--ink2); margin-top: 4rpx; }
.root { margin-top: 28rpx; font-size: 26rpx; color: var(--ink2); padding-bottom: 16rpx; }
.root-w { color: var(--star); font-family: Georgia, serif; font-size: 30rpx; }

/* 打分：深色描边，认识 = 象牙实心 */
.actions { margin-top: 20rpx; flex: none; }
.grades { display: flex; gap: 16rpx; }
.g { flex: 1; min-width: 0; text-align: center; padding: 20rpx 0; border-radius: 999rpx; font-size: 32rpx; font-weight: 800; border: 2rpx solid var(--hair2); color: var(--ivory); background: transparent; min-height: 100rpx; box-sizing: border-box; }
.g.hover { opacity: .7; }
.gh { font-size: 24rpx; font-weight: 400; color: var(--ink2); }
.g-know { background: var(--ivory); color: var(--dark-ink); border-color: var(--ivory); }
.g-know .gh { color: rgba(10,31,34,.6); }
.master { text-align: center; margin-top: 16rpx; font-size: 26rpx; color: var(--ink2); padding: 16rpx; }

/* 题 */
.quiz { flex: 1; display: flex; flex-direction: column; padding-bottom: 150rpx; }
.q-k { font-size: 26rpx; color: var(--ink2); text-align: center; }
.q-p { text-align: center; margin: 56rpx 0 48rpx; font-weight: 700; }
.q-p.ms { font-size: 76rpx; font-style: italic; font-family: Georgia, serif; }
.q-p.zhp { font-size: 46rpx; font-family: "Songti SC", "STSong", -apple-system, serif; }
.q-listen { display: flex; flex-direction: column; align-items: center; gap: 16rpx; margin: 28rpx 0 40rpx; }
.q-ring { width: 280rpx; height: 280rpx; border-radius: 50%; background: rgba(243,234,214,.06); display: flex; align-items: center; justify-content: center; }
.q-ring say-btn { transform: scale(1.6); }
.opt.ms { font-size: 34rpx; font-family: Georgia, serif; }
.opt.dim { opacity: .45; }
.spell { height: 110rpx; font-size: 44rpx; font-weight: 700; text-align: center; margin-top: 10rpx; font-family: Georgia, serif; }
.spell.ok { border-color: var(--ok); background: rgba(143,192,160,.12); }
.spell.bad { border-color: var(--bad); background: rgba(232,131,106,.1); }
.answer { text-align: center; margin-top: 20rpx; font-size: 30rpx; }
.idk { text-align: center; color: var(--ink2); font-size: 26rpx; margin-top: 16rpx; padding: 24rpx; }

.q-cloze { margin: 24rpx 0 36rpx; padding: 28rpx; border-radius: 24rpx; background: var(--panel); border: 2rpx solid var(--hair); }
.cl-ms { font-family: Georgia, serif; font-size: 36rpx; line-height: 1.6; margin-bottom: 10rpx; }
.cl-gap { display: inline-block; min-width: 140rpx; padding: 0 12rpx; border-bottom: 4rpx solid var(--star); color: var(--star); font-weight: 700; text-align: center; }

/* 底部反馈条 */
.fb { position: fixed; left: 0; right: 0; bottom: 0; display: flex; align-items: center; gap: 24rpx; padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom)); background: var(--panel2); border-top: 2rpx solid var(--hair); }
.fb-w { font-family: Georgia, serif; font-size: 40rpx; }
.fb-l { font-size: 26rpx; color: var(--ink2); }
.fb-l.ok { color: var(--ok); }
.fb-b { width: 220rpx; flex: none; }

.done { flex: 1; display: flex; flex-direction: column; justify-content: center; }
.stamp.big { width: 300rpx; height: 300rpx; margin: 0 auto 40rpx; border-width: 6rpx; transform: none; }
.stamp.big .s1 { font-size: 52rpx; margin: 8rpx 0; font-family: "Songti SC", serif; }
.stamp.big .s2 { font-size: 22rpx; }
.sum { display: flex; gap: 16rpx; margin: 36rpx 0 20rpx; }
.sum > view { flex: 1; text-align: center; background: var(--panel); border: 2rpx solid var(--hair); border-radius: 24rpx; padding: 18rpx 0; font-size: 26rpx; color: var(--ink2); }
.n { font-size: 44rpx; font-weight: 700; color: var(--ivory); font-family: Georgia, serif; }
.c-know { color: var(--ok); } .c-vague { color: var(--star); } .c-forgot { color: var(--bad); }
