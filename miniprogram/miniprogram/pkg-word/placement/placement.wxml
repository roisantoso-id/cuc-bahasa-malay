<page-meta page-style="{{th.style}}" background-color="{{th.bg}}" background-text-style="{{th.day ? 'dark' : 'light'}}" />
<wxs src="../../utils/fit.wxs" module="fit" />
<wxs module="u">module.exports = { L: ['A', 'B', 'C', 'D'] }</wxs>
<!-- 一套版面，颜色和字全走主题变量：白天、夜晚都能用 -->
<view class="pt">
  <hb-empty wx:if="{{view === 'loading'}}" image="loading" title="{{busy ? '正在算你的推荐难度…' : '正在准备题目…'}}" />
  <hb-empty wx:elif="{{view === 'error'}}" image="fail" title="{{error}}"><button class="btn btn-main" hover-class="hover" bindtap="again">再试一次</button><view class="btn-text" hover-class="hover" bindtap="back">返回</view></hb-empty>

  <!-- 说明：测什么、怎么测、五档难度 -->
  <block wx:elif="{{view === 'intro'}}">
    <view class="pt-eb">入门测评 · 约 3 分钟 · 最多 {{total}} 题</view>
    <view class="h1 pt-h">先测一测，你认识多少马来语高频词</view>
    <view class="pt-lead">看词选意思，不会就点「不认识」，别猜。测完推荐你从哪一档学起，已经会的词不用再背。</view>
    <view class="pt-ladder">
      <view wx:for="{{levels}}" wx:key="d" class="pt-step">
        <view class="pt-step-n">{{index + 1}}</view>
        <view class="item-main"><view class="pt-step-t">{{item.label}}</view><view class="muted small">{{item.note}}</view></view>
      </view>
    </view>
    <view class="pt-grow" />
    <button class="btn btn-main btn-block" hover-class="hover" bindtap="begin">开始测评<text class="btn-arr">→</text></button>
    <view class="btn-text" hover-class="hover" bindtap="skip">{{first ? '先跳过，从入门学起' : '返回'}}</view>
  </block>

  <!-- 答题：一个词，四个意思 + 不认识 -->
  <block wx:elif="{{view === 'quiz'}}">
    <view class="pt-top">
      <view class="pt-x" hover-class="hover" bindtap="quit">×</view>
      <view class="bar pt-bar"><view class="bar-in" style="width:{{(idx - 1) / total * 100}}%" /></view>
      <text class="pt-no num">{{idx}}</text>
    </view>
    <view class="pt-lv">第 {{lvNo}} 档 · {{lvLabel}} · {{lvQ}} / {{lvTotal}}</view>
    <view class="pt-word">
      <view class="ms pt-w" style="font-size:{{fit.fs(q.ms, 96, 600)}}rpx">{{q.ms}}</view>
      <say-btn wx:if="{{q.audio}}" src="{{q.audio}}" size="md" />
    </view>
    <view class="pt-ask">选出它的中文意思</view>
    <view class="pt-opts">
      <view wx:for="{{q.options}}" wx:key="*this" class="opt pt-opt {{picked === item ? 'on' : ''}}" hover-class="{{picked ? 'none' : 'hover'}}" data-o="{{item}}" bindtap="pick">
        <text class="pt-l">{{u.L[index]}}</text><text class="pt-ot">{{item}}</text>
      </view>
      <view class="opt pt-opt pt-none {{picked === '__none' ? 'on' : ''}}" hover-class="{{picked ? 'none' : 'hover'}}" data-o="" bindtap="pick">不认识</view>
    </view>
  </block>

  <!-- 结果：推荐档、估算词汇量、每档答对几个 -->
  <block wx:elif="{{view === 'result'}}">
    <view class="pt-res">
      <view class="stamp pt-stamp"><text class="s2">推荐难度</text><text class="s1">{{res.label}}</text></view>
      <view class="pt-eb center">测评完成 · 答了 {{res.answered}} 题</view>
      <view class="h1 center">建议从「{{res.label}}」学起</view>
      <view class="pt-big"><text class="pt-big-n">{{res.vocab}}</text><text class="pt-big-u">估算认识的高频词</text></view>
    </view>
    <view class="pt-rows">
      <view wx:for="{{res.rows}}" wx:key="d" class="pt-row {{item.rec ? 'rec' : ''}}">
        <text class="pt-row-t">{{item.label}}</text>
        <view class="bar pt-row-bar"><view class="bar-in {{item.done ? 'ok' : ''}}" style="width:{{item.pct}}%" /></view>
        <text class="pt-row-n">{{item.asked ? item.correct + ' / ' + item.asked : '没测到'}}</text>
        <text class="pt-row-tag">{{item.rec ? '从这里学' : item.done ? '已会' : ''}}</text>
      </view>
    </view>
    <view class="pt-note">{{res.known ? '「' + res.known + '」及以下答对的词已记为学过，15 天后复习一次确认。' : ''}}答错和不认识的词会最先推给你。学的时候大部分都认识会自动升一档，太难会降一档。</view>
    <view class="pt-grow" />
    <button class="btn btn-main btn-block" hover-class="hover" bindtap="go">开始学习<text class="btn-arr">→</text></button>
    <view class="btn-text" hover-class="hover" bindtap="again">再测一次</view>
  </block>
</view>
<fx-confetti fire="{{cf}}" />
