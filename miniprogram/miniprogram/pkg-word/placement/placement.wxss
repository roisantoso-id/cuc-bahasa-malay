/* 入门测评：固定「夜航」场景（照 design/placement-v1/mockup-1.png）。不管手机白天还是夜晚，这一页都是深色星空，
   所以在 .pt 上把主题变量写死成夜晚的值（白天的 page-style 变量在这里被盖掉）。
   场景图、星空底、犀鸟都是 banana 画的图（img/），文字和按钮叠在上面。
   动效（Gemini 给的时长）：档位名错峰浮起 90ms 一个；犀鸟呼吸 ±4px 3.2s；词卡滑出 180ms、滑入 220ms；
   结果：台阶依次升起 280ms / 间隔 70ms，数字 600ms 滚动（js），彩纸只放一次 */
.pt {
  --night: #0a1f22; --panel: #14353a; --panel2: #0f2a2e; --ivory: #f3ead6; --star: #e9b961; --ok: #8fc0a0; --bad: #e8836a;
  --ink: #f3ead6; --ink2: rgba(243,234,214,.72); --ink3: rgba(243,234,214,.48); --hair: rgba(243,234,214,.14); --hair2: rgba(243,234,214,.28);
  --dark-ink: #0a1f22; --dark-ink2: rgba(10,31,34,.62); --dark-hair: rgba(10,31,34,.16); --leaf: #1f6b4e;
  --star-l: rgba(233,185,97,.16); --ok-l: rgba(143,192,160,.14); --strong: #f3ead6; --raise: #f3ead6; --raise-sh: none;
  --btn: #f3ead6; --on-btn: #0a1f22; --on-star: #0a1f22; --glow: rgba(233,185,97,.4); --star-line: rgba(233,185,97,.45); --wash: rgba(243,234,214,.08);
  --ms-style: italic; --ms-bold: 700;
  position: relative; min-height: 100vh; background: #0a1f22; color: var(--ink); overflow: hidden;
}
.pt-bg { position: fixed; left: 0; top: 0; width: 100vw; height: 100vh; z-index: 0; }
.pt-body { position: relative; z-index: 1; min-height: 100vh; display: flex; flex-direction: column; padding: 0 var(--s4) calc(var(--s3) + env(safe-area-inset-bottom)); box-sizing: border-box; }

/* 自定义顶栏：和微信胶囊同一行 */
.pt-nav { position: fixed; z-index: 5; left: 0; right: 0; display: flex; align-items: center; justify-content: center; }
.pt-back { position: absolute; left: 12rpx; top: 50%; width: 88rpx; height: 88rpx; margin-top: -44rpx; line-height: 84rpx; text-align: center; font-size: 56rpx; color: var(--ink); }
.pt-nav-t { font-size: 30rpx; font-weight: 600; color: var(--ink); letter-spacing: .08em; }

.pt-h { margin-top: var(--s2); font-family: var(--f-zh); font-size: 52rpx; font-weight: 700; color: var(--strong); text-align: center; text-shadow: 0 0 40rpx rgba(233,185,97,.35); }
.pt-sub { margin-top: 8rpx; font-size: 26rpx; color: var(--ink2); text-align: center; }
.pt-foot { position: relative; z-index: 3; margin-top: auto; padding-top: var(--s3); }
.pt-cta { box-shadow: 0 0 48rpx var(--glow); }
/* 次要文字链：够大、够亮、没下划线，点击区 80rpx 高 */
.pt-link { display: flex; align-items: center; justify-content: center; height: 80rpx; margin-top: 8rpx; font-size: 28rpx; color: var(--ink2); }

/* ① 场景：整幅图 + 叠在石板上的档位名；场景底部是雾，按钮区压在雾上 */
.pt-scene-wrap { flex: 1; display: flex; align-items: center; justify-content: center; margin: 0 calc(-1 * var(--s4)); }
.pt-scene { position: relative; flex: none; }
/* 场景图四边的羽化直接做在图里（透明 webp，design/placement-v1/scene.py），和星空底接上，不露出方框 */
.pt-scene-img { position: absolute; left: 0; top: 0; width: 100%; height: 100%; animation: pt-fade .5s ease-out both; }
@keyframes pt-fade { from { opacity: 0; } }
.pt-stone { position: absolute; z-index: 1; transform: translate(-50%, -50%); white-space: nowrap; font-family: var(--f-zh); font-size: 1em; font-weight: 700; color: #3a2f1c; letter-spacing: .04em; animation: pt-rise .36s cubic-bezier(.2, .8, .3, 1) both; }
.pt-stone.far { color: rgba(58, 47, 28, .72); font-size: .9em; }
.pt-stone.done { color: #1f6b4e; }
.pt-stone-ck { font-family: var(--f-body); }
.pt-stone-tip { position: absolute; left: 50%; bottom: 100%; margin-bottom: 1.5em; transform: translateX(-50%); padding: 4rpx 18rpx; border-radius: 999rpx; background: var(--star); color: var(--on-star); font-family: var(--f-body); font-size: 22rpx; font-weight: 600; box-shadow: 0 0 24rpx var(--glow); animation: pt-bob 1.8s ease-in-out .8s infinite; }
@keyframes pt-rise { from { opacity: 0; transform: translate(-50%, -10%); } }
@keyframes pt-bob { 50% { transform: translate(-50%, -8rpx); } }

/* 犀鸟站在左下的空地上 + 气泡（暗底金线，不和主按钮抢亮度） */
.pt-bird-map { position: absolute; z-index: 2; left: 1%; top: 60%; width: 31%; animation: pt-breathe 3.2s ease-in-out infinite; }
@keyframes pt-breathe { 50% { transform: translateY(-8rpx); } }
.pt-bubble { position: absolute; z-index: 2; left: 35%; top: 55%; width: 46%; padding: 18rpx 22rpx; border-radius: 24rpx; background: rgba(15, 42, 46, .92); border: 2rpx solid var(--star-line); color: var(--strong); font-size: 26rpx; line-height: 1.5; box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, .35); animation: pt-pop .32s cubic-bezier(.3, 1.4, .5, 1) .7s both; }
.pt-bubble::before { content: ''; position: absolute; left: -12rpx; bottom: 36rpx; width: 20rpx; height: 20rpx; background: rgba(15, 42, 46, .92); border-left: 2rpx solid var(--star-line); border-bottom: 2rpx solid var(--star-line); transform: rotate(45deg); }
.pt-nw { white-space: nowrap; }
@keyframes pt-pop { from { opacity: 0; transform: scale(.85); transform-origin: left bottom; } }

/* ② 答题 */
.pt-top { display: flex; align-items: center; gap: var(--s2); margin-top: var(--s2); }
.pt-bar { position: relative; flex: 1; height: 12rpx; border-radius: 999rpx; background: var(--hair2); }
.pt-bar-in { position: relative; height: 100%; min-width: 12rpx; border-radius: 999rpx; background: linear-gradient(90deg, #c9973f, var(--star)); transition: width .28s ease; }
.pt-bar-star { position: absolute; right: -12rpx; top: 50%; width: 28rpx; height: 28rpx; margin-top: -14rpx; border-radius: 50%; background: #fff3d1; box-shadow: 0 0 24rpx 6rpx var(--glow), 0 0 6rpx var(--star); }
.pt-no { flex: none; min-width: 88rpx; text-align: right; font-family: var(--f-ms); font-size: 26rpx; color: var(--ink2); }
.pt-chip { align-self: center; margin-top: var(--s3); padding: 6rpx 24rpx; border-radius: 999rpx; background: var(--star-l); border: 2rpx solid var(--star-line); color: var(--star); font-size: 24rpx; font-weight: 600; }
.pt-q { flex: 1; display: flex; flex-direction: column; justify-content: center; padding-bottom: var(--s4); }
.pt-stage { position: relative; margin-top: 180rpx; }
/* 扒卡的犀鸟：爪子压在卡片上沿 */
.pt-bird-peek { position: absolute; z-index: 2; left: 50%; top: -150rpx; width: 260rpx; height: 177rpx; margin-left: -130rpx; animation: pt-peek .24s ease-out .1s both; }
.pt-bird-peek.nod { animation: pt-nod .5s ease-in-out both; }
@keyframes pt-peek { from { opacity: 0; transform: translateY(28rpx); } }
@keyframes pt-nod { 30% { transform: rotate(-6deg); } 60% { transform: rotate(4deg); } }
.pt-card { position: relative; padding: 56rpx 32rpx 28rpx; border-radius: 40rpx; background: linear-gradient(180deg, #fbf5e8, #f1e6cf); box-shadow: 0 0 0 2rpx rgba(233,185,97,.35), 0 0 80rpx rgba(233,185,97,.22), 0 30rpx 60rpx rgba(0, 0, 0, .35); color: var(--dark-ink); }
.pt-card.in { animation: pt-in .22s ease-out both; }
.pt-card.out { opacity: 0; transform: translateX(-32rpx); transition: opacity .18s, transform .18s; }
@keyframes pt-in { from { opacity: 0; transform: translateX(32rpx); } }
.pt-word { display: flex; align-items: center; justify-content: center; gap: 16rpx; min-height: 120rpx; }
.pt-w { font-weight: var(--ms-bold); line-height: 1.15; white-space: nowrap; color: var(--dark-ink); }
/* 喇叭：看着小，点击区 88rpx */
.pt-say { flex: none; display: flex; align-items: center; justify-content: center; width: 88rpx; height: 88rpx; }
.pt-opts { margin-top: 20rpx; }
.pt-opt { display: flex; align-items: center; min-height: 100rpx; margin-top: 16rpx; padding: 16rpx 24rpx; box-sizing: border-box; border-radius: 999rpx; border: 3rpx solid rgba(10, 31, 34, .14); background: rgba(255, 255, 255, .6); color: var(--dark-ink); font-family: var(--f-zh); font-size: 30rpx; line-height: 1.4; transition: border-color .15s, background-color .15s, opacity .15s; }
.pt-opt.press, .pt-none.press { transform: scale(.98); }
.pt-opt.on { border-color: #d9a441; background: #fbeccc; font-weight: 700; box-shadow: 0 0 0 2rpx #e9b961, 0 0 24rpx rgba(233,185,97,.35); }
.pt-opt.dim { opacity: .6; }
.pt-l { flex: none; width: 44rpx; font-family: var(--f-ms); font-size: 26rpx; color: var(--dark-ink2); }
.pt-ot { flex: 1; min-width: 0; word-break: break-all; }
.pt-none { display: flex; align-items: center; justify-content: center; height: 96rpx; margin-top: var(--s3); border-radius: 999rpx; border: 3rpx dashed var(--hair2); color: var(--ink2); font-size: 28rpx; transition: border-color .15s, background-color .15s; }
.pt-none.on { border-color: var(--star); color: var(--strong); background: var(--star-l); }
.pt-hint { margin-top: var(--s2); text-align: center; font-size: 26rpx; color: var(--ink2); }

/* ③ 结果 */
.pt-res { display: flex; flex-direction: column; align-items: center; padding-top: var(--s3); }
.pt-bird-jump { width: 190rpx; height: 274rpx; filter: drop-shadow(0 0 30rpx rgba(233,185,97,.35)); animation: pt-jump .6s cubic-bezier(.3, 1.6, .5, 1) both, pt-breathe 3.2s ease-in-out .6s infinite; }
@keyframes pt-jump { from { opacity: 0; transform: translateY(60rpx) scale(.8); } }
.pt-badge { margin-top: var(--s2); padding: 8rpx 28rpx; border-radius: 999rpx; border: 3rpx solid var(--star); background: rgba(233,185,97,.12); color: var(--star); font-size: 28rpx; font-weight: 700; box-shadow: 0 0 32rpx rgba(233,185,97,.3); transform: rotate(-3deg); animation: pt-stamp .45s cubic-bezier(.3, 1.6, .5, 1) .3s both; }
@keyframes pt-stamp { from { opacity: 0; transform: scale(1.6) rotate(-12deg); } }
.pt-num { margin-top: var(--s2); font-family: var(--f-ms); font-size: 112rpx; font-weight: 700; line-height: 1.1; color: #fff3d1; text-shadow: 0 0 40rpx rgba(233,185,97,.45); }
.pt-num-u { font-size: 26rpx; color: var(--ink2); }

/* 五级台阶：越往右越高；已会的薄荷绿、推荐档金色插旗、往上的半透明象牙色；顶面一道亮边做出立体感 */
.pt-steps { display: flex; align-items: flex-end; gap: 12rpx; height: 330rpx; margin-top: var(--s4); }
.pt-step { position: relative; flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: stretch; }
.pt-col { display: flex; justify-content: center; padding-top: 12rpx; box-sizing: border-box; border-radius: 16rpx 16rpx 6rpx 6rpx; background: linear-gradient(180deg, rgba(243,234,214,.32), rgba(243,234,214,.14)); box-shadow: inset 0 4rpx 0 rgba(255,255,255,.25); transform: scaleY(0); transform-origin: bottom; transition: transform .28s cubic-bezier(.2, .8, .3, 1); }
.pt-steps.grow .pt-col { transform: scaleY(1); }
.pt-step.done .pt-col { background: linear-gradient(180deg, #a9d6b8, #6fa585); box-shadow: inset 0 4rpx 0 rgba(255,255,255,.45), 0 0 24rpx rgba(143,192,160,.35); }
.pt-step.rec .pt-col { background: linear-gradient(180deg, #ffd88a, #d9a441); box-shadow: inset 0 4rpx 0 rgba(255,255,255,.55), 0 0 40rpx var(--glow); }
.pt-col-ck { font-size: 24rpx; font-weight: 700; color: var(--dark-ink); }
.pt-step-t { margin-top: 10rpx; text-align: center; font-size: 24rpx; color: var(--ink2); white-space: nowrap; }
.pt-step.done .pt-step-t { color: var(--strong); }
.pt-step.rec .pt-step-t { color: var(--star); font-weight: 700; }
.pt-step-s { text-align: center; font-family: var(--f-ms); font-size: 22rpx; color: var(--ink2); }
.pt-flag { align-self: center; margin-bottom: 10rpx; padding: 2rpx 14rpx; border-radius: 8rpx; background: var(--star); color: var(--on-star); font-size: 22rpx; font-weight: 600; white-space: nowrap; box-shadow: 0 0 20rpx var(--glow); animation: pt-pop .3s ease-out .7s both; }
.pt-note { margin-top: var(--s4); font-size: 26rpx; line-height: 1.6; color: var(--ink2); text-align: center; }
