.head { margin-bottom: 24rpx; }
.draft { margin-top: 14rpx; font-size: 24rpx; color: #9a6a00; background: #fff3d1; padding: 12rpx 18rpx; border-radius: 14rpx; }
.w { font-size: 34rpx; }
.pos { font-size: 22rpx; color: var(--ink2); margin-left: 12rpx; }
.ok { color: var(--green); font-weight: 900; margin-right: 12rpx; }
.play { color: var(--blue); font-size: 28rpx; }
.wrap { padding-bottom: 200rpx; }
.bottom { position: fixed; left: 0; right: 0; bottom: 0; padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom)); background: rgba(250,250,247,.96); border-top: 2rpx solid var(--line); }
