.hd { padding: 24rpx 28rpx 28rpx; }
.chips-wrap { margin: 32rpx 0 20rpx; }
.grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.cell { background: var(--panel2); border: 2rpx solid var(--hair); border-radius: 22rpx; padding: 14rpx 18rpx; min-width: 0; }
.cell.hover { opacity: .7; }
.cell.learn { border-color: var(--ok); background: var(--panel); }
.cell.good { border-color: rgba(233,185,97,.5); background: var(--panel); }
.cell.done { background: var(--ivory); border-color: var(--ivory); }
.cell.done .cell-ms { color: var(--dark-ink); } .cell.done .cell-zh, .cell.done .cell-no { color: rgba(10,31,34,.6); }
.cell-no { font-size: 22rpx; color: var(--ink2); }
.cell-ms { font-weight: 700; font-size: 30rpx; font-family: Georgia, serif; font-style: italic; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.cell-zh { font-size: 24rpx; color: var(--ink2); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
