/* 一站的词表：标题 + 一个主按钮 + 筛选 + 两列词 */
.st-head { display: flex; align-items: flex-start; gap: var(--s3); }
.st-note { margin-top: var(--s1); }
button.st-go { margin-top: var(--s4); }
.st-tabs { margin-top: var(--s4); }
.st-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: var(--s4); }
.st-cell { display: flex; align-items: center; gap: var(--s2); min-width: 0; min-height: 104rpx; border-bottom: 2rpx solid var(--hair); box-sizing: border-box; }
.st-ms { font-size: var(--t-section); line-height: 1.3; }
/* 熟练度：没学 = 空心，在学 = 绿，熟悉 = 象牙，掌握 = 星光 */
.st-dot { flex: none; width: 12rpx; height: 12rpx; border-radius: 50%; border: 2rpx solid var(--hair2); box-sizing: border-box; }
.st-cell.learn .st-dot { background: var(--ok); border-color: var(--ok); }
.st-cell.good .st-dot { background: var(--strong); border-color: var(--strong); }
.st-cell.done .st-dot { background: var(--star); border-color: var(--star); }
.st-cell.none .st-ms { color: var(--ink2); }
.st-none { padding: var(--s5) 0; }
