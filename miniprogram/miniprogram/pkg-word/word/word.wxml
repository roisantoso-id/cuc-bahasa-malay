<wxs src="../../utils/fit.wxs" module="fit" />
<view class="wrap">
  <hb-empty wx:if="{{view === 'loading'}}" image="loading" title="加载中…" />
  <hb-empty wx:elif="{{view === 'error'}}" image="fail" title="{{error}}" />
  <block wx:else>
    <view class="between">
      <text class="no muted small">№ {{w.rank}} · 第 {{w.level}} 站</text>
      <view class="wd-fav-wrap"><view class="wd-fav {{w.fav ? 'on' : ''}} {{favPop ? 'pop' : ''}}" bindtap="fav"><image class="wd-fav-i" src="/assets/fx/{{w.fav ? 'star-amber' : 'star-line'}}.svg" />{{w.fav ? '已收藏' : '收藏'}}</view><fx-burst fire="{{favFx}}" /></view>
    </view>
    <view class="wd-head">
      <view class="wd-w" style="font-size:{{fit.fs(w.ms, 88, 520)}}rpx" bindlongpress="copy">{{w.ms}}</view>
      <say-btn src="{{w.audio}}" />
    </view>
    <view wx:if="{{w.root}}" class="muted small">词根 <text class="serif">{{w.root}}</text></view>
    <view class="wd-lv">
      <view wx:for="{{dots}}" wx:key="index" class="wd-lv-d {{item ? 'on' : ''}}" />
      <text class="small muted wd-lv-t">{{label}}{{w.wrong ? ' · 错过 ' + w.wrong + ' 次' : ''}}</text>
    </view>

    <view class="wd-senses">
      <view wx:for="{{w.senses}}" wx:key="index" class="sense">
        <view class="wd-zh"><text class="pos">{{item.pos}}</text>{{item.zh}}</view>
        <view wx:if="{{item.exMs}}" class="example"><view class="serif">{{item.exMs}}</view><view class="muted small">{{item.exZh}}</view></view>
      </view>
    </view>
  </block>
</view>
