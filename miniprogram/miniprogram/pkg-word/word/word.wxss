/* 单词详情：大斜体词 + 发音，下面是释义。星光只给熟练度那几格 */
.wd-fav-wrap { position: relative; flex: none; }
.wd-fav { display: inline-flex; align-items: center; gap: var(--s1); height: 88rpx; padding-left: var(--s3); font-size: 26rpx; color: var(--ink2); }
.wd-fav.on { color: var(--ivory); }
.wd-fav-i { width: 36rpx; height: 36rpx; }
.wd-fav.pop { animation: wd-favpop .4s cubic-bezier(.3,1.6,.5,1); }
@keyframes wd-favpop { 0% { transform: scale(1); } 40% { transform: scale(1.18); } 100% { transform: scale(1); } }
.wd-head { display: flex; align-items: center; gap: var(--s3); margin: var(--s2) 0 var(--s1); }
.wd-w { min-width: 0; font-family: var(--f-ms); font-style: italic; font-weight: 700; font-size: var(--t-display); line-height: 1.15; white-space: nowrap; }
.wd-lv { display: flex; align-items: center; gap: var(--s1); margin-top: var(--s3); }
.wd-lv-d { width: 32rpx; height: 8rpx; border-radius: var(--r-pill); background: var(--hair); }
.wd-lv-d.on { background: var(--star); }
.wd-lv-t { margin-left: var(--s1); }
.wd-senses { margin-top: var(--s4); border-top: 2rpx solid var(--hair); }
.wd-zh { font-family: var(--f-zh); font-size: var(--t-section); font-weight: 700; line-height: 1.4; }
